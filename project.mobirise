        {
          "_name": "features2",
          "_sourceTheme": "connectm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Color\" name=\"cardColor\" value=\"#ffffff\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/connectm4/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/connectm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"content-wrapper\">\n            <div class=\"row align-items-center\">\n                <div class=\"col-12 col-lg-{{12 - imageWidth}}\" mbr-class=\"{'order-2':reverseContent}\">\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Hijra Bank</h6>\n                                                <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Strategic Value:</b><br></p>\n                                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Investment Year: 2023–2024</span><br></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Status: Operational</span></li>\n                            </ul>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Hijra Bank operates as an interest-free Islamic banking institution in Ethiopia, serving customers who prefer Sharia-compliant financial services. The bank provides ethical banking solutions based on Islamic finance principles, including profit-sharing, leasing, and partnership-based financing models.<br><br><b>Services:</b><br></p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Interest-free Islamic banking</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Murabaha (cost-plus financing)</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Mudarabah (profit-sharing)</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Ijarah (leasing arrangements)</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Sharia-compliant savings and investment accounts</span></li>\n                            </ul>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Strategic Value:</b><br></p>\n                                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Diversification into Islamic finance sector</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Access to Sharia-compliant financing options</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Growing market for ethical banking in Ethiopia</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Stable returns through profit-sharing models</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Strategic financial partnerships for Riders' operations</span></li>\n                            </ul>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Learn more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-{{imageWidth}}\">\n                    <div class=\"image-wrapper\" mbr-class=\"{'reverse' : reverseContent}\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logos-1.png\" alt=\"Mobirise\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content-wrapper": {
              "background": "@cardColor",
              "@media (max-width: 991px)": {
                ".image-wrapper": {
                  "margin-bottom": "0 !important"
                },
                ".image-wrapper.reverse": {
                  "margin-bottom": "2rem !important"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "1rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2rem"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem 4rem",
                ".order-2 .text-wrapper": {
                  "padding-left": "6.4rem",
                  "padding-right": "0"
                },
                ".text-wrapper": {
                  "padding-right": "6.4rem"
                }
              }
            },
            ".image-wrapper img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".card-title": {
              "margin-bottom": "1.88rem !important",
              "color": "#1d1e22"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#1d1e22"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "features2-bs",
          "_cid": "v0A6QezIIv",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
