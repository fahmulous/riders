                        "margin-bottom": "32px"
                      }
                    },
                    ".content-wrap": {
                      "width": "40%",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      },
                      ".mbr-title": {
                        "margin-bottom": "32px"
                      },
                      ".panel-desc": {
                        "margin-bottom": "30px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-title": {
              "color": "#141414"
            },
            ".panel-desc": {
              "color": "#141414"
            },
