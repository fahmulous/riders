              "&:hover img": {
                "-webkit-transform": "scale(1.05)",
                "transform": "scale(1.05)"
              }
            },
            ".card-box": {
              "padding": "0rem"
            },
            "img": {
              "transition": "all 0.3s"
            },
            ".mbr-section-title": {
              "margin": "0 auto",
