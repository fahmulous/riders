        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@showDecor)": {
              "position": "relative",
              "overflow": "hidden",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "right": "-14%",
                "bottom": "0",
                "width": "550px",
                "height": "550px",
                "border-radius": "100%",
                "background-image": "linear-gradient(@decor_1 -10%, transparent 95%)",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "opacity": ".4"
                }
              },
              "&::after": {
                "content": "''",
                "position": "absolute",
                "right": "0",
                "bottom": "-20%",
                "width": "550px",
                "height": "550px",
                "border-radius": "100%",
                "background-image": "linear-gradient(90deg, @decor_2 -10%, transparent 95%)",
                "@media (max-width: 992px)": {
                  "opacity": ".4"
                }
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 24px",
                "@media (max-width: 768px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 768px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "justify-content": "space-between",
              "position": "relative",
              "z-index": "1",
              ".card": {
                "justify-content": "flex-end"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "50px",
              "@media (max-width: 1200px)": {
                "margin-bottom": "148px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "90px"
              },
              ".mbr-section-title": {
                "margin-bottom": "32px",
                "span": {
                  "color": "@title"
                }
              }
            },
            ".text-wrapper": {
              ".mbr-text": {
                "margin-bottom": "0"
              },
              ".text_2": {
                "margin-top": "32px"
              },
              ".mbr-section-btn": {
                "margin-top": "14px",
                ".btn-primary-outline, .btn-secondary-outline, .btn-success-outline, .btn-info-outline, .btn-warning-outline, .btn-danger-outline, .btn-black-outline, .btn-white-outline": {
                  "border": "none !important",
                  "padding": "0",
                  "border-radius": "0",
                  ".mbr-iconfont": {
                    "transform": "rotate(0deg)"
                  },
                  "&:hover, &:focus": {
                    "background-color": "transparent !important",
                    ".mbr-iconfont": {
                      "transform": "translateX(10px)"
                    }
                  }
                },
                ".btn-primary-outline": {
                  "&:hover, &:focus": {
                    "color": "@primaryColor !important"
                  }
                },
                ".btn-secondary-outline": {
                  "&:hover, &:focus": {
                    "color": "@secondaryColor !important"
                  }
                },
                ".btn-success-outline": {
                  "&:hover, &:focus": {
                    "color": "@successColor !important"
                  }
                },
                ".btn-info-outline": {
                  "&:hover, &:focus": {
                    "color": "@infoColor !important"
                  }
                },
                ".btn-warning-outline": {
                  "&:hover, &:focus": {
                    "color": "@warningColor !important"
                  }
                },
                ".btn-danger-outline": {
                  "&:hover, &:focus": {
                    "color": "@dangerColor !important"
                  }
                },
                ".btn-black-outline": {
                  "&:hover, &:focus": {
                    "color": "#000000 !important"
                  }
                },
                ".btn-white-outline": {
                  "&:hover, &:focus": {
                    "color": "#ffffff !important"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#141414"
            },
            ".mbr-section-title, .mbr-section-btn-main": {
              "color": "#141414",
              "text-align": "center"
            }
          },
          "_name": "header01",
          "_sourceTheme": "strategym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 strategym5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#bfd42a\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\">\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\">\n        <input type=\"checkbox\" title=\"Main Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showCardButtons\">\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\" checked>\n        <input type=\"color\" title=\"Decoration Color 1\" value=\"#1e8147\" name=\"decor_1\" condition=\"showDecor\" selected>\n        <input type=\"color\" title=\"Decoration Color 2\" value=\"#bfd42a\" name=\"decor_2\" condition=\"showDecor\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/strategym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ededed\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/strategym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn-main\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Vision, Mission &amp;<br> <span>Values</span>\n                    </h1>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn-main\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"contact.html\" data-app-placeholder=\"Type Text\">\n                            \n                            Contact Us</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Guiding principles from our 5-year strategic plan\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            VIEW MORE\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text text_2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText_2\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        In the fast-paced and ever-evolving landscape of the digital world, navigating the intricacies\n                        of online visibility and engagement requires a strategic approach. At agency, we understand that\n                        each brand is unique.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0sK6TmBO7",
          "_anchor": "header01-9l",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
