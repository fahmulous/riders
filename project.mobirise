                  "border-radius": "0 !important",
                  "object-fit": "contain",
                  "image-rendering": "crisp-edges"
                }
              },
              ".content-wrap": {
                "flex-wrap": "nowrap !important"
              },
              ".navbar-brand": {
                "order": "1",
                "display": "flex !important",
                "flex-direction": "column !important",
                "align-items": "flex-start !important",
                "max-width": "70% !important"
