            },
            "@media (min-width: 1441px)": {
              ".nav-item .nav-link": {
                "margin": "6px 8px !important"
              }
            },
            ".dropdown-item.active": {
              "color": "@activeColor !important",
              "font-weight": "500 !important"
            },
            ".nav-item .nav-link": {
              "font-weight": "600 !important",
              "font-size": "1.05rem !important"
            }
