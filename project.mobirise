        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between",
              ".card": {
                "justify-content": "center"
              }
            },
            ".content-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "22px"
              }
            },
            ".item": {
              "&:last-child": {
                ".item-wrapper .card-box": {
                  "border": "none"
                }
              },
              ".item-wrapper": {
                "display": "flex",
                "align-items": "center",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".icon-wrapper": {
                  "@media (max-width: 992px)": {
                    "margin-top": "55px"
                  },
                  ".mbr-iconfont": {
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "font-size": "42px",
                    "width": "64px",
                    "height": "64px",
                    "color": "@icon",
                    "margin-right": "55px"
                  }
                },
                ".card-box": {
                  "padding": "55px 0",
                  "border-bottom": "1px solid @border",
                  "@media (max-width: 992px)": {
                    "padding": "16px 0 55px"
                  },
                  ".card-title": {
                    "margin-bottom": "16px"
                  },
                  ".card-text": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#ff5753"
            },
            ".card-text": {
              "color": "#000000"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#bfd42a"
            }
          },
          "_name": "features02",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 scalem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#1e8147\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Border Color\" value=\"#d4d3d3\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/scalem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f2f2f4\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/scalem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">Our Investment Philosophy</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">We believe Ethiopia's economic future will be built by Ethiopians investing in Ethiopia. Our diversified holding company model allows us to balance risk across multiple sectors, capture synergies between businesses, and maintain financial stability even during market volatility.<br><br>Rather than chasing short-term returns, we invest with a decade-long horizon—building assets, developing talent, and creating infrastructure that will serve Ethiopia for generations. Every birr we invest is deployed with two questions in mind: Does this create sustainable value for shareholders? Does this contribute to national economic development?</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            View more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont icon54-v1-darts\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">Strategic Diversification</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">Risk management through multi-sector portfolio spanning textile, agriculture, real estate, and financial services<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-setting mobi-mbri\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">Operational Excellence</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">Professional management, best practices, quality standards, and continuous improvement across all business units<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont icon54-v1-plant\"></span>\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">Long-Term Value Creation</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">Sustainable growth strategy prioritizing asset quality, competitive positioning, and generational wealth building<br><br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0rF0Jryxg",
          "_anchor": "features02-8p",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 14px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 8px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".tabs-wrap": {
              "text-align": "center",
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".nav.nav-tabs": {
                "display": "inline-flex",
                "border": "none",
                ".nav-item": {
                  "padding": "0",
                  "border": "none",
                  "margin": "0 10px 10px 0",
                  "&:last-child": {
                    "margin-right": "0"
                  },
                  ".nav-link": {
                    "margin-bottom": "0",
                    "color": "@tabs",
                    "padding": "5px 16px",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "border": "1px solid @tabs",
                    "border-radius": "30px !important",
                    "background-color": "@tabsBg",
                    "position": "relative",
                    "transition": "all .3s ease",
                    "transform": "translate(-5px, -5px)",
                    "z-index": "11",
                    "&:hover, &:focus": {
                      "box-shadow": "none",
                      "transform": "translate(0)",
                      ".mbr-iconfont": {
                        "transform": "translateX(0.5rem)"
                      },
                      "&::before": {
                        "transform": "translate(0)",
                        "border-width": "0 !important"
                      }
                    },
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "bottom": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "border-radius": "30px",
                      "transform": "translate(4px, 4px)",
                      "z-index": "10",
                      "transition": "all .3s ease",
                      "border": "1px solid @primaryColor",
                      "pointer-events": "none"
                    }
                  },
                  ".nav-link.active": {
                    "transform": "translate(0)",
                    "&::before": {
                      "transform": "translate(0)",
                      "border-width": "0 !important"
                    }
                  }
                }
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".image-wrapper": {
                "width": "47%",
                "border": "1px solid @border",
                "padding": "10px",
                "border-radius": "1rem !important",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "32px"
                },
                "img": {
                  "height": "100%",
                  "object-fit": "cover",
                  "border-radius": "1rem !important",
                  "@media (max-width: 768px)": {
                    "height": "350px"
                  }
                }
              },
              ".text-wrapper": {
                "width": "47%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".card-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-text": {
              "color": "#141414"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#141414"
            },
            ".mbr-section-title, .tabs-wrap": {
              "color": "#141414"
            },
            ".btn-primary-doc": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "border": "none",
              "padding": "0.5rem 1.5rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "600",
              "font-size": "0.9rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-primary-doc:hover": {
              "background-color": "#000c3f",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(221, 255, 85, 0.4)",
              "color": "#ffffff"
            },
            ".btn-outline-doc": {
              "background-color": "transparent",
              "color": "#ffffff",
              "border": "2px solid #1a472a",
              "padding": "0.5rem 1.5rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "600",
              "font-size": "0.9rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-outline-doc:hover": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(26, 71, 42, 0.3)"
            }
          },
          "_name": "tabs01",
          "_sourceTheme": "termm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs01 termm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs BG\" value=\"#bfd42a\" name=\"tabsBg\" selected>\n        <input type=\"color\" title=\"Image Border\" value=\"#000000\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/termm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/termm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f1f1f1\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .tabs-wrap\">Strategic Business Sectors</h2>\n                </div>\n                <div class=\"tabs-wrap\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-9d_tab0\" aria-selected=\"true\" data-app-placeholder=\"Type Text\">\n                                Textile Industry\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-9d_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                Farming &amp; Agriculture\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-9d_tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                Real Estate &amp; Construction\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-9d_tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                Financial Sector</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab5\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                Tenancy in common\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/1d3a3208-2000x1333.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">Our flagship textile operation represents vertical integration at its finest. Located in Adama Industrial Park, Riders-ELSE operates:<br><br></p>\n                                                                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Cotton Ginning: 20 tons per day processing capacity, supporting our own farms and local farmers</li><li class=\"item-wrap\">Spinning: High-quality yarn production for domestic and export markets</li><li class=\"item-wrap\">Weaving: 35,000+ meters daily production capacity serving Ethiopian and international buyers</li><li class=\"item-wrap\">Recycling: Waste-to-product operations supporting sustainability goals</li>\n                            </ul>\n                                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">This sector serves as the cornerstone of our diversified portfolio, generating consistent revenue while supporting Ethiopia's textile export ambitions.<br><br>\n                                                               <a href=\"textile-industry.html\" class=\"btn btn-sm btn-primary-doc\" download>\n                                Read More\n                            </a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/photo-2023-12-20-16-49.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">A life estate is a type of ownership that grants an individual (known as the life tenant) the right to possess and use a property for the duration of their lifetime. After the life tenant's death, the property typically reverts to a remainderman or reversioner as specified in the deed or will. Condominium ownership allows individuals to own a specific unit within a multi-unit building or development while sharing ownership of common areas and amenities with other unit owners. Condominium owners typically pay homeowners' association (HOA) fees for maintenance and management of common areas.<br><br><b>Amibara Project (400 hectares - Operational)<br></b><br></p>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Primary crop: Cotton for textile industry vertical integration</span></li><li class=\"item-wrap\">Status: Fully operational with consistent yield</li>\n                            <li class=\"item-wrap\">Additional crops: Cereals and oilseeds for market diversification</li>\n                            </ul>\n                            <p><b>Gewane Project (3,000 hectares - Under Development)</b><br>\n                                </p>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Expansion potential: Up to 5,000 hectares</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Crops: Cotton, sesame, and export-oriented cereals</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Infrastructure: Irrigation systems, storage facilities, processing units</span></li>\n                            </ul>\n                            <p><br><b>South Omo Project (2,000 hectares - Planning Phase)</b><br>\n                                </p>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Status: Feasibility study and soil analysis completed</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Expansion potential: Up to 5,000 hectares</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Focus: High-value export crops and commercial farming</span></li>\n                            </ul>\n                                                                                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Combined, these projects position Riders as a significant player in Ethiopian commercial agriculture while securing raw material supply for our textile operations.<br><br>\n                                                               <a href=\"farming.html\" class=\"btn btn-sm btn-primary-doc\" download>\n                                Read More\n                            </a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/t-1-photo.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">\n                                    Our newest sector focuses on strategic real estate development and construction projects that align with Ethiopia's urbanization and infrastructure priorities. This sector complements our agricultural holdings by developing processing facilities, warehouses, and commercial properties that serve our operational needs while generating independent returns.<br><br><br>\n                                                               <a href=\"real-estate.html\" class=\"btn btn-sm btn-primary-doc\" download>\n                                Read More\n                            </a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/the-growing-relevance-of-shariah-compliant-finance-min.png\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Recognizing that access to capital is essential for economic growth, Riders has established strategic partnerships with leading Ethiopian financial institutions:<br><br></p>\n                                \n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Zamzam Bank: Shareholders and partners in Ethiopia's growing Islamic banking sector</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Hijra Bank: Strategic investment supporting financial inclusion</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Amal Microfinance: Partnership expanding access to credit for small businesses and farmers</span></li>\n                            </ul>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">These partnerships provide dual benefits: financial returns from a growing sector and preferential access to financing for our own operational expansion.<br><br>\n                                                               <a href=\"financial-sector.html\" class=\"btn btn-sm btn-primary-doc\" download>\n                                Read More\n                            </a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"https://e.mobirise.com/termm5/components/_images/term/image11.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                                    Tenancy in common is another form of co-ownership, but unlike joint tenancy, there\n                                    is no right of survivorship. Each co-owner can have a different ownership interest,\n                                    and they can freely transfer or sell their share without the consent of the other\n                                    co-owners. A trust estate refers to property or assets held in a trust for the\n                                    benefit of specific individuals or entities, known as beneficiaries. The trustee\n                                    manages and administers the trust according to its terms.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0syHW5kB5",
          "_anchor": "tabs01-9d",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "timeline1",
          "_sourceTheme": "voyagem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"timeline1 voyagem4_timeline1\" group=\"Timelines & Steps\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Timeline</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showBlockTitle\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"timelineBlockColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ddebe9\">\n\t\t<input type=\"color\" title=\"Timelines Color\" name=\"timelineColor\" value=\"#fe5925\">\n\t\t<select title=\"Count\" name=\"timelinesAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t\t<option value=\"8\">8</option>\n\t\t\t<option value=\"9\">9</option>\n\t\t\t<option value=\"10\">10</option>\n\t\t\t<option value=\"11\" selected>11</option>\n\t\t\t<option value=\"12\">12</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/voyagem4/components/_images/background.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/voyagem4/components/_images/background.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-12 title__block align-center\">\n\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">OUR JOURNEY</h3>\n\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">From Foundation to Future</h4>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"timelines-container\" mbri-timelines>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2021 - Company Formation</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tRiders Trading and Manufacturing S.C. officially incorporated with ETB 1 Billion registered capital. 1,160+ shareholders mobilized through share offering. Board of Directors elected. Corporate headquarters established in Addis Ababa.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>1\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2021 - First Acquisition</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat libero, bibendum in libero\n\t\t\t\t\t\t\ttempor, luctus volutpat ligula. Integer fringilla porttitor pretium.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>2\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">\n\t\t\t\t\t\t\tSMART WATCH\n\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat libero, bibendum in libero\n\t\t\t\t\t\t\ttempor, luctus volutpat ligula.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6 \"></div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>3\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">\n\t\t\t\t\t\t\tDESIGN OUT OF THE BOX\n\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tAcquired Riders-ELSE Textile Industry in Adama, establishing immediate operational presence in manufacturing sector. Management team restructured, quality systems implemented, export capabilities enhanced.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>4\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2022 - Agricultural Entry</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tLaunched Amibara farming project with 400 hectares of operational cotton production. Secured land for Gewane mega-project (3,000ha) with $34M investment commitment. Initiated South Omo feasibility studies.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>5\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2022 - First General Assembly</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Successfully convened inaugural General Assembly with shareholder participation. Financial reports presented, dividend policy approved, strategic direction confirmed.<br></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>6\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2023 - Portfolio Diversification</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Entered Real Estate &amp; Construction sector through strategic land acquisitions and development partnerships. Expanded agricultural operations at Amibara. Gewane infrastructure development commenced.<br></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6 \"></div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>7\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2023 - Financial Services Entry</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Established partnerships with Zamzam Bank, Hijra Bank, and Amal Microfinance, completing four-sector diversification strategy. Investment committee formed to oversee financial services portfolio.<br></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>8\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2024 - Growth &amp; Performance</h4>\n\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Achieved ETB 541 Million in annual revenue across all sectors. Workforce grew to 1,090+ employees. Second General Assembly convened with strong shareholder satisfaction. Textile exports expanded to new markets.<br></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6 \"></div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>9\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2024 - Third General Assembly</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Celebrated three years of operations with comprehensive performance review. Strategic planning for 5-year expansion approved. Additional capital raising discussed for Gewane project acceleration.<br></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>10\">\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0\">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">2025 &amp; Beyond - Strategic Expansion</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">5-year strategic plan implementation phase begins. Gewane project full operationalization targeted. Additional sector opportunities under evaluation. Sustainability and ESG framework development underway.<br></p>\n\t\t\t\t\t</div>\n\n\t\t\t\t</div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6 \"></div>\n\t\t\t</div>\n\t\t\t <a href=\"contact.html\" class=\"btn btn-sm btn-primary-doc\">\n                Contact Us\n            </a>\n\t\t\t<div class=\"row timeline-element separline\" mbr-if=\"timelinesAmount>11\">\n\t\t\t\t<div class=\"timeline-date-panel col-lg-6\"></div>\n\t\t\t\t<span class=\"iconBackground\"></span>\n\t\t\t\t<div class=\"col-lg-6 col-11 offset-1 offset-lg-0 \">\n\t\t\t\t\t<div class=\"timeline-text-content\">\n\t\t\t\t\t\t<h4 class=\"mbr-timeline-title mbr-fonts-style\" mbr-if=\"showBlockTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">\n\t\t\t\t\t\t\tAwesome Reports\n\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t<p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat libero, bibendum in libero\n\t\t\t\t\t\t\ttempor, luctus volutpat ligula. Integer fringilla porttitor pretium. Nam erat felis, iaculis\n\t\t\t\t\t\t\tid justo ut, ullamcorper feugiat elit. Proin vel lectus auctor, porttitor ligula vitae,\n\t\t\t\t\t\t\tconvallis leo. In eget massa elit.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n                            \n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "margin-bottom": "30px"
            },
            ".mbr-section-title when (@showSubtitle)": {
              "margin-bottom": "20px"
            },
            ".timelines-container": {
              ".separline:last-child": {
                "&:before": {
                  "content": "none"
                }
              }
            },
            ".mbr-timeline-title": {
              "margin-bottom": "10px",
              "font-weight": "500"
            },
            ".timeline-text-content": {
              "padding": "27px 27px 28px 37px",
              "border": "1px solid @borderColor",
              "border-radius": "4px",
              "background-color": "@timelineBlockColor",
              "position": "relative",
              "p": {
                "margin-bottom": "0"
              },
              "&:before": {
                "content": "\"\"",
                "width": "14px",
                "height": "14px",
                "border": "1px solid @borderColor",
                "display": "block",
                "border-bottom": "none",
                "border-left": "none",
                "position": "absolute",
                "right": "-8px",
                "top": "18px",
                "background-color": "@timelineBlockColor",
                "transform": "rotate(45deg)"
              }
            },
            ".timeline-element": {
              "margin-top": "20px",
              "position": "relative",
              "word-wrap": "break-word",
              "word-break": "break-word",
              "&:nth-child(odd)": {
                ".timeline-text-content": {
                  "margin-right": "35px"
                }
              },
              "&:nth-child(even)": {
                ".timeline-text-content": {
                  "margin-left": "35px",
                  "&:before": {
                    "right": "auto",
                    "left": "-8px",
                    "top": "18px",
                    "transform": "rotate(225deg)"
                  }
                }
              }
            },
            ".iconBackground": {
              "display": "inline-block",
              "position": "absolute",
              "border-radius": "50%",
              "left": "50%",
              "top": "21px",
              "width": "10px",
              "height": "10px",
              "transform": "translateX(-50%)",
              "background-color": "@timelineColor",
              "&:before": {
                "content": "\"\"",
                "display": "block",
                "position": "absolute",
                "width": "30px",
                "height": "30px",
                "background-color": "inherit",
                "opacity": ".35",
                "top": "-10px",
                "left": "-10px",
                "border-radius": "50%"
              }
            },
            ".separline:before": {
              "top": "60px",
              "bottom": "0",
              "position": "absolute",
              "content": "\"\"",
              "width": ".5px",
              "background-color": "@timelineColor",
              "left": "calc(50% ~\"-\" 1px)",
              "height": "calc(100% ~\"-\" 3rem)",
              "opacity": ".35"
            },
            "@media (max-width: 991px)": {
              ".title__block": {
                "margin-bottom": "40px"
              },
              ".mbr-section-title when (@showSubtitle)": {
                "margin-bottom": "15px"
              },
              ".timeline-element": {
                "margin": "0 0 28px 10px",
                "&:nth-child(odd)": {
                  ".timeline-text-content": {
                    "margin-right": "10px",
                    "&:before": {
                      "right": "auto",
                      "left": "-8px",
                      "transform": "rotate(225deg)"
                    }
                  }
                },
                "&:nth-child(even)": {
                  ".timeline-text-content": {
                    "margin-right": "10px"
                  }
                }
              },
              ".timeline-text-content": {
                "padding": "18px 19px",
                "margin-left": "0 !important"
              },
              ".iconBackground": {
                "left": "0 !important"
              },
              ".separline:before": {
                "left": "0 !important"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".btn-primary-doc": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "border": "none",
              "padding": "0.6rem 1.6rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-primary-doc:hover": {
              "background-color": "#000c3f",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(221, 255, 85, 0.4)",
              "color": "#ffffff"
            },
            ".btn-outline-doc": {
              "background-color": "transparent",
              "color": "#ffffff",
              "border": "2px solid #1a472a",
              "padding": "0.5rem 1.5rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-outline-doc:hover": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(26, 71, 42, 0.3)"
            }
          },
          "_cid": "v0s1wPLsrQ",
          "_anchor": "timeline1-8z",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "timeline01",
          "_sourceTheme": "creativem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"timeline01 creativem4_timeline01\" group=\"Timeline\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"BG Layer\" name=\"bglayer\">\n        <input type=\"color\" title=\"BG Layer Color\" name=\"bgLayerColor\" value=\"#bfebf3\" condition=\"bglayer\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <header>Timeline</header>\n        <input type=\"color\" title=\"Timelines Color\" name=\"timelineColor\" value=\"#133996\">\n        <select title=\"Timelines count\" name=\"timelinesAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n            <option value=\"10\">10</option>\n            <option value=\"11\">11</option>\n            <option value=\"12\">12</option>\n        </select>\n        <input type=\"checkbox\" title=\"Hover effect\" name=\"hoverEffect\" checked>\n        <input type=\"color\" title=\"Hover Color\" name=\"hoverColor\" value=\"#bfd42a\" condition=\"hoverEffect\">\n        <input type=\"checkbox\" title=\"Reverse Timeline\" name=\"reverseTimeline\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/creativem4/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/creativem4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#cccccc\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container align-center\">\n        <h2 class=\"mbr-section-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">GOVERNANCE &amp; COMPLIANCE</h2>\n        <h3 class=\"mbr-section-subtitle pb-5 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Our Commitment to Excellence</h3>\n\n        <div class=\"container timelines-container\" mbri-timelines mbr-class=\"{'reverseTimeline': reverseTimeline}\">\n            \n            <div class=\"row timeline-element reverse\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 1}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbr-iconfont imind-warehouse\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">Board of Directors</h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Our Board of Directors, elected by shareholders, provides strategic oversight and ensures management accountability. The Board meets regularly to review performance, approve major investments, and guide long-term strategy. Board committees oversee audit, risk management, and compensation decisions.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element \" mbr-if=\"timelinesAmount>1\" mbr-class=\"{'separline':timelinesAmount>2 &amp;&amp; !reverseTimeline || !reverseTimeline &amp;&amp; timelinesAmount > 2 || reverseTimeline &amp;&amp; timelinesAmount > 1}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbr-iconfont fa-black-tie fa\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">Management Structure</h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Professional management teams operate each business sector with clear accountability structures. Corporate management coordinates cross-sector strategy, capital allocation, and shared services. Operational autonomy ensures responsiveness while corporate oversight ensures consistency.<br></p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element reverse\" mbr-if=\"timelinesAmount>2\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 3 || reverseTimeline &amp;&amp; timelinesAmount > 2}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbr-iconfont mdi-social-people-outline\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-title\">Shareholder Rights</h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">Regular General Assembly meetings (three convened to date) ensure shareholder voice in major decisions. Transparent financial reporting, audit processes, and open communication channels maintain trust. Dividend policies balance growth reinvestment with shareholder returns.<br></p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element \" mbr-if=\"timelinesAmount>3\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 4 || reverseTimeline &amp;&amp; timelinesAmount > 3}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-shopping-cart mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Design out of the box\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Quisque ut convallis turpis, ac dignissim ipsum. Curabitur pulvinar, felis sit amet interdum\n                            finibus, tellus tellus placerat massa, ornare tincidunt lorem risus quis magna. Proin\n                            scelerisque metus non mauris iaculis congue.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element reverse\" mbr-if=\"timelinesAmount>4\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 5 || reverseTimeline &amp;&amp; timelinesAmount > 4}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-file mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Awesome Reports\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Nam rutrum, lacus eget varius sodales, massa erat rutrum velit, vitae dictum tellus ligula\n                            id orci. Pellentesque sit amet sem vulputate, finibus neque et, accumsan sapien.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element\" mbr-if=\"timelinesAmount>5\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 6 || reverseTimeline &amp;&amp; timelinesAmount > 5}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-error mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Hotmail was launched commercially\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Sed eu ex vel tortor sollicitudin luctus. Aenean sit amet volutpat tellus, eu porttitor\n                            dolor. Phasellus non sem non erat vehicula pellentesque nec a diam.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element reverse\" mbr-if=\"timelinesAmount>6\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 7 || reverseTimeline &amp;&amp; timelinesAmount > 6}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-desktop mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            The SINCLAIR ZX80 mass released\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Morbi eu nulla eu erat placerat dapibus at sed metus. Aenean vitae arcu malesuada, semper\n                            nibh nec, venenatis diam.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element\" mbr-if=\"timelinesAmount>7\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 8 || reverseTimeline &amp;&amp; timelinesAmount > 7}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-credit-card mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Birth of the modern internet\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Nulla facilisi. Vestibulum tempus, metus a ultrices malesuada, eros libero venenatis augue,\n                            nec rutrum lacus nibh quis eros. Integer tempor maximus faucibus. Etiam aliquam nisl quis\n                            lectus consectetur, et condimentum velit congue.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element reverse\" mbr-if=\"timelinesAmount>8\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 9 || reverseTimeline &amp;&amp; timelinesAmount > 8}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-android mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Microsoft and apple founded\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Vestibulum euismod tortor quam. Integer ultrices aliquam pulvinar. Class aptent taciti\n                            sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element\" mbr-if=\"timelinesAmount>9\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 10 || reverseTimeline &amp;&amp; timelinesAmount > 9}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-apple mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Unix growing in popularity\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Donec posuere interdum velit. Cras finibus tristique ante non cursus. Curabitur lorem leo,\n                            dictum sed finibus ac, porta eu tellus. Sed sodales ullamcorper tempor.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element reverse\" mbr-if=\"timelinesAmount>10\" mbr-class=\"{'separline': !reverseTimeline &amp;&amp; timelinesAmount > 11 || reverseTimeline &amp;&amp; timelinesAmount > 10}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-windows mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left\">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Intel founded\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Donec at aliquet purus. Cras ligula nunc, varius mattis faucibus gravida, iaculis in nibh.\n                            Donec varius velit erat, sed hendrerit massa dictum id. Morbi a ligula tincidunt, sagittis\n                            nunc eget, sollicitudin tortor.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"row timeline-element\" mbr-if=\"timelinesAmount>11\" mbr-class=\"{'separline': reverseTimeline &amp;&amp; timelinesAmount > 11}\">\n                <span class=\"iconsBackground\">\n                    <span mbr-icon class=\"mbri-github mbr-iconfont\"></span>\n                </span>\n                <div class=\"col-xs-12 col-md-6 align-left \">\n                    <div class=\"timeline-text-content\">\n                        <h4 class=\"mbr-timeline-title pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                            Basic programming language designed\n                        </h4>\n                        <p class=\"mbr-timeline-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-timeline-text\">\n                            Aliquam erat volutpat. In hac habitasse platea dictumst. Proin sapien tortor, consectetur\n                            vel diam eu, elementum vulputate lorem.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bglayer)": {
              ".container": {
                "overflow": "hidden",
                "margin-right": "auto",
                "margin-left": "auto",
                "padding": "50px 15px",
                "border-radius": "50px",
                "background-color": "@bgLayerColor",
                "max-width": "80%"
              },
              "@media (max-width: 768px)": {
                ".container": {
                  "padding": "50px 15px !important"
                },
                ".timelines-container": {
                  "padding": "50px 21px !important"
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#767676",
              "text-align": "center",
              "font-weight": "300"
            },
            ".timeline-text-content": {
              "padding": "2rem 2.5rem",
              "background": "@timelineColor",
              "margin-right": "2rem",
              "border-radius": "40px",
              "p": {
                "margin-bottom": "0"
              },
              "@media (max-width: 768px)": {
                "padding": "1.5rem 0.5rem"
              },
              "-webkit-transition": "all 0.4s",
              "transition": "all 0.4s"
            },
            ".mbr-timeline-title, .mbr-timeline-text": {
              "color": "#ffffff"
            },
            ".timeline-element": {
              "margin-bottom": "50px",
              "position": "relative",
              "word-wrap": "break-word",
              "word-break": "break-word",
              "display": "-webkit-flex",
              "-webkit-box-orient": "horizontal",
              "-webkit-box-direction": "normal",
              "-ms-flex-direction": "row",
              "flex-direction": "row",
              "& when (@hoverEffect)": {
                "&:hover": {
                  ".timeline-text-content": {
                    "-webkit-box-shadow": "0 7px 20px 0px rgba(0, 0, 0, 0.08) !important",
                    "box-shadow": "0 7px 20px 0px rgba(0, 0, 0, 0.08) !important",
                    "-webkit-transition": "all 0.4s !important",
                    "transition": "all 0.4s !important",
                    "h4, p": {
                      "-webkit-transition": "color 1s !important",
                      "transition": "color 1s !important",
                      "color": "@hoverColor !important"
                    }
                  },
                  ".iconsBackground": {
                    "span": {
                      "-webkit-transition": "color 1s !important",
                      "transition": "color 1s !important",
                      "color": "@hoverColor !important"
                    }
                  },
                  "&:before": {
                    "-webkit-transition": "background-color 1s !important",
                    "transition": "background-color 1s !important",
                    "background-color": "@hoverColor !important"
                  }
                }
              }
            },
            ".reverse": {
              "-webkit-box-orient": "horizontal",
              "-webkit-box-direction": "reverse",
              "-ms-flex-direction": "row-reverse",
