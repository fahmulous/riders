    "google-analytics": "<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>\n<!-- End Google Analytics -->",
    "global_header_custom": "<!-- SEO Meta Tags -->\n<meta name=\"keywords\" content=\"RIDERS-ELSE leadership, textile industry leaders, Ethiopian textile executives, sustainable textile management, apparel manufacturing leadership, textile company directors\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.riders-else.com/leadership.html\">\n<meta property=\"og:title\" content=\"Leadership Team | Textile Industry Experts | RIDERS-ELSE\">\n<meta property=\"og:description\" content=\"Meet the experienced leadership team at RIDERS-ELSE, a premier Ethiopian textile manufacturer with expertise in sustainable textile production.\">\n<meta property=\"og:image\" content=\"https://www.riders-else.com/assets/images/leadership-social.jpg\">\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://www.riders-else.com/leadership.html\">\n<meta property=\"twitter:title\" content=\"Leadership Team | Textile Industry Experts | RIDERS-ELSE\">\n<meta property=\"twitter:description\" content=\"Meet the experienced leadership team at RIDERS-ELSE, a premier Ethiopian textile manufacturer with expertise in sustainable textile production.\">\n<meta property=\"twitter:image\" content=\"https://www.riders-else.com/assets/images/leadership-social.jpg\">\n<link rel=\"canonical\" href=\"https://www.riders-else.com/leadership.html\">",
    "global_after_body": "<!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>\n<!-- End Google Analytics -->",
    "global_footer_custom": "<!-- Structured Data for Leadership Team -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"RIDERS-ELSE\",\n  \"url\": \"https://www.riders-else.com\",\n  \"logo\": \"https://www.riders-else.com/assets/images/logo.png\",\n  \"sameAs\": [\n    \"https://www.facebook.com/riderselsetextile\",\n    \"https://www.linkedin.com/company/riders-else\",\n    \"https://www.instagram.com/riders_else_textile\"\n  ],\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"Sarbet K F J Apartments\",\n    \"addressLocality\": \"Addis Ababa\",\n    \"addressCountry\": \"Ethiopia\"\n  },\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"telephone\": \"+251-911-072513\",\n    \"email\": \"info@ridersgroupsc.com\",\n    \"contactType\": \"Customer Service\"\n  },\n  \"member\": [\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Natnael Tewodros\",\n      \"jobTitle\": \"Chief Executive Officer\",\n      \"description\": \"Leads RIDERS-ELSE with over 15 years of experience in textile manufacturing and international trade.\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Samuel Bekele\",\n      \"jobTitle\": \"Chief Operations Officer\",\n      \"description\": \"Oversees all manufacturing operations with expertise in sustainable production practices.\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Tigist Haile\",\n      \"jobTitle\": \"Chief Financial Officer\",\n      \"description\": \"Manages financial strategy with background in international business and textile industry economics.\"\n    }\n  ]\n}\n</script>",
    "global_before_html": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->",
