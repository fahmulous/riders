        {
          "_name": "features2",
          "_sourceTheme": "connectm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Color\" name=\"cardColor\" value=\"#ffffff\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/connectm4/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/connectm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"content-wrapper\">\n            <div class=\"row align-items-center\">\n                <div class=\"col-12 col-lg-{{12 - imageWidth}}\" mbr-class=\"{'order-2':reverseContent}\">\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Zamzam Bank</h6>\n                                                <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Strategic Value:</b></p>\n                                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Investment Year: 2023–2024</span><br></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Status: Operational</span></li>\n                            </ul>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Zamzam Bank is one of Ethiopia's emerging commercial banks, providing comprehensive banking services including corporate banking, retail banking, and trade finance. The bank operates a growing branch network serving individual customers, businesses, and corporate clients across Ethiopia.<br><br><b>Services:</b><br></p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Corporate and commercial banking</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Retail banking and savings accounts</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Trade finance and foreign exchange</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Digital banking services</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">SME financing</span></li>\n                            </ul>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Strategic Value:</b><br></p>\n                                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Access to banking services for Riders' operations</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Dividend income from profitable banking operations</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Exposure to Ethiopia's growing financial sector</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Strategic banking relationships supporting business growth</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Long-term capital appreciation potential</span></li>\n                            </ul>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Learn more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-{{imageWidth}}\">\n                    <div class=\"image-wrapper\" mbr-class=\"{'reverse' : reverseContent}\">\n                        <img src=\"@PROJECT_PATH@/assets/images/zamzam-bank-logo.jpg\" alt=\"Mobirise\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
