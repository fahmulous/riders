                ".card_2": {
                  "padding-top": "5rem",
                  "@media (max-width: 992px)": {
                    "padding-top": "0"
                  },
                  ".card-box": {
                    "background-color": "@cardBg_2",
                    ".title-wrapper .iconfont-wrapper .mbr-iconfont": {
                      "color": "@icon_2"
                    }
                  }
                },
                ".card_3": {
                  "padding-top": "10rem",
                  "@media (max-width: 992px)": {
                    "padding-top": "0"
                  },
                  ".card-box": {
                    "background-color": "@cardBg_3",
                    ".title-wrapper .iconfont-wrapper .mbr-iconfont": {
                      "color": "@icon_3"
                    }
                  }
                },
                ".card_4": {
                  "padding-top": "15rem",
                  "@media (max-width: 992px)": {
                    "padding-top": "0"
                  },
                  ".card-box": {
                    "background-color": "@cardBg_4",
                    ".title-wrapper .iconfont-wrapper .mbr-iconfont": {
                      "color": "@icon_4"
                    }
                  }
