                    "@media (max-width: 992px)": {
                      "padding": "24px"
                    },
                    ".panel-title-edit": {
                      "margin-bottom": "0",
                      "transition": "all 0.3s ease-in-out"
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "display": "flex",
                    "align-items": "center",
                    "padding": "0 48px 48px",
                    "@media (max-width: 992px)": {
