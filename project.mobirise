        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "z-index": "1",
              "width": "50%",
              "margin": "0 auto",
              "@media (max-width: 1440px)": {
                "width": "75%"
              },
              "@media (max-width: 992px)": {
                "width": "100%"
              },
              ".mbr-label": {
                "margin-bottom": "24px",
                "text-transform": "uppercase"
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".mbr-text": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                }
              },
              ".desc-wrapper": {
                "position": "relative",
                "margin": "24px 48px 0",
                "@media (max-width: 992px)": {
                  "margin": "24px 0 0"
                },
                "&::before, &::after": {
                  "content": "''",
                  "position": "absolute",
                  "left": "0",
                  "background-image": "linear-gradient(90deg, transparent, @descBorder 50%, transparent)",
                  "width": "100%",
                  "height": "1px"
                },
                "&::before": {
                  "top": "0"
                },
                "&:after": {
                  "bottom": "0"
                },
                ".mbr-desc": {
                  "padding": "8px 0",
                  "text-transform": "uppercase",
                  "background-image": "linear-gradient(90deg, transparent, @descBg 50%, transparent)"
                }
              }
            },
            ".mbr-label": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#181824"
            },
            ".mbr-text": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-desc": {
              "color": "#49496d",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn, .logo-wrapper": {
              "color": "#141414"
            }
          },
          "_name": "header02",
          "_sourceTheme": "choicem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header02 choicem5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description Border\" value=\"#ffffff\" name=\"descBorder\" condition=\"showDesc\" selected>\n        <input type=\"color\" title=\"Description BG\" value=\"#eeeef4\" name=\"descBg\" condition=\"showDesc\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/background1.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#eeeef4\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@SITES@/2098721/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#eeeef4\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center content-wrap\">\n            <div class=\"col-12\">\n                <div class=\"gradient-wrap\" mbr-if=\"showGradient\"></div>\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">\n                        OUR STORY IN PICTURES\n                    </p>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .logo-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Visual Journey of Riders</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Browse through our collection of photos documenting Riders Trading and Manufacturing S.C.'s growth, achievements, and memorable moments. From General Assemblies to facility visits, these images capture our commitment to transparency, shareholder engagement, and operational excellence.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            About service\n                        </a>\n                    </div>\n                    <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                            ORGANIZATIONS SEEKING EFFICIENCY\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0CrNjpV1Y",
          "_anchor": "header02-ci",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
