            },
            ".list": {
              "color": "#ffffff"
            },
            ".mbr-contact": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "color": "#141414",
              "text-align": "left"
