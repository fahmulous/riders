        {
          "_name": "features006",
          "_sourceTheme": "seminarm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features006\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        \n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Show Title Card\" name=\"showTitleCard\" checked>\n        <input type=\"checkbox\" title=\"Show Text Card\" name=\"showTextCard\" checked>\n        <input type=\"color\" title=\"Card Color\" name=\"cardColor\" value=\"#f8f8f8\">\n        <input type=\"color\" title=\"Left Card Accent\" name=\"leftAccentColor\" value=\"#bfd42a\">\n        <input type=\"color\" title=\"Right Card Color\" name=\"rightAccentColor\" value=\"#309f5e\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"https://e.mobirise.com/seminarm4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/seminarm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-12 align-center mb-2\" mbr-if=\"showTitle || showText\">\n                <h2 class=\"mbr-section-title mbr-bold mbr-black pb-4 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Strategic Benefits for Riders Shareholders</h2>\n                <p class=\"mbr-text mbr-section-text mbr-black mbr-regular mbr-fonts-style pb-4 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text\">\n                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam tortor purus, suscipit a\n                    accumsan quis, blandit a dolor. Morbi quis purus at ipsum tristique varius sit amet id odio. Ut\n                    tincidunt ligula ut tortor aliquet dignissim. Proin fermentum felis eget urna lobortis.</p>\n            </div>\n            <div class=\"col-md-6 col-12 align-left feature align-items-stretch\">\n                <div class=\"card\">\n                    <h3 class=\"mbr-section-title mbr-semibold mbr-black mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitleCard\">Investment Rationale</h3>\n                    <h3 class=\"mbr-section-title mbr-semibold mbr-black mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitleCard\">Why We Invest in Financial Services:</h3>\n<ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Portfolio Diversification - Balance operational businesses (textile, agriculture, real estate) with financial sector investments, reducing concentration risk</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Stable Dividend Income - Regular distributions from profitable banking and micro-finance operations provide consistent cash flow</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">High-Growth Sector - Ethiopia's financial services sector is expanding rapidly with banking penetration increasing and new regulations supporting growth</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Strategic Access - Direct banking relationships facilitate working capital loans, trade finance, and foreign exchange services for Riders' operations</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Long-Term Capital Appreciation - Equity stakes in growing financial institutions offer significant value appreciation potential as the sector matures</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Economic Participation - Contributing to Ethiopia's financial development and inclusion while generating returns for shareholders</span></li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-md-6 col-12 align-left feature align-items-stretch\">\n                <div class=\"card\">\n                    <h3 class=\"mbr-section-title mbr-semibold mbr-black mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitleCard\">Shareholder Benefits</h3>\n                    <h3 class=\"mbr-section-title mbr-semibold mbr-black mb-0 mbr-fonts-style\" mbr-if=\"showTitleCard\" mbr-theme-style=\"display-7\"><b>Value for Riders Shareholders:</b></h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Recurring Revenue Stream - Annual dividends from bank profits supplement income from textile manufacturing and farming operations</li><li class=\"item-wrap\">Capital Growth - Increasing value of financial sector stakes as Ethiopian banking sector expands</li><li class=\"item-wrap\">Risk Mitigation - Financial investments provide portfolio balance against operational risks in manufacturing and agriculture</li><li class=\"item-wrap\">Liquidity Potential - Listed financial institutions offer future exit opportunities and tradeable equity positions</li><li class=\"item-wrap\">Synergy Benefits - Banking services support Riders' core businesses with preferential access to credit facilities and financial products</li><li class=\"item-wrap\">Sector Exposure - Shareholders gain indirect exposure to Ethiopia's high-growth financial services industry</li>\n                            </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n     <a href=\"contact.html\" class=\"btn btn-sm btn-primary-doc\" download>\n         View Investment Details\n  </a>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".feature": {
              ".card": {
                "border-left": "10px solid @leftAccentColor",
                "background-color": "@cardColor",
                "height": "100%",
                "padding": "2rem 40px",
                "border-radius": "0"
              },
              "&:last-child": {
                ".card": {
                  "border-color": "@rightAccentColor"
                }
              },
              ".mbr-section-title": {
                "line-height": "1",
                "& when (@showTextCard)": {
                  "padding-bottom": "20px"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".feature:last-child": {
                "margin-top": "2rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".btn-primary-doc": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "border": "none",
              "padding": "0.6rem 1.6rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-primary-doc:hover": {
              "background-color": "#000c3f",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(221, 255, 85, 0.4)",
              "color": "#ffffff"
            },
            ".btn-outline-doc": {
              "background-color": "transparent",
              "color": "#ffffff",
              "border": "2px solid #1a472a",
              "padding": "0.5rem 1.5rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-outline-doc:hover": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(26, 71, 42, 0.3)"
            }
          },
          "_cid": "v0AbXAZb1E",
          "_anchor": "features006-bt",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
