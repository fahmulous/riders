    "about.html": {
      "settings": {
        "title": "About | RIDERS Trading and Manufacturing",
        "order": "1",
        "meta_descr": "Learn about RIDERS, Ethiopia's leading textile manufacturer with a rich history of innovation, sustainability, and quality. Discover our mission, vision, values, and commitment to ethical manufacturing practices using premium Ethiopian cotton.",
        "header_custom": "<!-- Primary Meta Tags -->\n<meta name=\"title\" content=\"About RIDERS | Leading Textile Manufacturer in Ethiopia\">\n<meta name=\"description\" content=\"Learn about RIDERS, Ethiopia's leading textile manufacturer with a rich history of innovation, sustainability, and quality. Discover our mission, vision, values, and commitment to ethical manufacturing practices using premium Ethiopian cotton.\">\n<meta name=\"keywords\" content=\"about RIDERS, Ethiopian textile company, textile manufacturing history, sustainable textile production, ethical manufacturing, Ethiopian cotton, textile company mission, textile company values\">\n\n<!-- Open Graph / Facebook -->\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.riders-else.com/about.html\">\n<meta property=\"og:title\" content=\"About RIDERS | Leading Textile Manufacturer in Ethiopia\">\n<meta property=\"og:description\" content=\"Learn about RIDERS, Ethiopia's leading textile manufacturer with a rich history of innovation, sustainability, and quality.\">\n<meta property=\"og:image\" content=\"https://www.riders-else.com/assets/images/about-social-share.jpg\">\n\n<!-- Twitter -->\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://www.riders-else.com/about.html\">\n<meta property=\"twitter:title\" content=\"About RIDERS | Leading Textile Manufacturer in Ethiopia\">\n<meta property=\"twitter:description\" content=\"Learn about RIDERS, Ethiopia's leading textile manufacturer with a rich history of innovation, sustainability, and quality.\">\n<meta property=\"twitter:image\" content=\"https://www.riders-else.com/assets/images/about-social-share.jpg\">\n\n<!-- Canonical URL -->\n<link rel=\"canonical\" href=\"https://www.riders-else.com/about.html\">",
        "footer_custom": "<!-- Structured Data for About Page -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"AboutPage\",\n  \"mainEntity\": {\n    \"@type\": \"Organization\",\n    \"name\": \"RIDERS\",\n    \"description\": \"Ethiopia's leading textile manufacturer with a rich history of innovation, sustainability, and quality.\",\n    \"foundingDate\": \"2015\",\n    \"foundingLocation\": \"Addis Ababa, Ethiopia\",\n    \"knowsAbout\": [\"Textile Manufacturing\", \"Ethiopian Cotton\", \"Sustainable Production\", \"Apparel Manufacturing\"],\n    \"slogan\": \"Excellence in Ethiopian Textile Manufacturing\",\n    \"ethicsPolicy\": \"https://www.riders-else.com/sustainability.html\"\n  },\n  \"speakable\": {\n    \"@type\": \"SpeakableSpecification\",\n    \"cssSelector\": [\".company-history\", \".mission-vision\", \".values\"]\n  }\n}\n</script>\n\n<!-- Company History Timeline Structured Data -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"ItemList\",\n  \"itemListElement\": [\n    {\n      \"@type\": \"ListItem\",\n      \"position\": 1,\n      \"item\": {\n        \"@type\": \"Event\",\n        \"name\": \"Company Founding\",\n        \"description\": \"RIDERS was established in Addis Ababa\",\n        \"startDate\": \"2015\"\n      }\n    },\n    {\n      \"@type\": \"ListItem\",\n      \"position\": 2,\n      \"item\": {\n        \"@type\": \"Event\",\n        \"name\": \"Production Expansion\",\n        \"description\": \"Expanded manufacturing capabilities with state-of-the-art equipment\",\n        \"startDate\": \"2018\"\n      }\n    },\n    {\n      \"@type\": \"ListItem\",\n      \"position\": 3,\n      \"item\": {\n        \"@type\": \"Event\",\n        \"name\": \"Sustainability Initiative\",\n        \"description\": \"Launched comprehensive sustainability program\",\n        \"startDate\": \"2020\"\n      }\n    },\n    {\n      \"@type\": \"ListItem\",\n      \"position\": 4,\n      \"item\": {\n        \"@type\": \"Event\",\n        \"name\": \"International Expansion\",\n        \"description\": \"Began exporting to global markets\",\n        \"startDate\": \"2022\"\n      }\n    }\n  ]\n}\n</script>",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar-dropdown": {
              "& when not (@transparent)": {
