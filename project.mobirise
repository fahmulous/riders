                  "color": "@icon",
                  "font-size": "42px"
                }
              },
              ".content-card-text": {
                ".mbr-card-title": {
                  "margin-bottom": "15px"
                },
                ".mbr-card-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-card-title": {
              "color": "#080808",
              "text-align": "center"
            },
            ".mbr-card-text": {
              "color": "#65676c",
              "text-align": "center"
            }
          },
          "_cid": "v0yM4s8d6l",
