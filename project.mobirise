        {
          "_name": "team1",
          "_sourceTheme": "snackm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"team1\" group=\"People\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" xmlns=\"http://www.w3.org/1999/html\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subitle\" name=\"showSubtitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverse\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Subitle\" name=\"showCardSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Background\" name=\"addCardBg\">\n        <input type=\"color\" title=\"Color\" name=\"cardBg\" value=\"#cd8ad1\">\n        <input type=\"range\" name=\"bordertWidth\" title=\"Border Width\" min=\"1\" max=\"5\" value=\"1\" step=\"1\" condition=\"border\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <select title=\"Align\" name=\"align\" condition=\"showSocial\">\n            <option value=\"justify-content-start\" selected>Top</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Bottom</option>\n        </select>\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#33d5ad\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Hover\" name=\"socialIconHoverColor\" value=\"#cd8ad1\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-4.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"mbr-section-head\">\n            <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div><b>Department Leadership</b></div></h3>\n            <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Our management team brings specialized expertise to each department, ensuring operational excellence across all aspects of our business. These talented professionals translate our company vision into daily action.</h4>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"card item-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"social-row display-7 {{align}}\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 3\">\n                                <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"image-wrapper item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-06-at-18.05.58-removebg-preview-353x450.png\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"card-text\">\n                            <div class=\"card-text-head\">\n                                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Anwar Neja</b></h5>\n                                <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-subtitle\"><b>Head, Human Resource Admin &amp; Development</b></h6>\n                            </div>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                leads our Human Resources division, ensuring our team is well-managed and developed. He has over 18 years of experience and holds a Masters degree.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"card item-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"social-row display-7 {{align}}\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 3\">\n                                <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"image-wrapper item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-06-at-17.57.25-removebg-preview-363x490.png\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"card-text\">\n                            <div class=\"card-text-head\">\n                                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Zinet Siraj&nbsp;</b></h5>\n                                <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-subtitle\"><b>Head, Finance</b></h6>\n                            </div>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                oversees all financial operations, leveraging over 16 years of experience and a Masters degree to manage our capital.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"card item-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"social-row display-7 {{align}}\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 3\">\n                                <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"image-wrapper item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-06-at-17.57.10-removebg-preview-363x480.png\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"card-text\">\n                            <div class=\"card-text-head\">\n                                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Jemil Nuredin</b></h5>\n                                <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-subtitle\"><b>Head, Shareholders Management &amp; Marketing</b></h6>\n                            </div>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">Jemil Nuredin is responsible for managing shareholder relations and marketing, with more than 18 years of experience and a Masters degree.<br></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"card item-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"social-row display-7 {{align}}\" mbr-if=\"showSocial\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 1\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 2\">\n                                <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 3\">\n                                <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount > 4\">\n                                <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                        <div class=\"image-wrapper item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/1688415698373-363x363.jpg\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"card-text\">\n                            <div class=\"card-text-head\">\n                                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">Muhidin Jemal</h5>\n                                <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-subtitle\"><b>Head, Legal Services</b></h6>\n                            </div>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Muhidin Jemal has over 7 years of experience in legal services, providing the expertise to navigate all legal matters for our company.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-head": {
              "margin-bottom": "2.3rem"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#1e4381"
            },
            ".mbr-section-subtitle": {
              "text-align": "left",
              "color": "#656565"
            },
            ".card-title": {
              "margin-bottom": "1rem",
              "color": "#33d5ad",
              "& when not (@showSubtitle)": {
                "& when not (@showText)": {
                  "margin-bottom": "0"
                }
              }
            },
            ".card-subtitle": {
              "color": "#1f1437"
            },
            ".mbr-text": {
              "margin-top": "1.5rem",
              "margin-bottom": "0",
              "color": "#1f1437"
            },
            ".card:not(:nth-last-child(1))": {
              "margin-bottom": "2rem"
            },
            ".card": {
              "height": "100%",
              "background-color": "@cardBg",
              "border-width": "(@bordertWidth * 1px)",
              "border-style": "dashed",
              "border-color": "@cardBg",
              "border-radius": "30px",
              "padding": "1rem 0.5rem",
              "& when not (@addCardBg)": {
                "background": "transparent"
              }
            },
            ".card-wrapper": {
              "display": "flex",
              "& when (@reverse)": {
                "flex-direction": "row-reverse"
              },
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "flex-direction": "column"
              },
              "@media (max-width: 767px)": {
                "flex-direction": "column"
              }
            },
            ".social-row": {
              "width": "50px",
              "padding-top": "1rem",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "flex-shrink": "0",
              "@media (max-width: 767px)": {
                "width": "100%",
                "flex-direction": "row",
                "justify-content": "center !important"
              },
              ".soc-item": {
                "width": "34px",
                "height": "34px",
                "display": "inline-block",
                "text-align": "center",
                "border-radius": "50%",
                "margin-bottom": "1rem",
                "padding": "0.5rem",
                "transition": "all 0.3s",
                "@media (max-width: 767px)": {
                  "margin-left": "0.5rem",
                  "margin-right": "0.5rem"
                },
                ".mbr-iconfont": {
                  "display": "flex",
                  "justify-content": "center",
                  "align-content": "center",
                  "color": "@socialIconColor",
                  "font-size": "1.5rem",
                  "transition": "all 0.3s"
                },
                "&:hover": {
                  ".mbr-iconfont": {
                    "color": "@socialIconHoverColor"
                  }
                }
              }
            },
            ".image-wrapper": {
              "width": "35%",
              "aspect-ratio": "1",
              "flex-shrink": "0",
              "padding": "1rem",
              "@media (min-width: 1200px) and (max-width: 1399px)": {
                "width": "45%"
              },
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "width": "100%"
              },
              "@media (max-width: 767px)": {
                "width": "100%"
              },
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "15px"
              }
            },
            ".card-text": {
              "padding": "1rem"
            },
            "div[class*=\"col\"]": {
              "margin-bottom": "2rem"
            },
            ".mbr-section-title DIV": {
              "text-align": "left"
            }
          },
          "_cid": "uVnRkPlNHu",
          "_anchor": "team1-2p",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
