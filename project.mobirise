              "border": "none",
              "padding": "0.6rem 1.6rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-primary-doc:hover": {
              "background-color": "#000c3f",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(221, 255, 85, 0.4)",
              "color": "#ffffff"
            },
            ".btn-outline-doc": {
              "background-color": "transparent",
              "color": "#ffffff",
              "border": "2px solid #1a472a",
              "padding": "0.5rem 1.5rem",
              "border-radius": "25px",
              "font-family": "'Montserrat', sans-serif",
              "font-weight": "300",
              "font-size": "1.2rem",
              "text-decoration": "none",
              "display": "inline-block",
              "transition": "all 0.3s ease"
            },
            ".btn-outline-doc:hover": {
              "background-color": "#000c3f",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 12px rgba(26, 71, 42, 0.3)"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#141414"
            }
          },
          "_name": "features06",
          "_sourceTheme": "strengthm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features06 strengthm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Icons</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon BG 1\" value=\"#bfd42a\" name=\"iconBg_1\" selected>\n        <input type=\"color\" title=\"Icon Border 1\" value=\"#309f5e\" name=\"iconBorder_1\" selected>\n        <input type=\"color\" title=\"Icon BG 2\" value=\"#bfd42a\" name=\"iconBg_2\" selected>\n        <input type=\"color\" title=\"Icon Border 2\" value=\"#309f5e\" name=\"iconBorder_2\" selected>\n        <input type=\"color\" title=\"Icon BG 3\" value=\"#bfd42a\" name=\"iconBg_3\" selected>\n        <input type=\"color\" title=\"Icon Border 3\" value=\"#309f5e\" name=\"iconBorder_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/strengthm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/strengthm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                    <div class=\"col-12 col-lg-10 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Our Core Values</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Five core values guide every decision, investment, and action across Riders Trading and Manufacturing S.C.<br><br></p>\n                </div>\n            </div>\n        <div class=\"row items-wrapper justify-content-center\">\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"iconfont-wrapper icon_1\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon fa-handshake-o fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <p class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>INTEGRITY</b></p>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Ethical business practices without exception</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Transparent reporting and honest communication</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Accountability to shareholders and stakeholders</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Compliance with all laws and regulations</span></li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"iconfont-wrapper icon_2\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon fa-shield fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <p class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>ENDURANCE</b><br></p>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Long-term perspective in all investments</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Resilience through challenges and setbacks</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Sustained commitment to our vision</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Building lasting value for generations</span></li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"iconfont-wrapper icon_3\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon fa-balance-scale fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <p class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>ETHICS</b><br></p>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Moral principles guide all business decisions</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Fair treatment of employees, partners, and stakeholders</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Environmental and social responsibility</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Ethical leadership from board to operations</span></li>\n                            </ul>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"iconfont-wrapper icon_3\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon fa-graduation-cap fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <p class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>LEARNING</b><br></p>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Continuous professional development</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Knowledge sharing across the organization</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Adaptation to industry best practices</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Investment in employee training and growth</span></li>\n                            </ul>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"iconfont-wrapper icon_3\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon fa-users fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <p class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>TEAMWORK</b><br></p>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Environmental stewardship</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Community engagement and social impact</span><br></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Employee welfare and development</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Contribution to national development goals</span></li>\n                            </ul>\n                </div>\n<a href=\"contact.html\" class=\"btn btn-sm btn-primary-doc\" download>\n         Become Part of Riders\n  </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0sRB3lD3n",
          "_anchor": "features06-9p",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
