        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "&::before": {
              "content": "''",
              "position": "absolute",
              "bottom": "0",
              "width": "200vh",
              "height": "85%",
              "background-image": "linear-gradient(transparent, @shadow 50%)",
              "z-index": "1"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".logo-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start",
              "gap": "0",
              "margin-bottom": "0",
              "padding-top": "0",
              "max-width": "100%",
              "a": {
                "display": "block",
                "line-height": "0",
                "margin": "0",
                "padding": "0"
              },
              "a:first-child": {
                "margin-bottom": "0"
              },
              ".footer-logo-img": {
                "width": "250px !important",
                "height": "auto !important",
                "max-height": "120px !important",
                "object-fit": "contain",
                "border-radius": "8px !important",
                "display": "block"
              },
              ".tagline-footer-img": {
                "width": "auto !important",
                "height": "30px !important",
                "border-radius": "0 !important",
                "object-fit": "contain",
                "image-rendering": "crisp-edges",
                "display": "block",
                "margin-top": "8px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                ".footer-logo-img": {
                  "width": "220px !important",
                  "max-height": "100px !important"
                },
                ".tagline-footer-img": {
                  "height": "25px !important",
                  "margin-top": "6px"
                }
              },
              "@media (max-width: 576px)": {
                ".footer-logo-img": {
                  "width": "200px !important",
                  "max-height": "90px !important"
                },
                ".tagline-footer-img": {
                  "height": "22px !important"
                }
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".row-main": {
              "position": "relative",
              "align-items": "flex-start",
              "justify-content": "center",
              "& when (@showBorder)": {
                "padding": "20px 0",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                }
              },
              ".card": {
                "justify-content": "center",
                "padding-top": "0 !important"
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "10px",
                "letter-spacing": "1px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".nav-wrapper": {
              "text-align": "center",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                "text-align": "left"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px",
                "text-align": "center",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".list": {
                "padding": "0",
                "margin": "0",
                "list-style-type": "none",
                "display": "inline-block",
                "text-align": "left",
                ".item-wrap": {
                  "margin-bottom": "5px",
                  "cursor": "pointer",
                  "position": "relative",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:hover": {
                    "color": "@active",
                    "&::before": {
                      "width": "100%"
                    }
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "height": "1px",
                    "width": "0",
                    "background-color": "@active",
                    "transition": "all 0.3s ease-in-out"
                  }
                }
              }
            },
            ".contacts-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".contacts-wrap": {
                ".item-contact": {
                  "margin-bottom": "15px",
                  ".item-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    ".mbr-iconfont": {
                      "font-size": "30px",
                      "color": "@icon",
                      "display": "inline-flex",
                      "margin-right": "20px"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-contact": {
                          "color": "@active",
                          "&::before": {
                            "width": "100%"
                          }
                        }
                      },
                      ".mbr-contact": {
                        "margin-bottom": "0",
                        "position": "relative",
                        "transition": "all 0.3s ease-in-out",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "height": "1px",
                          "width": "0",
                          "background-color": "@active",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".mbr-desc": {
                "margin-bottom": "5px"
              },
              ".social-wrapper": {
                "margin-top": "10px",
                ".social-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "@media (max-width: 992px)": {
                      "margin-left": "16px",
                      "&:first-child": {
                        "margin-left": "0"
                      }
                    },
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "36px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "padding": "25px 0",
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#1e4381"
            },
            ".mbr-text": {
              "color": "#141414"
            },
            ".mbr-section-subtitle": {
              "color": "#141414"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".mbr-contact": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "color": "#141414",
              "text-align": "left"
            },
            ".mbr-contact, .item-contact": {
              "color": "#141414"
            },
            ".mbr-desc, .mbr-section-btn": {
