        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".images-wrapper": {
              "margin-right": "30px",
              "position": "relative",
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "height": "100%",
              "min-height": "465px",
              "@media (max-width: 1440px)": {
                "display": "grid",
                "min-height": "auto",
                "grid-template-columns": "1fr 1fr",
                "gap": "0"
              },
              "@media (max-width: 992px)": {
                "margin-right": "0",
                "margin-bottom": "30px",
                "min-height": "auto"
              },
              "@media (max-width: 768px)": {
                "display": "block"
              },
              "& when (@reverseContent)": {
                "margin-right": "0",
                "margin-left": "30px",
                "@media (max-width: 992px)": {
                  "margin-left": "0"
                }
              },
              ".image_1": {
                "img": {
                  "bottom": "0",
                  "left": "30%",
                  "width": "300px",
                  "height": "300px",
                  "z-index": "1",
                  "& when not (@fullWidth)": {
                    "left": "20%"
                  }
                }
              },
              ".image_2": {
                "img": {
                  "top": "25%",
                  "left": "0",
                  "width": "240px",
                  "height": "240px",
                  "z-index": "2"
                }
              },
              ".image_3": {
                "img": {
                  "top": "20%",
                  "right": "0",
                  "width": "240px",
                  "height": "240px",
                  "z-index": "2"
                }
              },
              ".image_4": {
                "img": {
                  "top": "0",
                  "left": "10%",
                  "width": "200px",
                  "height": "200px",
                  "& when not (@fullWidth)": {
                    "left": "0"
                  }
                }
              },
              ".image_5": {
                "img": {
                  "top": "0",
                  "right": "15%",
                  "width": "200px",
                  "height": "200px",
                  "& when not (@fullWidth)": {
                    "right": "0"
                  }
                }
              },
              ".image-wrap": {
                "img": {
                  "position": "absolute",
                  "object-fit": "cover",
                  "@media (max-width: 1440px)": {
                    "position": "static",
                    "height": "200px",
                    "width": "100%"
                  },
                  "@media (max-width: 768px)": {
                    "height": "300px"
                  }
                }
              }
            },
            ".content-wrapper": {
              ".mbr-label": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                }
              },
              ".mbr-section-title": {
                "display": "inline-block",
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                }
              },
              ".mbr-text": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                }
              }
            },
            ".mbr-label": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_name": "article05",
          "_sourceTheme": "identitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article05 identitym5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"range\" title=\"Images Count\" name=\"card\" min=\"1\" max=\"5\" step=\"1\" value=\"5\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/rider's%2520logo%2520with%2520descriptor-1-128x83.png\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/identitym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5 card\">\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">\n                        [&nbsp;<span>Conscious Fabric</span>&nbsp;]\n                    </p>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .title-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Who We Are</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Riders Trading and Manufacturing S.C. is Ethiopia's pioneering shareholder-driven diversified holding company, established in 2021 with a bold vision: to create sustainable wealth through strategic investments across high-growth sectors while contributing meaningfully to national economic transformation.<br><br>With ETB 1 Billion in registered capital and a community of 1,160+ shareholders, we represent a new model of collective investment—combining the democratic strength of broad ownership with the strategic discipline of professional management. Our structure allows individual investors to participate in large-scale industrial and agricultural ventures that would be impossible to access alone.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"organizational-structure.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Our Organizational Structure\n                        </a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0rdS9yMTm",
          "_anchor": "article05-85",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article4",
          "_sourceTheme": "impressm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article4\" group=\"Article\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n\t\t<header>Column 1</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showFirstTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showFirstSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showFirstText\" checked>\n\t\t<header>Column 2</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSecondTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSecondSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showSecondText\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/photo-2025-09-11-10-34-06-removebg-preview-620x402.png\" selected parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row align-items-center\" mbr-class=\"{'flex-row-reverse': reverse}\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<div class=\"row justify-content-space-between\">\n\t\t\t\t\t<div class=\"col-12 col-lg-6\">\n\t\t\t\t\t\t<div class=\"text-wrap\">\n\t\t\t\t\t\t\t<h4 class=\"mbr-first-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-first-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showFirstSubtitle\">Built on Solid Principles</h4>\n\t\t\t\t\t\t\t<h2 class=\"mbr-first-section-title mbr-fonts-style\" data-app-selector=\".mbr-first-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showFirstTitle\">\n\t\t\t\t\t\t\t\tFOUNDATION\n\t\t\t\t\t\t\t</h2>\n\t\t\t\t\t\t\t<p class=\"mbr-first-section-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-first-section-text\" mbr-if=\"showFirstText\">Riders Trading and Manufacturing S.C. was incorporated in 2021 as a share company under Ethiopian commercial law. Our founders recognized that Ethiopia's rapid economic growth demanded new investment vehicles that could mobilize domestic capital at scale while maintaining accountability to shareholders.<br><br>The company's structure follows the successful model of Ethiopian diversified holding companies, with a clear separation between governance (Board of Directors), strategic oversight (Corporate Management), and operational execution (Sector Management Teams).</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-12 col-lg-6\">\n\t\t\t\t\t\t<div class=\"text-wrap\">\n\t\t\t\t\t\t\t<h4 class=\"mbr-second-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-second-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSecondSubtitle\">Shareholder-Driven Governance</h4>\n\t\t\t\t\t\t\t<h2 class=\"mbr-second-section-title mbr-fonts-style\" data-app-selector=\".mbr-second-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showSecondTitle\">OWNERSHIP STRUCTURE</h2>\n\t\t\t\t\t\t\t<p class=\"mbr-second-section-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-second-section-text\" mbr-if=\"showSecondText\">With 1,160+ shareholders, Riders represents one of Ethiopia's broadest investment communities. Our shareholders range from individual investors to institutional participants, united by shared confidence in Ethiopia's economic potential.<br><br>Regular General Assembly meetings ensure shareholder voices guide major strategic decisions, while our elected Board of Directors provides continuous oversight. This governance model balances democratic participation with the agility needed for competitive markets.</p>\n\t\t\t\t\t\t</div>\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
