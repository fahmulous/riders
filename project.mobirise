                  }
                },
                ".item-img": {
                  "display": "flex",
                  "justify-content": "flex-end",
                  "img": {
                    "width": "250px",
                    "height": "250px",
                    "object-fit": "cover",
                    "border-radius": "100% 0 0 0 !important"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center",
              "letter-spacing": "1px"
            },
            ".card-title": {
              "color": "#000305",
