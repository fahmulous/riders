        {
          "_name": "pricing4",
          "_sourceTheme": "tutorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tutorm5 pricing4\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n\t'mbr-fullscreen': fullScreen,\n\t'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Cards\" name=\"showCards\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"rowColor\" value=\"#17416e\" selected>\n\t\t<input type=\"color\" title=\"Border Color\" name=\"border\" value=\"#ffffff\" selected>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/tutorm5/components/_images/background1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=22jbKCeQ5HA\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\">\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/tutorm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center align-items-center\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t<div class=\"col-12 col-lg-12 mb-5 col-md-12\">\n\t\t\t\t\t\t\t<div class=\"text-wrapper align-left\">\n\t\t\t\t\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Quality standards &amp; production process</h2>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">RIDERS&nbsp; maintains rigorous quality control throughout our production process. Every product undergoes multiple inspections to ensure it meets our exacting standards before reaching our customers.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"row\" mbr-if=\"showCards\">\n\t\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t\t<div class=\"row my-auto\">\n\t\t\t\t\t\t\t\t<div class=\"col-lg-12 my-auto\">\n\t\t\t\t\t\t\t\t\t<h2 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\">Quality &amp; testing<br><br></h2>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<ul mbr-text class=\"mbr-list mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-list\">We apply multiple in-house quality checks across production: tensile and abrasion testing, dimensional stability, colorfastness trials and performance tests for technical fabrics. Our production follows strict QC points from raw cotton intake through spinning, weaving and final inspection, ensuring consistent grey fabric and yarn output.</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t\t<div class=\"row my-auto\">\n\t\t\t\t\t\t\t\t<div class=\"col-lg-12 my-auto\">\n\t\t\t\t\t\t\t\t\t<h2 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\">Pro<br><br></h2>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<ul mbr-text class=\"mbr-list mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-list\">\n\t\t\t\t\t\t\t\t<li><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Raw material inspection and ginning (20 t/day lint capacity).</span></li><li><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Spinning (open-end &amp; ring) with Trützschler and Rieter equipment.</span></li><li><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Weaving on Sulzer looms; finishing planned as part of wet-processing expansion.</span></li><li><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Recycling unit for cotton waste (Balkan/Temsan).</span></li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "li": {
              "padding-bottom": "0.5rem"
            },
            ".line": {
              "width": "100%",
              "height": "2px",
              "background": "@border",
              "margin-bottom": "1rem"
            },
            ".col-lg-3": {
              "border-top": "2px solid @border",
              "padding-top": "1rem"
            },
            ".mbr-text": {
              "line-height": "1.2",
              "color": "#000000"
            },
            ".card-wrapper": {
              "overflow": "hidden",
              "background": "@rowColor",
              "padding": "4rem 3rem",
              "@media (max-width: 767px)": {
                "padding": "2rem 1rem"
              }
            },
            ".image-wrapper": {
              "padding": "0 1rem"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center",
              "letter-spacing": "1px"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-card-title": {
              "color": "#ffffff"
            },
            ".mbr-card-title2": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-list": {
              "color": "#ffffff",
              "text-align": "left"
            }
          },
          "_cid": "uVVJiG6Qwh",
          "_anchor": "pricing4-3y",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "list03",
          "_sourceTheme": "authorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list03 authorm5\" group=\"List\" mbr-class=\"{'mbr-fullscreen': fullScreen,'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Marker\" name=\"showMarker\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"List Marker Color\" value=\"#171827\" name=\"marker\" condition=\"showList\">\n        <input type=\"color\" title=\"List Marker BG\" value=\"#f2ac2b\" name=\"markerBg\" condition=\"showList\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/image11-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/authorm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232b45\" condition=\"overlay && bg.type !== 'color'\" checked>\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Product development</h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"subtitle-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Product development &amp; prototyping</h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"lists-wrapper\">\n                    <ol class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><b>Consultation — requirements, target specs and end-use.</b></li>\n                        <li class=\"item-wrap\"><b style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Design &amp; prototyping — samples and lab trials (yarn → greige fabric → sample finishing).</b></li><li class=\"item-wrap\"><b style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Testing &amp; refinement — physical tests, color fastness and performance validation.</b></li><li class=\"item-wrap\"><b style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Pilot production — pilot run to confirm process and QA.</b></li><li class=\"item-wrap\"><b style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Scale production — full production scheduling, packaging and logistics.</b></li>\n                    </ol>\n                </div>\n            </div>\n        </div>\n    </div> <br><br><br>\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"subtitle-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Why Choose Our Custom Solutions</h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"lists-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">Vertically integrated supply chain: cotton ginning → spinning → weaving, enabling traceability and cost efficiency.</li><li class=\"item-wrap\">Large production capacity and experienced workforce (900+ staff, large daily yarn/fabric capacity).</li><li class=\"item-wrap\">Built-in recycling and sustainability initiatives.</li><li class=\"item-wrap\">In-house technical teams able to support prototyping and partner with clients for product development.&nbsp;</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 15px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 15px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "50px",
                "letter-spacing": "1px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              }
            },
            ".subtitle-wrapper": {
              "padding-right": "28px",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "28px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              }
            },
            ".lists-wrapper": {
              ".list": {
                "margin-bottom": "0",
                "list-style-type": "none",
                "padding-left": "0",
                "& when (@showMarker)": {
                  "padding-left": "50px",
                  "@media (max-width: 992px)": {
                    "padding-left": "36px"
                  }
                },
                ".item-wrap": {
                  "margin-bottom": "20px",
                  "position": "relative",
                  "&:last-child": {
                    "margin-bottom": "0"
                  },
                  "& when (@showMarker)": {
                    "&::before": {
                      "content": "'✓'",
                      "position": "absolute",
                      "top": "5px",
                      "margin-left": "-50px",
                      "width": "22px",
                      "height": "22px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "border-radius": "50%",
                      "background-color": "@markerBg",
                      "color": "@marker",
                      "font-size": "16px",
                      "@media (max-width: 992px)": {
                        "margin-left": "-36px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#171827",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#171827",
              "text-align": "left"
            },
            ".list": {
              "color": "#ffffff"
            },
            "P": {
              "color": "#171827",
              "text-align": "center"
            },
            ".list, .item-wrap": {
              "color": "#171827"
            }
          },
