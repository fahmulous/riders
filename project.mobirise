          "_name": "header01",
          "_sourceTheme": "devm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"7\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header condition=\"showsubTitle\">Color</header>\n        <input type=\"color\" title=\"Subtitle Line\" name=\"subline\" value=\"#d4ceff\" selected condition=\"showsubTitle\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/devm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/devm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-12 col-md-12 col-lg\">\n                <div class=\"text-wrapper align-left md-pb\">\n                    <div class=\"subtitle-wrap\">\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrap\" mbr-theme-style=\"display-7\" mbr-if=\"showsubTitle\">BUILDING FOR GROWTH</h2>\n                    </div>\n\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Strategic Real Estate Development</h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Riders Real Estate &amp; Construction represents our investment in Ethiopia's rapidly growing property and infrastructure sectors. As part of our diversified portfolio, we develop commercial, residential, and industrial properties that meet the needs of Ethiopia's expanding economy.<br><br>With a focus on quality construction, sustainable design, and strategic location selection, we're creating value for shareholders while contributing to Ethiopia's urban development. Our projects range from commercial office spaces and residential developments to industrial facilities supporting our textile and agricultural operations.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get Started</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}} image-wrapper\">\n                <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/heal-realestate-16-photo.jpg\" alt=\"Mobirise Website Builder\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0yH6Ycs1a",
          "_anchor": "header01-b7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0",
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "550px",
              "max-width": "550px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "&:nth-child(2n)": {
                "min-width": "440px",
                "max-width": "440px",
                "@media (max-width: 767px)": {
                  "min-width": "100%",
                  "max-width": "100%"
                },
                ".slide-content": {
                  ".item-wrapper": {
                    ".item-img": {
                      "img": {
                        "height": "570px",
                        "@media (max-width: 992px)": {
                          "height": "400px"
                        }
                      }
                    }
                  }
                }
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "height": "100%",
                  "align-items": "center",
                  ".item-img": {
                    "width": "100%",
                    "img": {
                      "height": "380px",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "300px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "56px",
              "height": "56px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "100%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": ".6 !important"
              },
              "&.embla__button--prev": {
                "right": "4rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "6rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "placem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"2\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#F2EDE4\" name=\"arrowsColor\" condition=\"arrows\" selected=\"\">\n        <input type=\"color\" title=\"Arrows Bg\" value=\"#1e1d1c\" name=\"arrowsBg\" condition=\"arrows\" selected=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"50\" step=\"10\" value=\"10\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/placem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e3e3e3\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/t-1-photo.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/heal-realestate-19-photo.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/heal-realestate-13-photo.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/heal-realestate-17-photo.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v1G1GwKPby",
          "_anchor": "slider01-fd",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features5",
          "_sourceTheme": "parkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Cards</header>\n        <select title=\"Amount\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Image Color\" name=\"image\" value=\"#FFFFFF\" selected>\n        <input type=\"color\" title=\"Icon Color\" name=\"icon\" value=\"#bfd42a\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#F9F9FC\" selected>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/parkm5/components/_images/background1.jpg\" parallax>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-12\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\"><b>OUR PORTFOLIO</b></h3>\n                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Development Focus Areas</h2>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\"mbr-iconfont icon54-v2-office-building\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"><b>&nbsp;Commercial Real Estate</b></h4>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Modern office complexes</li><li class=\"item-wrap\">Retail and shopping centers</li><li class=\"item-wrap\">Mixed-use developments</li><li class=\"item-wrap\">Strategic urban locations</li><li class=\"item-wrap\">Premium finishes and amenities</li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 1\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\"mbr-iconfont icon54-v2-house-8\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"><b>Residential Development</b></h4>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Apartment complexes</li><li class=\"item-wrap\">Condominium developments</li><li class=\"item-wrap\">Affordable housing projects</li><li class=\"item-wrap\">Modern residential communities</li><li class=\"item-wrap\">Family-focused amenities</li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 2\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont icon54-v1-factory-2\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"><b>Industrial Properties</b></h4>\n                                                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Factory buildings</li><li class=\"item-wrap\">Warehouse complexes</li><li class=\"item-wrap\">Industrial park development</li><li class=\"item-wrap\">Logistics and distribution centers</li><li class=\"item-wrap\">Supporting infrastructure</li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 3\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont fa-road fa\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\"mbr-card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"><b>Infrastructure</b> <b>Projects</b></h4>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Road and transportation infrastructure</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Utility and service installations</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Public-private partnerships</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Community development projects</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Urban renewal initiatives</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 4\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont mobi-mbri-github mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\"mbr-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Take Pets</b></h4>\n                                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 5\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\"mbr-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Come from Everywhere</b></h4>\n                                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 6\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont mobi-mbri-globe-2 mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\"mbr-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Talk to Everyone</b></h4>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6\" mbr-if=\"cards > 7\">\n                <div class=\"content-card\">\n                    <div class=\"content-card-icon\">\n                        <span mbr-icon class=\".mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-card-text\">\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\"mbr-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Find Friends</b></h4>\n                                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".row": {
              "justify-content": "center"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "27px",
              "letter-spacing": ".13em",
              "color": "#309f5e",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "margin-bottom": "0",
              "color": "#080808",
              "text-align": "center"
            },
            ".content-card": {
              "margin-top": "40px",
              ".content-card-icon": {
                "width": "76px",
                "height": "76px",
                "display": "flex",
