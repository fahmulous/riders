            },
            ".item-wrapper img": {
              "display": "block",
              "border-radius": "0 !important",
              "-webkit-border-radius": "0 !important"
            },
            "@media (max-width: 767px)": {
              ".container .carousel-control": {
                "margin-bottom": "0"
              },
              ".content-slider-wrap": {
                "width": "100% !important"
              },
              ".carousel-control": {
                "top": "60% !important",
