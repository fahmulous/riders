          "_name": "article02",
          "_sourceTheme": "pizzam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Text</header>\n        <input type=\"color\" title=\"Colored\" value=\"#a68462\" name=\"coloredTextColor\">\n        <header>Column</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"colTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/pizzam5/components/_images/image8.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#414142\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"px-0 px-sm-3\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div mbr-if=\"showTitle\" class=\"row mx-0 mx-sm-5 mb-1\">\n            <div class=\"col-12 mb-5 px-sm-3\">\n                <h3 class=\"mbr-section-title main-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title.main-title\" data-app-placeholder=\"Type Text\">ACCOUNTABILITY</h3>\n            </div>\n        </div>\n        <div class=\"row mx-0 mx-sm-5\">\n            <div class=\"col-12 col-sm px-sm-3\">\n                <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\"><b>\n                    Fast delivery\n                </b></h5>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Annual audited financial statements</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">&nbsp;Regular shareholder reports and updates</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">General Assembly financial presentations</span></li><li class=\"item-wrap\">Third-party audit and verification</li><li class=\"item-wrap\">Accessible document repository</li>\n                            </ul>\n            </div>\n            <div class=\"col-1 d-none d-sm-block\"></div>\n            <div class=\"col-12 col-sm px-sm-3\">\n                <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\"><b>\n                    Pickup in store\n                </b></h5>\n                                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Sector performance dashboards</span></li><li class=\"item-wrap\">Production and revenue metrics</li><li class=\"item-wrap\">Employment and social impact data</li><li class=\"item-wrap\">Environmental compliance reports</li><li class=\"item-wrap\">Strategic plan progress tracking</li>\n                            </ul>\n            </div> \n        </div>\n    </div>\n</section>",
          "_cid": "v0saSVtrhC",
          "_anchor": "article02-99",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content5",
          "_sourceTheme": "visualm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5 visualm5\" group=\"Content\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\">\n        <input type=\"color\" title=\"Card BG\" value=\"#f4f4f6\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/visualm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/visualm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">OUR FUTURE</h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"card-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <p class=\"mbr-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".mbr-number\">\n                        01\n                    </p>\n                    <div class=\"content-wrap\">\n                        <h3 class=\"mbr-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title\"><b>The Next Chapter</b></h3>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">As we enter our fifth year of operations, Riders Trading and Manufacturing S.C. stands at an inflection point. Our foundation is solid, our portfolio is balanced, and our shareholder community is growing. The 5-year strategic plan currently under development will guide our evolution from emerging holding company to established investment leader.\"<br><br>\"We see opportunities to deepen our presence in existing sectors—expanding textile exports, bringing Gewane to full production, scaling our real estate portfolio, and strengthening financial services partnerships. We also remain alert to adjacent opportunities that align with our core competencies and Ethiopia's development priorities.\"<br><br>\"Whatever the future holds, our commitment remains unchanged: creating sustainable shareholder value while contributing to Ethiopia's economic transformation. We invite you to join us on this journey.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 50px",
                "@media (max-width: 992px)": {
                  "padding": "0 30px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              }
            },
            ".card-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "padding": "70px 70px 70px 230px",
              "background-color": "@card",
              "border-radius": "16em 3em",
              "margin-bottom": "2em",
              "& when not (@reverseContent)": {
                "padding": "70px 230px 70px 70px",
                "border-radius": "3em 16em",
                "@media (max-width: 992px)": {
                  "border-radius": "0 3em 0 3em",
                  "padding": "30px 20px"
                }
              },
              "@media (max-width: 992px)": {
                "border-radius": "3em 0 3em 0",
                "padding": "30px 20px",
                "display": "block"
              },
              ".mbr-number": {
                "margin": "0 0 0 50px",
                "width": "20%",
                "white-space": "nowrap",
                "& when not (@reverseContent)": {
                  "margin": "0 50px 0 0",
                  "@media (max-width: 992px)": {
                    "margin": "0 0 16px 0"
                  }
                },
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin": "0 0 16px 0"
                }
              },
              ".content-wrap": {
                "width": "80%",
                ".mbr-card-title": {
                  "margin-bottom": "30px",
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-card-title": {
              "color": "#2b2b2b"
            },
            ".mbr-text": {
              "color": "#141414",
              "text-align": "left"
            },
            ".mbr-number": {
              "color": "#FE5115"
            }
          },
