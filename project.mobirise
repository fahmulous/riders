          "_name": "slider02",
          "_sourceTheme": "forwardm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla forwardm5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" value=\"#0f1d07\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows BG\" value=\"#90f188\" name=\"arrowsBg\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"36\" step=\"6\" value=\"12\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\">\n        <input type=\"color\" title=\"Title BG 1\" value=\"#7D41D1\" name=\"title_1\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 2\" value=\"#4FD741\" name=\"title_2\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 3\" value=\"#3799EA\" name=\"title_3\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 4\" value=\"#000000\" name=\"title_4\" condition=\"showCardTitle\" selected>\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Card Buttons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/background1-3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f8f8\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">4th General Assembly</h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0117-copy.jpg\" alt=\"Mobirise Website Builder\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Symposium\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                04.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Digital Mastery Symposium:\n                                                <span>Hosted annually by our digital marketing agency, the Digital Mastery\n                                                Symposium brings together industry leaders.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/hb9a9921.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Gala\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                12.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Client Success Gala:\n                                                <span>Celebrating the achievements of our clients is at the heart of our\n                                                values.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0132-copy.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Gala\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                12.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Client Success Gala:\n                                                <span>Celebrating the achievements of our clients is at the heart of our\n                                                values.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0095.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Series\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                08.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Elevate Workshop Series:\n                                                <span>As part of our commitment to continuous learning, we organize a series\n                                                of hands-on workshops throughout the year.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0107.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Expo\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                18.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Digital Trends Expo:\n                                               <span> The Digital Trends Expo is a dynamic showcase of the latest tools,\n                                                technologies, and innovations.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0172.jpg\" alt=\"Mobirise Website Builder\" data-bs-slide-to=\"5\" data-slide-to=\"5\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Impact Day\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                26.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Community Impact Day:\n                                                <span>Beyond business, our agency is dedicated to making a positive\n                                                    impact on the community.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/2v2a0220.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Impact Day\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                26.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Community Impact Day:\n                                                <span>Beyond business, our agency is dedicated to making a positive\n                                                    impact on the community.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@SITES@/2098721/assets/images/hb9a0329.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Ceremony\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                30.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Mavericks Awards Ceremony:\n                                                <span>The Digital Mavericks Awards recognize and celebrate individuals who\n                                                have made a significant impact.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "slider02-fr",
          "_cid": "vbnBI2EBIN",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "gallery02",
          "_sourceTheme": "rangem5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 25px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 25px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".mbr-section-title": {
              "letter-spacing": "1px"
            },
            ".item": {
              "margin-bottom": "32px",
              ".item-wrapper": {
                "transition": "all 0.3s ease-in-out",
                "background-color": "#000000",
                "&:hover, &:focus": {
                  "box-shadow": "2px 2px 0 0 @borderColor"
                },
                "overflow": "hidden",
                "a": {
                  "display": "block",
                  "&:hover, &:focus": {
                    ".item-img": {
                      "&::after": {
                        "opacity": "0"
                      }
                    }
                  },
                  ".item-img": {
                    "position": "relative",
                    "img": {
                      "background-color": "@borderColor",
                      "padding": "4px",
                      "height": "310px",
                      "object-fit": "cover",
                      "transition": "all 0.3s ease-in-out"
                    },
                    "& when (@overlayCard)": {
                      "&::after": {
                        "content": "\"\"",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "background-color": "@card",
                        "opacity": "0.4",
                        "transition": "all 0.3s ease-in-out",
                        "pointer-events": "none"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title, .icon-wrap": {
              "color": "#141414"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery02\" group=\"Gallery & Slider\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\" selected>4</option>\n            <option value=\"2\">6</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Card</header>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"borderColor\" selected>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlayCard\">\n        <input type=\"color\" title=\"Overlay Color\" value=\"#000c3f\" name=\"card\" selected condition=\"overlayCard\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/background1-5.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#f2fdff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@SITES@/2098721/assets/images/background1-5.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10 mb-4\">\n                <div class=\"title-wrapper text-center\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .icon-wrap\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Shareholders' Textile Industry Visits</h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-m-6 col-lg-{{cardsWidth}} item features-image\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\">\n                        <div class=\"item-img\">\n                            <img src=\"@SITES@/2098721/assets/images/photo-3-2025-09-06-02-21-32-1144x762.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12 col-m-6 col-lg-{{cardsWidth}} item features-image\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\">\n                        <div class=\"item-img\">\n                            <img src=\"@SITES@/2098721/assets/images/photo-1-2025-09-06-02-21-32-1144x762.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12 col-m-6 col-lg-{{cardsWidth}} item features-image\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\">\n                        <div class=\"item-img\">\n                            <img src=\"@SITES@/2098721/assets/images/photo-2-2025-09-06-02-21-32-1144x762.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12 col-m-6 col-lg-{{cardsWidth}} item features-image\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\">\n                        <div class=\"item-img\">\n                            <img src=\"@SITES@/2098721/assets/images/photo-4-2025-09-06-02-21-32-1144x762.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            \n            \n            \n            \n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "gallery02-ck",
          "_cid": "v0Cul4SBt3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "&::before": {
              "content": "''",
              "position": "absolute",
              "bottom": "0",
              "width": "200vh",
              "height": "85%",
              "background-image": "linear-gradient(transparent, @shadow 50%)",
              "z-index": "1"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".logo-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start",
              "gap": "0",
              "margin-bottom": "0",
              "padding-top": "0",
              "max-width": "100%",
              "a": {
                "display": "block",
                "line-height": "0",
                "margin": "0",
                "padding": "0"
              },
              "a:first-child": {
                "margin-bottom": "0"
              },
              ".footer-logo-img": {
                "width": "250px !important",
                "height": "auto !important",
                "max-height": "120px !important",
                "object-fit": "contain",
                "border-radius": "8px !important",
                "display": "block"
              },
              ".tagline-footer-img": {
                "width": "auto !important",
                "height": "30px !important",
                "border-radius": "0 !important",
                "object-fit": "contain",
                "image-rendering": "crisp-edges",
                "display": "block",
                "margin-top": "8px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                ".footer-logo-img": {
                  "width": "220px !important",
                  "max-height": "100px !important"
                },
                ".tagline-footer-img": {
                  "height": "25px !important",
                  "margin-top": "6px"
                }
              },
              "@media (max-width: 576px)": {
                ".footer-logo-img": {
                  "width": "200px !important",
                  "max-height": "90px !important"
                },
                ".tagline-footer-img": {
                  "height": "22px !important"
                }
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".row-main": {
              "position": "relative",
              "align-items": "flex-start",
              "justify-content": "center",
              "& when (@showBorder)": {
                "padding": "20px 0",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                }
              },
              ".card": {
                "justify-content": "center",
                "padding-top": "0 !important"
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "10px",
                "letter-spacing": "1px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".nav-wrapper": {
              "text-align": "center",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                "text-align": "left"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px",
                "text-align": "center",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".list": {
                "padding": "0",
                "margin": "0",
                "list-style-type": "none",
                "display": "inline-block",
                "text-align": "left",
                ".item-wrap": {
                  "margin-bottom": "5px",
                  "cursor": "pointer",
                  "position": "relative",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:hover": {
                    "color": "@active",
                    "&::before": {
                      "width": "100%"
                    }
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "height": "1px",
                    "width": "0",
                    "background-color": "@active",
                    "transition": "all 0.3s ease-in-out"
                  }
                }
              }
            },
            ".contacts-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".contacts-wrap": {
                ".item-contact": {
                  "margin-bottom": "15px",
                  ".item-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    ".mbr-iconfont": {
                      "font-size": "30px",
                      "color": "@icon",
                      "display": "inline-flex",
                      "margin-right": "20px"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-contact": {
                          "color": "@active",
                          "&::before": {
                            "width": "100%"
                          }
                        }
                      },
                      ".mbr-contact": {
                        "margin-bottom": "0",
                        "position": "relative",
                        "transition": "all 0.3s ease-in-out",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "height": "1px",
                          "width": "0",
                          "background-color": "@active",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".mbr-desc": {
                "margin-bottom": "5px"
              },
              ".social-wrapper": {
                "margin-top": "10px",
                ".social-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "@media (max-width: 992px)": {
                      "margin-left": "16px",
                      "&:first-child": {
                        "margin-left": "0"
                      }
                    },
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "36px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "padding": "25px 0",
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#1e4381"
            },
            ".mbr-text": {
              "color": "#141414"
            },
            ".mbr-section-subtitle": {
              "color": "#141414"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".mbr-contact": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "color": "#141414",
              "text-align": "left"
            },
            ".mbr-contact, .item-contact": {
              "color": "#141414"
            },
            ".mbr-desc, .mbr-section-btn": {
              "color": "#141414"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 essencem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"cont\" min=\"0\" max=\"3\" step=\"1\" value=\"3\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showContacts\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showContacts\" selected>\n        <input type=\"checkbox\" title=\"Desc\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#141414\" name=\"active\" condition=\"showNav || showContacts || showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#b0b0b0\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#f2fdff\" name=\"shadow\" selected>\n        <input type=\"checkbox\" title=\"Copy\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://r.mobirisesite.com/2098721/assets/images/background12.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://r.mobirisesite.com/2098721/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <!-- Logo and Tagline Section - UPDATED -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showTitle || showText\">\n                <div class=\"logo-wrapper\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/469598294-595183719735444-159510259647027175-n-790x288.png\" alt=\"RIDERS Trading & Manufacturing S.C\" class=\"footer-logo-img\">\n                    </a>\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-10-25-at-23.01.20-1.png\" alt=\"Beyond Investment\" class=\"tagline-footer-img\">\n                    </a>\n                </div>\n            </div>\n            \n            <!-- Menu Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Menu</b><b><br></b>\n                    </h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">Home</li>\n                        <li class=\"item-wrap\"><font color=\"#141414\"><a href=\"about.html\" class=\"text-black text-primary\">About</a></font></li>\n                        <li class=\"item-wrap\"><a href=\"textile-industry.html\" class=\"text-black\">Sectors</a></li>\n                        <li class=\"item-wrap\"><a href=\"documents.html\" class=\"text-black\">Documents</a></li>\n                    </ul>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"news.html\" class=\"text-black\">News</a><br></li>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"jobs.html\" class=\"text-black\">Jobs</a></li>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"gallery.html\" class=\"text-black\">Gallery</a></li>\n                        <li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"contact.html\" class=\"text-black text-primary\">Contact</a></li>\n                    </ul>\n                </div>\n            </div>\n            \n            <!-- Contacts Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showContacts\">\n                <div class=\"contacts-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Contacts</b>\n                    </h3>\n                    <div class=\"contacts-wrap\">\n                        <div class=\"item-contact\">\n                            <div class=\"item-wrap\">\n                                <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(20, 20, 20); fill: rgb(20, 20, 20);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-black\" target=\"_blank\">Sarbet JFK Apartments,</a>\n                                    <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-black\" target=\"_blank\">Addis Ababa</a>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 1\">\n                            <div class=\"item-wrap\">\n                                <a href=\"tel:+251-911-072513\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"tel:+251-911-072513\" class=\"text-black\">+251-911-072513</a>\n                                    <a href=\"tel:+251-911-072513\" class=\"text-black\">+251-944-334484</a><a href=\"tel:+251-911-072513\" class=\"text-black\">+251-960-551010</a>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 2\">\n                            <div class=\"item-wrap\">\n                                <a href=\"mailto:info@ridersgroupsc.com\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"mailto:info@ridersgroupsc.com\" class=\"text-black\">info@ridersgroupsc.com</a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Social Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showSubtitle || showDesc || showButtons || showSocial\">\n                <div class=\"desc-wrapper\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://web.facebook.com/profile.php?id=100077837321146\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"color: rgb(24, 119, 242); fill: rgb(24, 119, 242);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://www.youtube.com/@ridersbusinessgroupsc3225\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"color: rgb(238, 41, 71); fill: rgb(238, 41, 71);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-telegram socicon\" style=\"color: rgb(10, 102, 194); fill: rgb(10, 102, 194);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://www.instagram.com/riderssc_2024?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(250, 18, 96); fill: rgb(250, 18, 96);\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Copyright -->\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\">\n                    © Copyright 2025 RIDERS Trading &amp; Manufacturing S.C - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
