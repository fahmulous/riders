              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-section-subtitle": {
              "width": "fit-content",
              "position": "relative",
              "display": "inline-block",
              "z-index": "2",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "left": "0",
                "bottom": "10%",
                "width": "100%",
                "height": "12px",
                "background": "@subline",
