          "_name": "features03",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 essencem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#f4f4f6\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 item\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Bringing the products to market</b></h2>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            <b>SPINNING</b>\n                        </h4>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Spinning industry produces raw white yarnfrom high quality Cotton<br>and faiber intoweaving or knitting yarn.<br>Our spinningtechniques include both openend and ringframe methods,<br>producing highquality yarn made from100% cotton in various specifications.<br>Featured with RIETER and Zinnser spinning machines to produce<br>a diverse range of yarn types.<br><br></p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Open-End Yarn</b></h4>\n                          <ol class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-\n                        wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-12/1 Open End Carded 100% CO</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-16/1 Open End Carded 100% CO</span></li>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-21/1 Open End Carded 100% CO</span></li>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-22/1 Open End Carded 100% CO</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-34/1 Open End Semi-Combed 100% CO</span></li>\n                        </ol>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Ring-Frame Yarn</b></h4>\n                         <ol class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-\n                        wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-21/1 Ring Frame Carded 100% CO</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-22/1 Ring Frame Carded 100% CO</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-40/1 Ring Frame Carded 100% CO</span></li>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-30/1 Ring Frame Semi-Combed 100% CO</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">NE-40/1 Ring Frame Semi-Combed 100% CO</span></li>\n                        </ol>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-12-at-09.04.21-486x282.png\" alt=\"Mobirise\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            <b>WEAVING</b></h4>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                            At recycling facilities, materials are sorted to separate different types. This can be done\n                            manually or through automated processes such as conveyor belts, screens, and magnets.<br><br>\n                        </p>\n                          <ol class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-\n                        wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Abujedid 2/90 Leno</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Abujedid 2/150 (#2)</span></li>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">French Twill-EFL 12/153</span></li>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Twill 1/3-160</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Ring Melmel - 150</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Normal Melmel - 150</span></li>\n                        </ol>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-12-at-09.04.45-380x362.png\" alt=\"Mobirise\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            <b>KNITTING</b>\n                        </h4>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Our knitting facilities enable the production of diverse, high-quality fabrics suited for various apparel and functional applications.</p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-12-at-09.05.04-500x341.png\" alt=\"Mobirise\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>GINNING SERVICES</b></h4>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Our ginning facilities are equipped with cutting-edge SUMER BRAND machines, ensuring the efficient separation of cotton fibers from seeds. This critical process guarantees high-quality input materials for further processing. In addition to meeting our internal needs, we are renowned for providing exceptional ginning services to external<br>customers.</p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-12-at-09.05.32-500x281.png\" alt=\"Mobirise\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                    </div>\n                </div>\n            </div><div class=\"item features-image col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>COTTON</b><div><b>TRANSPORTATION</b></div><div><b>SERVICES</b></div></h4>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Our comprehensive transportation services guarantee the prompt and efficient delivery of cotton, facilitating seamless operations and sustained supply chains for both our factory and external customers availing ginning services.</p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-09-12-at-09.02.50-552x772.png\" alt=\"Mobirise\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uWtr9GXaZM",
