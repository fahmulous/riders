          "_name": "video01",
          "_sourceTheme": "recyclem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 recyclem5\" group=\"Image & Video\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Secondary Color\" value=\"#FFBE0D\" name=\"title\" condition=\"showTitle\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f2fdff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Riders in the Spotlight</h2>\n                </div>\n                <div mbr-video class=\"mbr-figure\">\n                    <iframe src=\"https://www.youtube.com/watch?v=8dYW3Y4oMZ4&t=531s&loop=1&autoplay=1\"></iframe>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "video01-5e",
          "_isUserblock": true,
          "_cid": "uVYwdBn4e9",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 50px",
                "@media (max-width: 1440px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "80px",
                "letter-spacing": "1px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "380px",
              "max-width": "380px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "&:nth-child(2n)": {
                ".slide-content .item-wrapper .item-img .title-wrap .item-title": {
                  "background-color": "@title_2"
                }
              },
              "&:nth-child(3n)": {
                ".slide-content .item-wrapper .item-img .title-wrap .item-title": {
                  "background-color": "@title_3"
                }
              },
              "&:nth-child(4n)": {
                ".slide-content .item-wrapper .item-img .title-wrap .item-title": {
                  "background-color": "@title_4"
                }
              },
              ".slide-content": {
                "width": "100%",
                "display": "flex",
                "height": "100%",
                "flex-direction": "column",
                "justify-content": "space-between",
                ".item-wrapper": {
                  ".item-img": {
                    "position": "relative",
                    "display": "flex",
                    "align-items": "flex-end",
                    "height": "490px",
                    "margin-bottom": "20px",
                    "padding": "20px",
                    "@media (max-width: 768px)": {
                      "height": "350px"
                    },
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover",
                      "border-radius": "20px !important"
                    },
                    "a": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%"
                    },
                    ".title-wrap": {
                      "position": "relative",
                      "z-index": "1",
                      "width": "100%",
                      ".item-title": {
                        "display": "inline-flex",
                        "padding": "14px 15px",
                        "margin-bottom": "0",
                        "border-radius": "100vw",
                        "background-color": "@title_1"
                      }
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-date": {
                      "margin-bottom": "20px",
                      "opacity": ".5"
                    },
                    ".item-text": {
                      "margin-bottom": "20px",
                      "span": {
                        "opacity": ".5"
                      }
                    }
                  }
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "opacity": ".5",
                    "&:hover, &:focus": {
                      "opacity": "1"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "70px",
              "height": "70px",
              "margin-top": "-1.5rem",
              "font-size": "32px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "background-color": "@arrowsBg !important"
              },
              "&.embla__button--prev": {
                "right": "4rem",
                "border-radius": "6.25rem 0 0 6.25rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "border-radius": "0 6.25rem 6.25rem 0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "6rem"
              }
            },
            ".embla__viewport": {
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#0f1d07",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-date": {
              "color": "#0f1d07"
            },
            ".item-text": {
              "color": "#0f1d07"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "forwardm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla forwardm5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" value=\"#0f1d07\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows BG\" value=\"#90f188\" name=\"arrowsBg\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"36\" step=\"6\" value=\"12\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\">\n        <input type=\"color\" title=\"Title BG 1\" value=\"#7D41D1\" name=\"title_1\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 2\" value=\"#4FD741\" name=\"title_2\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 3\" value=\"#3799EA\" name=\"title_3\" condition=\"showCardTitle\" selected>\n        <input type=\"color\" title=\"Title BG 4\" value=\"#000000\" name=\"title_4\" condition=\"showCardTitle\" selected>\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Card Buttons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f8f8\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Moments &amp; Milestones</h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-17-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Symposium\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                04.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Digital Mastery Symposium:\n                                                <span>Hosted annually by our digital marketing agency, the Digital Mastery\n                                                Symposium brings together industry leaders.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-5-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Series\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                08.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Elevate Workshop Series:\n                                                <span>As part of our commitment to continuous learning, we organize a series\n                                                of hands-on workshops throughout the year.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-3-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Gala\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                12.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Client Success Gala:\n                                                <span>Celebrating the achievements of our clients is at the heart of our\n                                                values.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-13-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"4\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Gala\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                12.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Client Success Gala:\n                                                <span>Celebrating the achievements of our clients is at the heart of our\n                                                values.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-2-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Expo\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                18.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Digital Trends Expo:\n                                               <span> The Digital Trends Expo is a dynamic showcase of the latest tools,\n                                                technologies, and innovations.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-18-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\" data-bs-slide-to=\"5\" data-slide-to=\"5\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Impact Day\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                26.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Community Impact Day:\n                                                <span>Beyond business, our agency is dedicated to making a positive\n                                                    impact on the community.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/photo-6-2025-09-06-02-15-5-1152x768.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                                            <div class=\"title-wrap\">\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .title-wrap\" mbr-if=\"showCardTitle\">\n                                                    Impact Day\n                                                </h4>\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\" mbr-if=\"showDate\">\n                                                26.09.2030\n                                            </p>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\" mbr-if=\"showText\">\n                                                Community Impact Day:\n                                                <span>Beyond business, our agency is dedicated to making a positive\n                                                    impact on the community.</span>\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                            Read More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/4m1a0002-1152x768.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"7\" data-bs-slide-to=\"7\