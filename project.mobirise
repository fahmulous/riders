    "textile-industry.html": {
      "settings": {
        "title": "Textile Industry | Riders-ELSE Manufacturing | Riders Trading & Manufacturing S.C.",
        "order": "5",
        "meta_descr": "Riders-ELSE Textile Industry: Operating 10,000+ spindles in Adama with 300+ employees. Producing 100% Ethiopian cotton yarn for domestic and export markets. Part of Riders Trading & Manufacturing S.C.",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->",
        "header_custom": "<!-- Structured Data - Textile Industry -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Textile Manufacturing Services\",\n  \"description\": \"Cotton yarn production with 10,000+ spindles in Adama, Ethiopia\",\n  \"manufacturer\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Riders-ELSE Textile Industry\"\n  },\n  \"category\": \"Textile Manufacturing\"\n}\n</script>\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
