              }
            },
            ".items-wrapper": {
              ".item": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                },
                ".item-wrapper": {
                  ".card-number_1, .card-number_2, .card-number_3, .card-number_4": {
                    "margin-bottom": "0"
                  },
                  ".card-box": {
                    "padding": "25px",
                    "height": "100%",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "min-height": "380px",
                    "@media (max-width: 992px)": {
                      "padding": "30px 15px",
                      "min-height": "auto"
                    },
                    ".title-wrapper": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "center",
                      "margin-bottom": "30px",
                      "@media (max-width: 1440px)": {
                        "flex-direction": "column-reverse",
                        "align-items": "flex-start"
                      },
                      ".card-title_1, .card-title_2, .card-title_3, .card-title_4": {
                        "margin-bottom": "0"
                      },
                      ".iconfont-wrapper": {
                        ".mbr-iconfont": {
                          "font-size": "36px",
                          "display": "inline-flex",
                          "margin-left": "20px",
                          "@media (max-width: 1440px)": {
                            "margin-left": "0",
                            "margin-bottom": "15px"
                          }
                        }
                      }
                    },
                    ".text-wrapper": {
                      ".card-text_1, .card-text_2, .card-text_3, .card-text_4": {
                        "margin-bottom": "0"
                      },
                      ".mbr-section-btn": {
                        "margin-top": "15px",
                        ".btn": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                },
                ".card_1": {
                  ".card-box": {
                    "background-color": "@cardBg_1",
                    ".title-wrapper .iconfont-wrapper .mbr-iconfont": {
                      "color": "@icon_1"
                    }
