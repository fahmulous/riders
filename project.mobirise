          "_name": "article04",
          "_sourceTheme": "legalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 legalm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"Marker Color\" value=\"#01004C\" name=\"marker\" condition=\"showList\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/legalm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/legalm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f1f1f1\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Our Vision, Mission &amp; Values</h2>\n                    <h3 class=\"mbr-list-title  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".mbr-list-title\"><b>VISION:</b></h3>\n                    <p class=\"mbr-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text_1\" mbr-if=\"showText_1\">To be a leading diversified holding company in Ethiopia, creating sustainable value for our shareholders while driving economic growth and social impact across strategic sectors.<br></p>\n                    <h3 class=\"mbr-list-title  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".mbr-list-title\"><b>MISSION:</b></h3>\n                    <p class=\"mbr-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text_1\" mbr-if=\"showText_1\">To be a leading diversified holding company in Ethiopia, creating sustainable value for our shareholders while driving economic growth and social impact across strategic sectors.<br></p>\n                    <div class=\"list-wrapper\" mbr-if=\"showList\">\n                        <h3 class=\"mbr-list-title  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".mbr-list-title\"><b>CORE VALUES:</b></h3>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Integrity: Upholding ethical practices in all operations</li>\n                            <li class=\"item-wrap\">Excellence: Pursuing quality and efficiency</li>\n                            <li class=\"item-wrap\">Innovation: Embracing modern technology and methods</li>\n                            <li class=\"item-wrap\">Sustainability: Environmental and social responsibility</li>\n                            <li class=\"item-wrap\">Collaboration: Teamwork and stakeholder partnership</li><li class=\"item-wrap\">Growth: Continuous learning and expansion</li>\n                        </ul>\n<a href=\"about.html\" class=\"btn btn-sm btn-primary-doc\">Learn More</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
