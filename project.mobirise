          },
          "_name": "features03",
          "_sourceTheme": "paintm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 paintm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <input type=\"color\" title=\"Image Border\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showCardButtons\" checked>\n        <input type=\"color\" title=\"Card BG 1\" value=\"#ffffff\" name=\"cardBg_1\" selected>\n        <input type=\"color\" title=\"Card BG 2\" value=\"#9cadd9\" name=\"cardBg_2\" selected>\n        <input type=\"color\" title=\"Card BG 3\" value=\"#faebc5\" name=\"cardBg_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/paintm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/paintm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Our Impact in Action</h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, text-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                            Here’s a list of workshop ideas for our kids:\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper card_1\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/dji-fly-20241121-120942-715-1732180240152-photo-optimized-560x315.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\">\n                        <div class=\"card-box\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .card-btn\" mbr-if=\"showCardTitle\">Sustainable Sourcing &amp; Vertical Integration</h4>\n                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                Our work begins at the source, partnering directly with Ethiopian cotton farmers to ensure a high-quality, traceable supply chain. This vertical integration allows us to maintain strict quality control from the raw material to the final product.<br><br>\n                            </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Direct support for local farmers</li>\n                                <li class=\"item-wrap\">Ethically sourced Ethiopian cotton</li>\n                                <li class=\"item-wrap\">Foundation of our end-to-end value chain</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper card_2\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-ytb56tytb56tytb5-560x560.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\">\n                        <div class=\"card-box\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .card-btn\" mbr-if=\"showCardTitle\">Circular Economy &amp; Waste Reduction</h4>\n                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                We are committed to environmental sustainability through our modern cotton recycling unit. This initiative allows us to transform textile waste into new, high-quality yarn, significantly reducing our environmental footprint.<br><br>\n                            </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Modern cotton recycling technology</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Reduction of textile waste</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Contribution to a circular economy</span></li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 item features-image\">\n                <div class=\"item-wrapper card_3\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/1d3a3197-1298x865.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\">\n                        <div class=\"card-box\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .card-btn\" mbr-if=\"showCardTitle\">Innovation in Textile Processing</h4>\n                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Our continuous expansion into wet processing (bleaching, dyeing, and printing) and garment manufacturing is designed to meet the evolving needs of both domestic and international markets. We are building a fully integrated apparel value chain.<br><br>\n                            </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Expansion into wet processing and dyeing</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Full-scale garment production</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem;\">Integrated end-to-end apparel solutions</span></li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                    <a href class=\"btn item-btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                        All Workshops\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uVW4Sdo3GX",
          "_anchor": "features03-42",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
