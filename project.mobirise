    "index.html": {
      "settings": {
        "main": true,
        "title": "Home | Riders Trading & Manufacturing S.C. - Ethiopia's Premier Diversified Holding Company",
        "meta_descr": "Riders Trading & Manufacturing S.C. is Ethiopia's leading shareholder-driven holding company with ETB 1B capital and 1,160+ shareholders. Investing in textile, agriculture, real estate, and financial services since 2021.",
        "header_custom": "<!-- Structured Data - Organization -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"Riders Trading and Manufacturing S.C.\",\n  \"alternateName\": \"Riders SC\",\n  \"url\": \"https://www.riderssc.com\",\n  \"logo\": \"https://www.riderssc.com/assets/images/469598294-595183719735444-159510259647027175-n-1-790x288.png\",\n  \"description\": \"Ethiopia's leading shareholder-driven diversified holding company with ETB 1B capital and 1,160+ shareholders\",\n  \"foundingDate\": \"2021\",\n  \"numberOfEmployees\": \"500+\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"addressLocality\": \"Addis Ababa\",\n    \"addressCountry\": \"ET\"\n  },\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"contactType\": \"Customer Service\",\n    \"telephone\": \"+251-XX-XXX-XXXX\",\n    \"email\": \"info@riderssc.com\"\n  }\n}\n</script>\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
