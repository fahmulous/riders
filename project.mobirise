                ".slide-content .item-wrapper .item-img .title-wrap .item-title": {
                  "background-color": "@title_4"
                }
              },
              ".slide-content": {
                "width": "100%",
                "display": "flex",
                "height": "100%",
                "flex-direction": "column",
                "justify-content": "space-between",
                ".item-wrapper": {
                  ".item-img": {
                    "position": "relative",
                    "display": "flex",
                    "align-items": "flex-end",
