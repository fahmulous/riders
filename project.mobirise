              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".item": {
              "position": "relative",
              "z-index": "1",
              "margin-bottom": "24px",
              ".item-wrapper": {
                "padding": "32px",
                "border-radius": ".75rem !important",
                "background-color": "@card",
                "height": "100%",
                "@media (max-width: 992px)": {
                  "padding": "24px"
                },
                ".card-box": {
