          "_name": "article02",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"Number Color\" value=\"#E0B548\" name=\"number\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/fabm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"subtitle-wrap\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><b>Our Mission &amp; Vision</b></h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8 card\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Guiding Principles</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">We are Ethiopia’s premier vertically integrated textile producer, delivering diverse, high-quality cotton products with consistency, sustainability, and innovation.<br></p>\n                    <div class=\"list\" mbr-if=\"showList\">\n                        <div class=\"item features-without-image item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"title-wrapper\">\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .card-box\">\n                                            <b>1</b>\n                                        </p>\n                                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .card-box\">\n                                            To deliver world-class textile products through full vertical integration — from cotton ginning to fabric — while upholding sustainability, employee satisfaction, social responsibility, and ethical business practices.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div><div class=\"item features-without-image item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"title-wrapper\">\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .card-box\"><b>2</b></p>\n                                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .card-box\">To become the nation’s leading producer of sustainable textile products at international standards, driving Ethiopia’s competitiveness in the global market.<br></p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"title-wrapper\">\n                                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number, .card-box\"><b>3</b></p>\n                                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .card-box\">To expand our capabilities responsibly, invest in innovation, and reduce our environmental footprint — ensuring long-term value for communities, customers, and shareholders.<br></p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"subtitle-wrap\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Quality is a Commitment</b>\n                    </h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8 card\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Our Core Principles</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Quality is the cornerstone of our operations. From raw cotton intake to final inspection, we maintain rigorous standards supported by modern testing and global best practices.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <br><b>Integrated Value Chain</b>&nbsp; &nbsp;<br><br>Unlike many manufacturers who operate in isolated segments, Riders controls every stage of the textile process — ginning, spinning, weaving, and recycling. This vertical integration ensures unmatched consistency and flexibility to meet diverse customer needs.&nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br><b>Sustainability &amp; Responsibility<br></b>We are committed to responsible growth, from investing in recycling and resource-efficient technology to exploring future expansions in environmentally friendly finishing and garmenting.<br><br><b>Collaboration &amp; Innovation</b><br>Our people are our strength. With 900+ skilled professionals, advanced machinery, and a culture of teamwork, we continuously innovate to stay competitive and create lasting impact.<br>\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary\" href=\"capabilities.html\" data-app-placeholder=\"Type Text\">OUR CAPABILITIEST<span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uUNmNMjKht",
          "_anchor": "article02-w",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "&::before": {
              "content": "''",
              "position": "absolute",
              "bottom": "0",
              "width": "200vh",
              "height": "85%",
              "background-image": "linear-gradient(transparent, @shadow 50%)",
              "z-index": "1"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".logo-wrapper": {
              "margin-right": "8px",
              "img": {
                "width": "100px",
                "height": "100px",
                "object-fit": "contain",
                "border-radius": "8px !important"
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".row-main": {
              "position": "relative",
              "align-items": "flex-start",
              "justify-content": "center",
              "& when (@showBorder)": {
                "padding": "40px 0",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                }
              },
              ".card": {
                "justify-content": "center"
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "10px",
                "letter-spacing": "1px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".nav-wrapper": {
              "text-align": "center",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                "text-align": "left"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px",
                "text-align": "center",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".list": {
                "padding": "0",
                "margin": "0",
                "list-style-type": "none",
                "display": "inline-block",
                "text-align": "left",
                ".item-wrap": {
                  "margin-bottom": "5px",
                  "cursor": "pointer",
                  "position": "relative",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:hover": {
                    "color": "@active",
                    "&::before": {
                      "width": "100%"
                    }
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "height": "1px",
                    "width": "0",
                    "background-color": "@active",
                    "transition": "all 0.3s ease-in-out"
                  }
                }
              }
            },
            ".contacts-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".contacts-wrap": {
                ".item-contact": {
                  "margin-bottom": "15px",
                  ".item-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    ".mbr-iconfont": {
                      "font-size": "30px",
                      "color": "@icon",
                      "display": "inline-flex",
                      "margin-right": "20px"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-contact": {
                          "color": "@active",
                          "&::before": {
                            "width": "100%"
                          }
                        }
                      },
                      ".mbr-contact": {
                        "margin-bottom": "0",
                        "position": "relative",
                        "transition": "all 0.3s ease-in-out",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "height": "1px",
                          "width": "0",
                          "background-color": "@active",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".mbr-desc": {
                "margin-bottom": "5px"
              },
              ".social-wrapper": {
                "margin-top": "10px",
                ".social-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "@media (max-width: 992px)": {
                      "margin-left": "16px",
                      "&:first-child": {
                        "margin-left": "0"
                      }
                    },
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "36px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "padding": "25px 0",
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#1e4381"
            },
            ".mbr-text": {
              "color": "#141414"
            },
            ".mbr-section-subtitle": {
              "color": "#1e4381"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".mbr-contact": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "color": "#141414",
              "text-align": "left"
            },
            ".mbr-contact, .item-contact": {
              "color": "#141414"
            },
            ".mbr-desc, .mbr-section-btn": {
              "color": "#141414"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 essencem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"cont\" min=\"0\" max=\"3\" step=\"1\" value=\"3\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showContacts\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showContacts\" selected>\n        <input type=\"checkbox\" title=\"Desc\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#00d0f3\" name=\"active\" condition=\"showNav || showContacts || showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#b0b0b0\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#f2fdff\" name=\"shadow\" selected>\n        <input type=\"checkbox\" title=\"Copy\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background12.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showTitle || showText\">\n                <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/469598294-595183719735444-159510259647027175-n-790x288.png\" alt=\"RIDERS Trading & Manufacturing S.C\">\n                    </a>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Menu</b><b><br></b>\n                    </h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem; background-color: transparent;\"><a href=\"index.html\" class=\"text-primary\">Home</a></span></li><li class=\"item-wrap\"><font color=\"#141414\"><a href=\"about.html\" class=\"text-primary\">About Us</a></font></li><a href=\"page9.html#features02-5b\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\"><a href=\"capabilities.html\" class=\"text-primary\">Capabilities</a></li>\n                        <li class=\"item-wrap\"><a href=\"products.html\" class=\"text-primary\">Products</a></li>\n                    </ul>\n                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"projects.html\" class=\"text-primary\" style=\"font-size: 1.25rem; letter-spacing: -0.03rem; background-color: transparent;\">Our Work</a><br></li><a href=\"projects.html#content4-1q\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"project.html\" class=\"text-primary\">Projects</a></li><a href=\"projects.html#content4-1q\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"leadership.html\" class=\"text-primary\">Leadership</a></li><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"contact.html\" class=\"text-primary\">Contact</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showContacts\">\n                <div class=\"contacts-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Contacts</b>\n                    </h3>\n                    <div class=\"contacts-wrap\">\n                        <div class=\"item-contact\">\n                            <div class=\"item-wrap\">\n                                <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(20, 20, 20); fill: rgb(20, 20, 20);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-primary\" target=\"_blank\">Sarbet JFK Apartments,</a><a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-primary\" target=\"_blank\">Addis Ababa</a></p>\n                                \n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 1\">\n                            <div class=\"item-wrap\">\n                                <a href=\"tel:+251-911-072513\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"tel:+251-911-072513\" class=\"text-primary\">+251-911-072513</a><a href=\"tel:+251-911-072513\" class=\"text-primary\">+251-944-334484</a></p>\n                                \n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 2\">\n                            <div class=\"item-wrap\">\n                                <a href=\"mailto:info@ridersgroupsc.com\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"mailto:info@ridersgroupsc.com\" class=\"text-primary\">info@ridersgroupsc.com</a></p>\n                                \n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showSubtitle || showDesc || showButtons || showSocial\">\n                <div class=\"desc-wrapper\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://web.facebook.com/profile.php?id=100077837321146\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"color: rgb(24, 119, 242); fill: rgb(24, 119, 242);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://www.youtube.com/@ridersbusinessgroupsc3225\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"color: rgb(238, 41, 71); fill: rgb(238, 41, 71);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-telegram socicon\" style=\"color: rgb(10, 102, 194); fill: rgb(10, 102, 194);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://www.instagram.com/riderssc_2024?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(250, 18, 96); fill: rgb(250, 18, 96);\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\">\n                    © Copyright 2025 RIDERS Trading &amp; Manufacturing S.C - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
