                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center",
                    "margin": "0 !important",
                    "margin-bottom": "4px !important"
                  }
                },
                "order": "4",
                "flex-basis": "100%",
                "margin-top": "15px"
