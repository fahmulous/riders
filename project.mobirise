                    "margin-bottom": "24px",
                    "opacity": ".4"
                  },
                  ".card-title": {
                    "margin-bottom": "24px"
                  },
                  ".card-text": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#141414",
              "text-align": "center"
            },
            ".card-number": {
              "color": "#141414"
            },
            ".card-title": {
              "color": "#141414"
            },
            ".card-text": {
              "color": "#141414"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#141414"
            }
          },
          "_name": "features04",
          "_sourceTheme": "operationm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 operationm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\">\n        <input type=\"color\" title=\"Decoration Color 1\" value=\"#bfd42a\" name=\"decor_1\" condition=\"showDecor\">\n        <input type=\"color\" title=\"Decoration Color 2\" value=\"#309f5e\" name=\"decor_2\" condition=\"showDecor\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#f4f4f6\" name=\"card\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/background1-6.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@SITES@/2098721/assets/images/background1-6.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Products and Services</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Investing in innovative industries by implementing ethical management systems.<br></p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5  item features-without-image item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                             📊\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">Cotton Ginning</h4>\n                                  <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">20 tons per day</span></li><li class=\"item-wrap\">Raw cotton processing and fiber separation from seeds. Our ginning operation supplies both our own spinning line and external customers, ensuring consistent quality cotton fiber.</li><li class=\"item-wrap\">Modern ginning machinery with cleaning and pressing units</li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 item features-without-image item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                            ⚙️\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">Spinning</h4>\n                                                       <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">High-volume yarn production</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Converting ginned cotton into various yarn counts for weaving and knitting applications. We produce ring-spun and rotor-spun yarns meeting international quality standards.</span></li><li class=\"item-wrap\"><span style=\"font-size: 18px; letter-spacing: -0.2px;\">Ring spinning frames, rotor spinning machines, winding units</span></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 item features-without-image item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                             🤝\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">Weaving</h4>\n                                 <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.25rem;\">35,000+ meters per day</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem;\">Our largest production line manufactures a wide range of woven fabrics including grey fabrics, dyed fabrics, and specialty textiles for apparel, home textiles, and industrial applications.</span><br></li><li class=\"item-wrap\">Rapier looms, air-jet looms, warping and sizing machines</li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 item features-without-image item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                             🌱\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">Recycling &amp; Waste</h4>\n                                 <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.25rem;\">Full waste-to-product conversion</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem;\">Environmental sustainability through textile waste recycling. We convert production waste into usable materials, reducing environmental impact while creating additional revenue streams</span><br></li><li class=\"item-wrap\"><span style=\"font-size: 1.25rem;\">Waste processing and recycling machinery</span><br></li>\n                            </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features04-fn",
          "_isUserblock": true,
          "_cid": "v2k8elyzi1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features4",
          "_sourceTheme": "supplym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4 supplym5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n        'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <header>Cards</header>\n        <select title=\"Amount\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Color 1\" value=\"#309f5e\" name=\"card_1\" selected>\n        <input type=\"color\" title=\"Color 2\" value=\"#bfd42a\" name=\"card_2\" selected>\n        <input type=\"color\" title=\"Color 3\" value=\"#01004c\" name=\"card_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/supplym5/components/_images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/supplym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Quality Standards &amp; Environmental Responsibility</h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                        Labore libero mollitia odio recusandae.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_1\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_1\"><b>Quality Assurance</b></h2>\n                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">ISO certification processes underway</li><li class=\"item-wrap\">In-house quality testing laboratory</li><li class=\"item-wrap\">Strict quality control at every production stage</li><li class=\"item-wrap\">Customer satisfaction guarantee</li><li class=\"item-wrap\">International textile standards compliance</li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_2\" mbr-if=\"cards > 1\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_2\"><b>Sustainable Practices</b></h2>\n                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Water recycling and treatment systems</li><li class=\"item-wrap\">Energy-efficient machinery</li><li class=\"item-wrap\">Waste reduction and recycling programs</li><li class=\"item-wrap\">Cotton sourcing from own farms (Amibara)</li><li class=\"item-wrap\">Environmental compliance and monitoring</li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_3\" mbr-if=\"cards > 2\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_3 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_3\"><b>Worker Safety &amp; Development</b></h2>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Safe working environment and PPE</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Regular training and skill development</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Competitive wages and benefits</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Career advancement opportunities</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Health and safety compliance</span></li>\n                            </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_1\" mbr-if=\"cards > 3\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_1\">\n                        <b>Sint sit tempora nihil pariatur quaerat</b>\n                    </h2>\n                    <p class=\"mbr-text_1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text_1, .mbr-iconfont\">\n                        Dolore ipsam laboriosam libero nihil pariatur quaerat tempore. Aliquid animi asperiores aut,\n                        consequuntur, distinctio dolor\n                        esse ex excepturi expedita inventore itaque laborum molestias nihil possimus quo sequi ullam\n                        veritatis voluptatem.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_2\" mbr-if=\"cards > 4\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_2\">\n                        <b>Optio possimus rerum similique, temporibus</b>\n                    </h2>\n                    <p class=\"mbr-text_2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text_2, .mbr-iconfont\">\n                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aliquid aspernatur ea ipsa iure\n                        nemo nihil odio repudiandae voluptate. A aspernatur, eveniet harum id ipsum officia\n                        perspiciatis possimus sed sint sit.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card card_3\" mbr-if=\"cards > 5\">\n                <div class=\"card-wrapper\">\n                    <h2 class=\"mbr-card-title_3 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-card-title_3\">\n                        <b>Possimus quam suscipit tempore voluptate</b>\n                    </h2>\n                    <p class=\"mbr-text_3 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text_3, .mbr-iconfont\">\n                        Amet consectetur adipisicing elit. Ab aliquam animi debitis\n                        distinctio, doloremque, est facilis illo obcaecati officiis quia quo rerum, tempora\n                        voluptate. Aliquid dolore nobis obcaecati quisquam voluptate.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "margin-bottom": "30px",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px"
              },
              ".mbr-desc": {
                "margin": "0"
              }
            },
            ".card": {
              "margin-bottom": "32px",
              "@media (min-width: 992px)": {
                "padding-left": "22px",
                "padding-right": "22px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "24px"
              },
              ".card-wrapper": {
                "padding": "32px 45px",
                "border-radius": "40px",
                "@media (max-width: 992px)": {
                  "padding": "32px"
                },
                ".mbr-card-title_1, .mbr-card-title_2, .mbr-card-title_3": {
                  "margin-bottom": "24px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "16px"
                  }
                },
                ".mbr-text_1, .mbr-text_2, .mbr-text_3": {
                  "margin": "0"
                }
              }
            },
            ".card_1": {
              ".card-wrapper": {
                "background-color": "@card_1"
              }
            },
            ".card_2": {
              ".card-wrapper": {
                "background-color": "@card_2"
              }
            },
            ".card_3": {
              ".card-wrapper": {
                "background-color": "@card_3"
              }
            },
            ".mbr-section-title": {
              "color": "#101511",
              "text-align": "center"
            },
            ".mbr-desc": {
              "color": "#6e716f",
              "text-align": "center"
            },
            ".mbr-card-title_1": {
              "color": "#101511"
            },
            ".mbr-card-title_2": {
              "color": "#101511"
            },
            ".mbr-card-title_3": {
              "color": "#ffffff"
            },
            ".mbr-text_1": {
              "color": "#6e716f"
            },
            ".mbr-text_2": {
              "color": "#6e716f"
            },
            ".mbr-text_3": {
              "color": "#e8e8e8"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#ffffff"
            }
          },
          "_cid": "v0xsUnOpBJ",
