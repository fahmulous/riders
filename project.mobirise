          "_name": "footer01",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 essencem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"cont\" min=\"0\" max=\"3\" step=\"1\" value=\"3\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showContacts\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showContacts\" selected>\n        <input type=\"checkbox\" title=\"Desc\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#00d0f3\" name=\"active\" condition=\"showNav || showContacts || showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#b0b0b0\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#f2fdff\" name=\"shadow\" selected>\n        <input type=\"checkbox\" title=\"Copy\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background12.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showTitle || showText\">\n                <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/469598294-595183719735444-159510259647027175-n-790x288.png\" alt=\"RIDERS Trading & Manufacturing S.C\">\n                    </a>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Menu</b><b><br></b>\n                    </h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><span style=\"font-size: 1.25rem; letter-spacing: -0.03rem; background-color: transparent;\"><a href=\"index.html\" class=\"text-primary\">Home</a></span></li><li class=\"item-wrap\"><font color=\"#141414\"><a href=\"about.html\" class=\"text-primary\">About Us</a></font></li><a href=\"page9.html#features02-5b\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\"><a href=\"capabilities.html\" class=\"text-primary\">Capabilities</a></li>\n                        <li class=\"item-wrap\"><a href=\"products.html\" class=\"text-primary\">Products</a></li>\n                    </ul>\n                     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"projects.html\" class=\"text-primary\" style=\"font-size: 1.25rem; letter-spacing: -0.03rem; background-color: transparent;\">Our Work</a><br></li><a href=\"projects.html#content4-1q\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"project.html\" class=\"text-primary\">Projects</a></li><a href=\"projects.html#content4-1q\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"leadership.html\" class=\"text-primary\">Leadership</a></li><li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"contact.html\" class=\"text-primary\">Contact</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showContacts\">\n                <div class=\"contacts-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Contacts</b>\n                    </h3>\n                    <div class=\"contacts-wrap\">\n                        <div class=\"item-contact\">\n                            <div class=\"item-wrap\">\n                                <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(20, 20, 20); fill: rgb(20, 20, 20);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-primary\" target=\"_blank\">Sarbet JFK Apartments,</a><a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-primary\" target=\"_blank\">Addis Ababa</a></p>\n                                \n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 1\">\n                            <div class=\"item-wrap\">\n                                <a href=\"tel:+251-911-072513\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"tel:+251-911-072513\" class=\"text-primary\">+251-911-072513</a><a href=\"tel:+251-911-072513\" class=\"text-primary\">+251-944-334484</a></p>\n                                \n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 2\">\n                            <div class=\"item-wrap\">\n                                <a href=\"mailto:info@ridersgroupsc.com\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span></a>\n                                <a href=\"#\">\n                                    </a><p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\"><a href=\"#\"></a><a href=\"mailto:info@ridersgroupsc.com\" class=\"text-primary\">info@ridersgroupsc.com</a></p>\n                                \n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showSubtitle || showDesc || showButtons || showSocial\">\n                <div class=\"desc-wrapper\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://web.facebook.com/profile.php?id=100077837321146\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"color: rgb(24, 119, 242); fill: rgb(24, 119, 242);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://www.youtube.com/@ridersbusinessgroupsc3225\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"color: rgb(238, 41, 71); fill: rgb(238, 41, 71);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-telegram socicon\" style=\"color: rgb(10, 102, 194); fill: rgb(10, 102, 194);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://www.instagram.com/riderssc_2024?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(250, 18, 96); fill: rgb(250, 18, 96);\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\">\n                    © Copyright 2025 RIDERS Trading &amp; Manufacturing S.C - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
