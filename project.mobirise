  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "RIDERS Trading and Manufacturing | Premium Textile Manufacturing in Ethiopia",
        "meta_descr": "RIDERS is Ethiopia's premier vertically integrated textile manufacturer specializing in premium cotton fabrics, apparel, home textiles, and industrial solutions. Discover our sustainable manufacturing capabilities and innovative textile products made with Ethiopian cotton.",
        "header_custom": "<!-- Primary Meta Tags -->\n<meta name=\"title\" content=\"RIDERS | Premium Textile Manufacturing in Ethiopia\">\n<meta name=\"description\" content=\"RIDERS is Ethiopia's premier vertically integrated textile manufacturer specializing in premium cotton fabrics, apparel, home textiles, and industrial solutions. Discover our sustainable manufacturing capabilities and innovative textile products made with Ethiopian cotton.\">\n<meta name=\"keywords\" content=\"textile manufacturing, Ethiopian cotton, apparel manufacturing, industrial textiles, sustainable textiles, fabric production, garment manufacturing, Ethiopia\">\n\n<!-- Open Graph / Facebook -->\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.riders-else.com/\">\n<meta property=\"og:title\" content=\"RIDERS-ELSE | Premium Textile Manufacturing in Ethiopia\">\n<meta property=\"og:description\" content=\"Ethiopia's premier vertically integrated textile manufacturer specializing in premium cotton fabrics, apparel, and home textiles.\">\n<meta property=\"og:image\" content=\"https://www.riders-else.com/assets/images/social-share.jpg\">\n\n<!-- Twitter -->\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://www.riders-else.com/\">\n<meta property=\"twitter:title\" content=\"RIDERS-ELSE | Premium Textile Manufacturing in Ethiopia\">\n<meta property=\"twitter:description\" content=\"Ethiopia's premier vertically integrated textile manufacturer specializing in premium cotton fabrics, apparel, and home textiles.\">\n<meta property=\"twitter:image\" content=\"https://www.riders-else.com/assets/images/social-share.jpg\">\n\n<!-- Canonical URL -->\n<link rel=\"canonical\" href=\"https://www.riders-else.com/\">\n\n<!-- Favicon -->\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/assets/favicon/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/assets/favicon/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/assets/favicon/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"/assets/favicon/site.webmanifest\">",
        "footer_custom": "<!-- Structured Data for Organization -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"RIDERS\",\n  \"url\": \"https://www.riders-else.com\",\n  \"logo\": \"https://www.riders-else.com/assets/images/logo.png\",\n  \"description\": \"Ethiopia's premier vertically integrated textile manufacturer specializing in premium cotton fabrics, apparel and industrial solutions.\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"Sarbet K F J Apartments\",\n    \"addressLocality\": \"Addis Ababa\",\n    \"addressCountry\": \"Ethiopia\"\n  },\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"telephone\": \"+251-911-072513\",\n    \"contactType\": \"customer service\",\n    \"email\": \"info@ridersgroupsc.com\"\n  },\n  \"sameAs\": [\n    \"https://www.facebook.com/riderselse\",\n    \"https://www.linkedin.com/company/riders-else\",\n    \"https://www.instagram.com/riderselse\"\n  ]\n}\n</script>\n\n<!-- Google Analytics (GA4) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
