          "_name": "menu01",
          "_sourceTheme": "patternm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 patternm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#0f0f0f\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#0f0f0f\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#f2fdff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#0f0f0f\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky, 'navbar-expand-lg':!collapsed, 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/469598294-595183719735444-159510259647027175-n-1-790x288.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <!-- TAGLINE INSIDE navbar-brand for mobile stacking -->\n                <div class=\"navbar-tagline-mobile\">\n                    <img src=\"https://r.mobirisesite.com/2098721/assets/images/screenshot-2025-10-25-at-23.01.20-1.png\" alt=\"Beyond Investment\" class=\"tagline-img\">\n                </div>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">PatternM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a></li>\n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">About Us</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-598\"><a class=\"dropdown-item text-black\" href=\"about.html#article05-85\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Corporate Overview</a><a class=\"dropdown-item text-black\" href=\"vision.html#header01-9l\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Vision, Mission &amp; Value&nbsp;</a><a class=\"dropdown-item text-black\" href=\"leadership.html#header2-2c\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Leadership</a></div>\n                    </li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-black show\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"true\">Sectors</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-196\" data-bs-popper=\"none\"><a class=\"dropdown-item text-black\" href=\"textile-industry.html#header2-af\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Textile Industry</a><a class=\"dropdown-item text-black\" href=\"farming.html#header2-an\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Farming</a><a class=\"dropdown-item text-black\" href=\"real-estate.html#header01-b5\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Real Estate &amp; Construction</a><a class=\"dropdown-item text-black\" href=\"financial-sector.html#header01-bi\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Financial Services</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"documents.html#header03-bw\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Documents</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"news.html#features8-ca\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">News</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"jobs.html#article05-cg\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Jobs</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"gallery.html#header02-ci\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Gallery</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"contact.html#maps4-2v\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contact Us</a></li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-info\" href=\"mailto:info@ridersgroupsc.com\" data-app-placeholder=\"Type Text\">Get In Touch</a></div>\n                <!-- TAGLINE FOR DESKTOP - inside navbar-collapse -->\n                <div class=\"navbar-tagline\">\n                    <img src=\"https://r.mobirisesite.com/2098721/assets/images/screenshot-2025-10-25-at-23.01.20-1.png\" alt=\"Beyond Investment\" class=\"tagline-img\">\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_anchor": "menu01-f1",
