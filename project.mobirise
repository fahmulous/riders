              "text-align": "center",
              "width": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 991px)": {
                  "text-align": "left",
                  "width": "auto"
                }
              },
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "min-height": "auto",
                "width": "auto",
                "font-size": "0.9rem",
                "padding": "10px 20px",
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              },
              "margin-right": "4px !important",
              "margin-left": "0 !important",
              "border-radius": "50px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              },
              "margin-right": "4px !important"
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "0 !important",
                "margin": "6px 6px !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "300",
                "border-radius": "3rem",
                "text-decoration": "underline",
                "text-decoration-color": "transparent",
                "font-size": "0.95rem",
                "&::after": {
                  "color": "inherit !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover, &:focus": {
                  "background-color": "transparent",
                  "color": "@activeColor !important",
                  "text-decoration-color": "@activeColor",
                  "&::after": {
                    "color": "inherit !important"
                  }
                },
                "&.active": {
                  "color": "@activeColor !important",
                  "text-decoration-color": "@activeColor !important",
                  "font-weight": "500 !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid transparent"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center",
                    "margin": "0 !important",
                    "margin-bottom": "4px !important"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important",
                ".navbar-collapse": {
                  "position": "fixed !important",
                  "top": "0 !important",
                  "left": "0 !important",
                  "right": "0 !important",
                  "bottom": "0 !important",
                  "background": "@menuBgColor !important",
                  "z-index": "999 !important",
                  "width": "100vw !important",
                  "height": "100vh !important",
                  "margin-top": "0 !important"
                }
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid transparent"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center",
                    "margin": "0 !important",
                    "margin-bottom": "4px !important"
                  }
                },
                "order": "4",
                "flex-basis": "100%",
                "margin-top": "15px"
              },
              ".navbar-tagline": {
                "display": "none !important"
              },
              ".navbar-tagline-mobile": {
                "display": "block !important",
                "margin-top": "8px",
                ".tagline-img": {
                  "height": "30px !important",
                  "width": "auto",
                  "border-radius": "0 !important",
                  "object-fit": "contain",
                  "image-rendering": "crisp-edges"
                }
              },
              ".content-wrap": {
                "flex-wrap": "nowrap !important"
              },
              ".navbar-brand": {
                "order": "1",
                "display": "flex !important",
                "flex-direction": "column !important",
                "align-items": "flex-start !important",
                "max-width": "70% !important"
              },
              ".navbar-logo img": {
                "height": "4rem !important"
              },
              ".navbar-toggler": {
                "order": "2",
                "z-index": "1000 !important"
              }
            },
            ".navbar-tagline": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "4px !important",
              "padding-left": "8px",
              "flex-shrink": "0",
              "border-radius": "0 !important",
              "overflow": "visible",
              "border-left": "1px solid rgba(0, 0, 0, 0.1)",
              ".tagline-img": {
                "height": "22px",
                "width": "auto",
                "display": "block",
                "border-radius": "0 !important",
                "object-fit": "contain",
                "image-rendering": "crisp-edges"
              }
            },
            ".navbar-tagline-mobile": {
              "display": "none"
            },
            "@media (min-width: 992px)": {
              ".navbar-tagline-mobile": {
                "display": "none !important"
              },
              ".navbar-tagline": {
                "display": "flex !important"
              },
              ".content-wrap": {
                "display": "flex",
                "align-items": "center",
                "flex-wrap": "nowrap"
              },
              ".navbar-collapse": {
                "display": "flex !important",
                "align-items": "center !important",
                "flex-wrap": "nowrap",
                "justify-content": "space-between !important"
              },
              ".navbar-nav": {
                "flex-wrap": "nowrap !important",
                "margin": "0 auto !important",
                "flex": "0 0 auto !important"
              },
              ".navbar-buttons": {
                "margin-left": "auto !important"
              },
              ".navbar .dropdown:hover > .dropdown-menu": {
                "display": "block",
                "opacity": "1",
                "visibility": "visible"
              },
              ".navbar .dropdown-menu": {
                "display": "none",
                "opacity": "0",
                "visibility": "hidden",
                "transition": "opacity 0.2s ease",
                "margin-top": "0 !important",
                "top": "100%"
              },
              ".navbar .dropdown": {
                "position": "relative"
              },
              ".navbar.navbar-expand-lg .dropdown .dropdown-menu": {
                "top": "100% !important",
                "margin-top": "0 !important"
              },
              ".navbar.navbar-expand-lg .dropdown:hover > .dropdown-menu, .navbar.navbar-expand-lg .dropdown-menu:hover": {
                "display": "block !important",
                "opacity": "1 !important",
                "visibility": "visible !important"
              },
              ".navbar.navbar-expand-lg .dropdown": {
                "position": "relative"
              }
            },
            "@media (min-width: 992px) and (max-width: 1200px)": {
              ".navbar-tagline .tagline-img": {
                "height": "20px",
                "border-radius": "0 !important"
              },
              ".nav-item .nav-link": {
                "margin": "6px 4px !important",
