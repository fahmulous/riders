    "leadership.html": {
      "settings": {
        "title": "Leadership | RIDERS Trading and Manufacturing",
        "order": "7",
        "header_custom": "<meta name=\"description\" content=\"Meet the experienced leadership team at RIDERS, a premier Ethiopian textile manufacturer. Our executives bring decades of industry expertise in sustainable textile production, apparel manufacturing, and global textile trade.\">\n<meta name=\"keywords\" content=\"RIDERS leadership, textile industry leaders, Ethiopian textile executives, sustainable textile management, apparel manufacturing leadership, textile company directors\">\n\n<!-- Open Graph / Facebook -->\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.riders-else.com/leadership.html\">\n<meta property=\"og:title\" content=\"Leadership Team | Textile Industry Experts | RIDERS\">\n<meta property=\"og:description\" content=\"Meet the experienced leadership team at RIDERS, a premier Ethiopian textile manufacturer with expertise in sustainable textile production.\">\n<meta property=\"og:image\" content=\"https://ridersgroupsc.com/assets/images/leadership-social.jpg\">\n\n<!-- Twitter -->\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://ridersgroupsc.com/leadership.html\">\n<meta property=\"twitter:title\" content=\"Leadership Team | Textile Industry Experts | RIDERS\">\n<meta property=\"twitter:description\" content=\"Meet the experienced leadership team at RIDERS, a premier Ethiopian textile manufacturer with expertise in sustainable textile production.\">\n<meta property=\"twitter:image\" content=\"https://ridersgroupsc.com/assets/images/leadership-social.jpg\">\n\n<!-- Canonical URL -->\n<link rel=\"canonical\" href=\"https://ridersgroupsc.com/leadership.html\">",
        "footer_custom": "<!-- Structured Data for Leadership Team -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"RIDERS\",\n  \"url\": \"https://ridersgroupsc.com/\",\n  \"logo\": \"https://ridersgroupsc.com/assets/images/logo.png\",\n  \"sameAs\": [\n    \"https://www.youtube.com/@ridersbusinessgroupsc3225\",\n    \"https://web.facebook.com/profile.php?id=100077837321146\",\n    \"https://www.instagram.com/riderssc_2024\"\n  ],\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"Sarbet K F J Apartments\",\n    \"addressLocality\": \"Addis Ababa\",\n    \"addressCountry\": \"Ethiopia\"\n  },\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"telephone\": \"+251-911-072513\",\n    \"email\": \"info@ridersgroupsc.com\",\n    \"contactType\": \"Customer Service\"\n  },\n  \"member\": [\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Nebyou Nesru\",\n      \"jobTitle\": \"Chief Executive Officer\",\n      \"description\": \"Leads RIDERS with over 21 years of experience in textile manufacturing and international trade.\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Mosisa Ebsa\",\n      \"jobTitle\": \"Deputy CEO\",\n      \"description\": \"Oversees all manufacturing operations with expertise in sustainable production practices.\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"MohammedZeyen Kedir\",\n      \"jobTitle\": \"Chief Farming Officer\",\n      \"description\": \"Manages financial strategy with background in international business and textile industry economics.\"\n    }\n  ]\n}\n</script>",
        "meta_descr": "Meet the experienced leadership team at RIDERS a premier Ethiopian textile manufacturer. Our executives bring decades of industry expertise in sustainable textile production, apparel manufacturing, and global textile trade.",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->"
      },
