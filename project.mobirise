              "align-items": "center",
              "margin-left": "4px !important",
              "padding-left": "8px",
              "flex-shrink": "0",
              "border-radius": "0 !important",
              "overflow": "visible",
              "border-left": "1px solid rgba(0, 0, 0, 0.1)",
              ".tagline-img": {
                "height": "22px",
                "width": "auto",
                "display": "block",
                "border-radius": "0 !important",
                "object-fit": "contain",
                "image-rendering": "crisp-edges"
              }
            },
            ".navbar-tagline-mobile": {
