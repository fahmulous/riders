    "project.html": {
      "settings": {
        "title": "Projects | RIDERS Trading and Manufacturing",
        "order": "6",
        "footer_custom": "<!-- Structured Data for Projects -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"CollectionPage\",\n  \"name\": \"RIDERS Textile Projects\",\n  \"description\": \"Portfolio of textile manufacturing projects completed by RIDERS across various industries.\",\n  \"hasPart\": [\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Sustainable Apparel Collection\",\n      \"description\": \"Development and production of an eco-friendly clothing line using organic Ethiopian cotton\",\n      \"image\": \"https://ridersgroupsc.com/assets/images/project-apparel.jpg\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Agricultural Protection Fabrics\",\n      \"description\": \"Specialized textiles for crop protection with UV resistance and moisture management properties\",\n      \"image\": \"https://ridersgroupsc.com/assets/images/project-agriculture.jpg\"\n    }\n  ]\n}\n</script>",
        "header_custom": "<meta name=\"description\" content=\"Explore RIDERS's successful textile projects across apparel manufacturing, home textiles, and industrial applications. Our Ethiopian textile facility has delivered custom solutions for global brands and local businesses.\">\n<meta name=\"keywords\" content=\"textile projects, apparel manufacturing projects, home textile projects, industrial textile projects, Ethiopian textile case studies, sustainable textile projects, custom textile solutions, textile manufacturing portfolio\">\n\n<!-- Open Graph / Facebook -->\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://ridersgroupsc.com/projects.html\">\n<meta property=\"og:title\" content=\"Textile Projects | Client Success Stories | RIDERS\">\n<meta property=\"og:description\" content=\"Explore RIDERS-ELSE's successful textile projects across apparel manufacturing, home textiles, and industrial applications.\">\n<meta property=\"og:image\" content=\"https://ridersgroupsc.com/assets/images/projects-social.jpg\">\n\n<!-- Twitter -->\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://ridersgroupsc.com/projects.html\">\n<meta property=\"twitter:title\" content=\"Textile Projects | Client Success Stories | RIDERS\">\n<meta property=\"twitter:description\" content=\"Explore RIDERS's successful textile projects across apparel manufacturing and industrial applications.\">\n<meta property=\"twitter:image\" content=\"https://ridersgroupsc.com/assets/images/projects-social.jpg\">\n\n<!-- Canonical URL -->\n<link rel=\"canonical\" href=\"https://ridersgroupsc.com/projects.html\">",
        "meta_descr": "Explore RIDERS's successful textile projects across apparel manufacturing, home textiles, and industrial applications. Our Ethiopian textile facility has delivered custom solutions for global brands and local businesses.",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->"
      },
