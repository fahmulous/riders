        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background-image": "linear-gradient(@bg-value 80%, @gradientColor 110%)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "position": "relative",
              "z-index": "2",
              ".mbr-section-title": {
                "margin-bottom": "48px",
                "letter-spacing": "1px",
                "background-image": "linear-gradient(0deg, @title_1, @title_2 60%)",
                "-webkit-background-clip": "text",
                "-webkit-text-fill-color": "transparent",
                "@media (max-width: 992px)": {
                  "margin-bottom": "22px"
                }
              },
              ".mbr-text": {
                "margin-bottom": "54px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "22px"
                }
              },
              ".mbr-desc": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "22px"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            }
          },
          "_name": "article03",
          "_sourceTheme": "emblemm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03 emblemm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Title Gradient 1\" value=\"#00a1bb\" name=\"title_1\" condition=\"showTitle\">\n        <input type=\"color\" title=\"Title Gradient 2\" value=\"#1e4381\" name=\"title_2\" condition=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/image5-1.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#3e3e45\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/emblemm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Gradient Background\" name=\"gradientBg\" checked condition=\"bg.type == 'color'\">\n        <input type=\"color\" title=\"Gradient Color\" name=\"gradientColor\" value=\"#dbd1f8\" condition=\"gradientBg && bg.type=='color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#97c9af\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <br>About Us\n                    </h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Founded in 2021, Riders Trading &amp; Manufacturing S.C. is one of Ethiopia’s fastest-growing industrial groups. In 2022, we acquired the former ELSE ADDIS Textile Manufacturing Company from the Development Bank of Ethiopia for a total cost of 1.29 billion Ethiopian Birr. This strategic move enabled us to build one of the country’s few fully integrated textile operations — from cotton ginning to yarn spinning, fabric weaving, and recycling.<br><br>The Adama facility was originally established in 2010. Today, our 80,000 sqm facility operates as a professionally managed, world-class textile company. With ETB 1 billion registered capital and 1,160+ shareholders, Riders stands on a strong foundation of local investment. Our facility employs 900+ skilled professionals, producing over 20 tons of yarn and 35,000+ meters of fabric daily. What sets Riders apart is our ability to merge international quality standards with deep local roots, building long-term partnerships with Ethiopian cotton farmers while delivering consistent, sustainable, and globally competitive products. Our core services include ginning, spinning, weaving, and cotton transportation.</p>\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                        A strong personal brand helps you stand out, build trust, and create opportunities by\n                        positioning you as an expert in your field.\n                    </p>\n                </div>\n                <div class=\"content-wrapper\">\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"mailto:info@ridersgroupsc.com\" data-app-placeholder=\"Type Text\">Get In Touch</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uUNvZ5NfA1",
          "_anchor": "article03-x",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".row": {
              "@media (min-width: 992px)": {
                "margin": "0"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "&:nth-child(2)": {
                  "border-left": "1px solid @border",
                  "& when (@reverseContent)": {
                    "border-left": "none",
                    "border-right": "1px solid @border"
                  },
                  "@media (max-width: 992px)": {
                    "margin-bottom": "64px"
                  }
                },
                "&:nth-child(3)": {
                  "border-top": "1px solid @border"
                },
                "&:nth-child(4)": {
                  "border-top": "1px solid @border",
                  "border-left": "1px solid @border",
                  "& when (@reverseContent)": {
                    "border-left": "none",
                    "border-right": "1px solid @border"
                  }
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px",
                  "border": "none !important"
                }
              }
            },
            ".subtitle-wrap": {
              "height": "100%",
              "display": "flex",
              "justify-content": "flex-end",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".mbr-section-subtitle": {
                "padding": "32px",
                "letter-spacing": "1px",
                "writing-mode": "tb",
                "transform": "rotate(180deg)",
                "margin": "0",
                "@media (max-width: 992px)": {
                  "transform": "rotate(0)",
                  "writing-mode": "horizontal-tb",
                  "padding": "24px",
                  "border-left": "1px solid @border",
                  "text-align": "left"
                }
              }
            },
            ".content-wrapper": {
              "padding": "32px",
              "@media (max-width: 992px)": {
                "padding": "24px",
                "border-top": "1px solid @border",
                "border-left": "1px solid @border"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px",
                "letter-spacing": "1px"
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-section-btn": {
                "margin-top": "32px",
                "@media (max-width: 992px)": {
                  "text-align": "left",
                  "margin-top": "24px"
                }
              },
              ".list": {
                "margin-top": "32px",
                "@media (max-width: 992px)": {
                  "margin-top": "24px"
                },
                ".item": {
                  "margin-bottom": "24px",
                  ".item-wrapper": {
                    ".card-box": {
                      ".title-wrapper": {
                        "display": "inline-flex",
                        "align-items": "center",
                        ".card-number": {
                          "margin": "0 24px 0 0",
                          "color": "transparent",
                          "-webkit-text-stroke": "1px @number",
                          "-webkit-background-clip": "text"
                        },
                        ".card-title": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-section-subtitle": {
              "color": "#E0B548",
              "text-align": "center"
            },
            ".mbr-text": {
