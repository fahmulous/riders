              ".content-wrap": {
                "display": "flex",
                "align-items": "center",
                "flex-wrap": "nowrap"
              },
              ".navbar-collapse": {
                "display": "flex !important",
                "align-items": "center !important",
                "flex-wrap": "nowrap",
                "justify-content": "space-between !important"
              },
              ".navbar-nav": {
                "flex-wrap": "nowrap !important",
                "margin": "0 auto !important",
                "flex": "0 0 auto !important"
              },
              ".navbar-buttons": {
                "margin-left": "auto !important"
              },
              ".navbar .dropdown:hover > .dropdown-menu": {
                "display": "block",
                "opacity": "1",
                "visibility": "visible"
              },
              ".navbar .dropdown-menu": {
                "display": "none",
                "opacity": "0",
                "visibility": "hidden",
                "transition": "opacity 0.2s ease",
                "margin-top": "0 !important",
                "top": "100%"
              },
              ".navbar .dropdown": {
                "position": "relative"
              },
              ".navbar.navbar-expand-lg .dropdown .dropdown-menu": {
                "top": "100% !important",
                "margin-top": "0 !important"
              },
              ".navbar.navbar-expand-lg .dropdown:hover > .dropdown-menu, .navbar.navbar-expand-lg .dropdown-menu:hover": {
                "display": "block !important",
                "opacity": "1 !important",
                "visibility": "visible !important"
              },
              ".navbar.navbar-expand-lg .dropdown": {
