                      "position": "relative",
                      "z-index": "1",
                      "width": "100%",
                      ".item-title": {
                        "display": "inline-flex",
                        "padding": "14px 15px",
                        "margin-bottom": "0",
                        "border-radius": "100vw",
                        "background-color": "@title_1"
                      }
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-date": {
