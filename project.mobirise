    "farming.html": {
      "settings": {
        "title": "Farming & Agriculture | Crop Production | Riders Trading & Manufacturing S.C.",
        "order": "6",
        "meta_descr": "Riders agricultural operations: 200+ hectares of irrigated farmland producing wheat, maize, teff, and cash crops. Modern mechanized farming contributing to Ethiopia's food security and export growth.",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->",
        "header_custom": "<!-- Structured Data - Agriculture -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Agricultural Production Services\",\n  \"description\": \"Commercial farming on 200+ hectares producing wheat, maize, and teff\",\n  \"manufacturer\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Riders Trading and Manufacturing S.C.\"\n  },\n  \"category\": \"Agriculture\"\n}\n</script>\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
        "footer_custom": "<!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>"
