            ".card-text_1": {
              "color": "#000000"
            },
            ".card-text_2": {
              "color": "#000000"
            },
            ".card-text_3": {
              "color": "#000000"
            },
            ".card-text_4": {
              "color": "#000000"
            },
            ".card-title_1 DIV": {
