        "meta_descr": "Discover Riders Trading & Manufacturing S.C. - Ethiopia's pioneering shareholder-driven holding company established in 2021 with 1,160+ shareholders and ETB 1B capital. Learn about our investment philosophy and strategic business sectors.",
        "header_custom": "<!-- Structured Data - About Page -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"AboutPage\",\n  \"name\": \"Corporate Overview | Riders Trading & Manufacturing S.C.\",\n  \"description\": \"Ethiopia's pioneering shareholder-driven holding company established in 2021 with 1,160+ shareholders and ETB 1B capital\",\n  \"mainEntity\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Riders Trading and Manufacturing S.C.\",\n    \"foundingDate\": \"2021\"\n  }\n}\n</script>\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
