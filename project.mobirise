          "_name": "features04",
          "_sourceTheme": "forwardm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 forwardm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#01004c\" name=\"icon\" condition=\"showIcon\" selected=\"\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Border Color\" value=\"#38001b\" name=\"border\" condition=\"showBorder\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/forwardm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/forwardm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        Our toolkit is carefully curated <br> to meet the diverse needs\n                    </h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Riders Farming &amp; Agriculture represents our strategic investment in Ethiopia's agricultural transformation. Operating across three major regions—Afar, Somali, and Southern Nations—we are developing large-scale commercial farming operations with total land capacity exceeding 10,000 hectares.<br><br>Our integrated approach combines cotton production (supplying our textile operations), food security crops (wheat, cereals, oilseeds), and high-value export crops (coffee, fruits, vegetables). With modern irrigation infrastructure and sustainable farming practices, we're contributing to Ethiopia's agricultural modernization while creating employment and economic opportunities in rural communities.</p>\n                    </div>\n                                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Key Stats</h2>\n                    <div class=\"items-wrapper\">\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"mbr-iconfont icon54-v1-corn\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\">\n                                        Integrated Development\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        10,000+ hectares - Total Land Capacity\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"mbr-iconfont icon54-v1-watering-can\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\">\n                                        Version Control\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Full Irrigation - Modern Infrastructure<br></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"mbr-iconfont imind-tractor\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\">\n                                        Build Automation\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">3 Active Projects - Multi-Region Operations<br></p>\n                                </div>\n                            </div>\n                        </div>\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0xyUuqtlW",
          "_anchor": "features04-ap",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "display": "inline-block",
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "40px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "440px",
              "max-width": "440px",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "background-color": "@cardBg",
                  "overflow": "hidden",
                  "padding-bottom": "20px",
                  "&:hover, &:focus": {
                    ".card-box .item-img img": {
                      "transform": "scale(1.1)"
                    }
                  },
                  ".card-box": {
                    ".item-img": {
                      "overflow": "hidden",
                      "margin-bottom": "20px",
                      "img": {
                        "height": "430px",
                        "width": "100%",
                        "object-fit": "cover",
                        "border-radius": "0 !important",
                        "transition": "all 0.3s ease-in-out",
                        "@media (max-width: 992px)": {
                          "height": "300px"
                        }
                      }
                    },
                    ".card-title": {
                      "position": "relative",
                      "z-index": "1",
                      "padding": "0 20px 10px",
                      "margin-bottom": "0"
                    },
                    ".card-text": {
                      "position": "relative",
                      "z-index": "1",
                      "padding": "0 20px",
                      "margin-bottom": "0"
                    }
                  },
                  ".mbr-section-btn": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "0 20px",
                    "margin": "40px 0 0",
                    "@media (max-width: 992px)": {
                      "margin-top": "20px"
                    },
                    ".btn": {
                      "min-height": "35px",
                      "margin-bottom": "0",
                      "margin-left": "0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".arrows-wrapper": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "display": "flex",
              "justify-content": "flex-end"
            },
            ".embla__button": {
              "top": "27px",
              "width": "54px",
              "height": "54px",
              "margin-top": "-1.5rem",
              "font-size": "28px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "background-color": "@arrowsColor !important",
                "color": "@arrowsBg !important"
              },
              "&:disabled": {
                "opacity": ".5 !important",
                "background-color": "@arrowsBg !important",
                "color": "@arrowsColor !important"
              },
              "&.embla__button--prev": {
                "margin-right": "62px"
              },
              "&.embla__button--next": {
                "margin-left": "78px"
              }
            },
            ".embla": {
              "position": "relative",
              "z-index": "1",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "4.5rem"
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "padding": "0",
              "@media (max-width: 768px)": {
                "padding": "0"
              },
              "& when not (@fullWidth)": {
                "overflow": "hidden"
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title, .title-wrapper": {
              "color": "#323432",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#323432"
            },
            ".card-text": {
              "color": "#323432"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "plantm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider04 mbr-embla plantm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#5c834f\" condition=\"arrows\">\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#d1e0be\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"32\" step=\"6\" value=\"6\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card BG\" name=\"cardBg\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/plantm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f1f5eb\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .title-wrapper\" mbr-if=\"showTitle\">\n                        Transforming Spaces with Purpose, Personality, and Precision\n                    </h2>\n                </div>\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                        <div class=\"embla__container\">\n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/083a975020-20copy-1152x768.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\">\n                                                Luxury Coastal Home\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                                Inspired by natural light and ocean views\n                                            </p>\n                                        </div>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove, -iconFont\">\n                                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                Read more\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/dji-fly-20241121-120942-715-1732180240152-photo-optimized-560x315.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\">\n                                                Boutique Hotel Concept\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                                Designed an inviting and immersive guest\n                                            </p>\n                                        </div>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove, -iconFont\">\n                                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                Read more\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/photo-2023-12-20-16-49.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\">\n                                                Minimalist Office Interior\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                                Created a sleek, minimalist corporate workspace\n                                            </p>\n                                        </div>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove, -iconFont\">\n                                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                Read more\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/photo-2025-10-17-16-45-14.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .mbr-section-btn\">\n                                                Historic Brownstone\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                                Brought new life to a 19th-century brownstone\n                                            </p>\n                                        </div>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove, -iconFont\">\n                                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                Read more\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"arrows-wrapper\">\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v2hhwJttCi",
          "_anchor": "slider04-fi",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "tabs02",
          "_sourceTheme": "ridem5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-desc": {
              "margin-bottom": "15px"
            },
            ".tabs-wrapper": {
              "background-color": "@tabsBg",
              "border-radius": "6rem 6rem  0 0",
              "padding": "35px 60px 225px",
              "& when not (@isRoundedImages)": {
                "border-radius": "0 !important"
              },
              "@media (max-width: 1200px)": {
                "padding": "35px 30px 225px"
              },
              "@media (max-width: 992px)": {
                "padding": "35px 16px 225px",
                "border-radius": "2rem 2rem 0 0"
              },
              ".nav.nav-tabs": {
                "border": "none",
                "padding": "0",
                "border-radius": "0 !important",
                "background-color": "transparent",
                "display": "inline-flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                ".nav-item": {
                  "padding": "10px 20px",
                  "border": "none",
                  "border-radius": "0",
                  "display": "block",
                  "margin": "0",
                  ".nav-link": {
                    "position": "relative",
                    "color": "@tabs",
                    "padding": "0",
                    "border": "none",
                    "margin-bottom": "0",
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "bottom": "-2px",
                      "left": "0",
                      "width": "0",
                      "height": "2px",
                      "transition": "all 0.3s ease-in-out",
                      "background-color": "@tabs"
                    }
                  },
                  ".nav-link.active": {
                    "background-color": "transparent",
                    "&::before": {
                      "width": "100%"
                    }
                  }
                }
              },
              "text-align": "center"
            },
            ".tab-content": {
              "background-color": "@card",
              "border-radius": "6rem",
              "margin-top": "-190px",
              "padding": "110px 60px",
              "& when not (@isRoundedImages)": {
                "border-radius": "0 !important"
              },
              "@media (max-width: 1200px)": {
                "padding": "70px 30px"
              },
              "@media (max-width: 992px)": {
                "padding": "16px",
                "border-radius": "2rem"
              },
              ".tab-pane": {
                ".content-wrap": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "@media (max-width: 992px)": {
                    "display": "block",
                    "margin-bottom": "15px"
                  },
                  ".image-wrapper": {
                    "width": "48%",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "35px"
                    },
                    "img": {
                      "height": "350px",
                      "object-fit": "cover",
                      "border-radius": "2rem",
                      "@media (max-width: 992px)": {
                        "border-radius": "1rem"
                      }
                    }
                  },
                  ".text-wrapper": {
                    "width": "48%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    ".item-title": {
                      "margin-bottom": "20px"
                    },
                    ".item-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".mbr-section-title, .main-btn": {
              "text-align": "center",
              "color": "#141414"
            },
            ".item-title, .tabs-wrapper": {
              "color": "#141414"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs02 ridem5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color \" value=\"#141414\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs BG\" value=\"#f4f4f6\" name=\"tabsBg\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Card Bg\" value=\"#E9E9E6\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@SITES@/2098721/assets/images/background1-10.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@SITES@/2098721/assets/images/background1-10.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Our Projects</h2>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"tabs-wrapper\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-au_tab0\" aria-selected=\"true\">Cotton Farming</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-au_tab1\" aria-selected=\"true\">Fabrics (Woven &amp; Knitted)</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-au_tab2\" aria-selected=\"true\">Recycling &amp; Recycled Fibers</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-au_tab3\" aria-selected=\"false\">Technical Textiles</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-au_tab4\" aria-selected=\"false\">Finishing &amp; Garments (Coming Soon)</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs02-u_tab5\" aria-selected=\"true\">\n                                <strong>Community</strong>\n                            </a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/1d3a3267-440x293.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\">Amibara Farm ✅ OPERATIONAL</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Location:<br><br>\n                                </p>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Land:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">400 hectares (contract farming with local community on rental basis)</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Status: Fully operational with complete irrigation scheme</span></li>\n                            </ul>\n                                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Current Production:<br><br>\n                                </p>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Cotton: Primary crop - 100% of 400ha currently planted</span></li><li class=\"item-wrap\">Purpose: Direct supply to Riders-ELSE Textile Industry</li>\n                            </ul>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Key Features:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Contract farming partnership model</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Full irrigation infrastructure</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Active cotton production</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Community-based land arrangement</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Direct textile factory integration<br></span><br></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/1d3a3197-2000x1333.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\">Fabrics (Woven &amp; Knitted)</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Location:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">8km northwest of Gewane town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">385km from Addis Ababa</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region</span></li>\n                            </ul>\n                                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Land:<br><br>\n                                </p>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">3,000 hectares (gross area)</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Expansion potential: Up to 5,000 hectares</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Status: Technical and feasibility study completed</span></li>\n                            </ul>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Planned Production:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Cotton - Industrial and export quality</li><li class=\"item-wrap\">Oilseeds - Multiple varieties</li><li class=\"item-wrap\">Fruits - Climate-suitable production</li><li class=\"item-wrap\">Other crops - Based on market demand</li>\n                            </ul>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Investment:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Total Project Cost: USD $34 million</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Water Source: Near Awash River (irrigation-ready)</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Suitability: Highly suitable for cotton, oilseeds, and fruit production</span></li>\n                            </ul>\n                                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Key Features:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Feasibility study complete - investment ready</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Strategic location near Awash River</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Proven agricultural suitability</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Scalable to 5,000ha</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Partnership opportunities available</span></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-u0grwnu0grwnu0gr-1121x1121.png\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\">Recycling &amp; Recycled Fibers</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Location:<br><br>\n                                </p>\n     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Southern Ethiopia Regional State</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Kgnangatom Woreda</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">800km from Addis Ababa</span></li>\n                            </ul>\n                                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Land:<br><br>\n                                </p>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">2,000 hectares (gross command area)</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Expansion potential: Up to 5,000 hectares</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Status: Under technical and feasibility study</span></li>\n                            </ul>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Planned Production:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Fruits - High-value varieties</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Cotton - Industrial cultivation</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Oilseeds - Diversified production</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Other agricultural products - Climate-appropriate crops</span></li>\n                            </ul>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Key Features:<br><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Technical &amp; feasibility study in progress</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Near Omo River water source</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Strategic southern region location</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Agricultural suitability assessment ongoing</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Major expansion potential</span></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@SITES@/2098721/assets/images/gemini_generated_image_81yf8u81yf8u81yf-1024x1024.png\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\"><b>Technical Textiles</b></h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">While our core output today is cotton yarn and grey fabrics, our spinning &amp; weaving capabilities allow us to develop custom technical textiles on request (subject to sample development and feasibility). For specialized performance requirements we work with partners and clients to prototype and test solutions.<br>\n                                </p>\n     <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">400 hectares (contract farming with local community on rental basis)</span></li><li class=\"item-wrap\">Status: Fully operational with complete irrigation scheme</li>\n                            </ul>\n                                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Location:<br></b><br>\n                                </p>\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Afar Region, near Awash town</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">275km from Addis Ababa</span></li>\n                            </ul>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Location:<br></b><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Cotton: Primary crop - 100% of 400ha currently planted</span></li><li class=\"item-wrap\">Purpose: Direct supply to Riders-ELSE Textile Industry</li>\n                            </ul>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Location:<br></b><br>\n                                </p>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">&nbsp;Contract farming partnership model</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Full irrigation infrastructure</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Active cotton production</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Community-based land arrangement</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem; background-color: transparent;\">Direct textile factory integration<br></span><br></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@SITES@/2098721/assets/images/gemini_generated_image_fpo4p9fpo4p9fpo4-1121x1121.png\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\"><b>Finishing &amp; Garmenting (value-added — coming soon)</b></h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">Riders is rolling out a wet-processing line (inspection, scouring, bleaching, dyeing, finishing) and a garmenting facility for full package production. Until those units are fully operational, we supply grey fabrics and yarn and partner with finishing/garmenting specialists for finished goods.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@SITES@/2098721/assets/images/image13-1.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .tabs-wrapper\">\n                                    <b>Community Engagement Initiatives</b>\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">\n                                    To foster a sense of community and promote responsible riding, companies are\n                                    launching initiatives to engage users in local clean-up efforts and safety awareness\n                                    campaigns. This may involve organizing community events, offering incentives for\n                                    reporting damaged scooters, and partnering with local organizations to promote\n                                    sustainability and responsible urban mobility.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "tabs02-au",
          "_isUserblock": true,
          "_cid": "v0xIIIoWlx",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card": {
              "justify-content": "flex-end"
            },
            ".title-wrapper": {
              "margin-bottom": "40px",
              ".mbr-tag": {
                "margin-bottom": "16px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "40px",
              ".btn": {
                "&::after, &::before": {
                  "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2 150%)"
                },
                "&:hover, &:focus": {
                  "&::after": {
                    "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2 150%)",
                    "opacity": "1"
                  },
                  "color": "@activeBtn !important"
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -20px",
              ".item": {
                "margin-bottom": "40px",
                "padding": "0 20px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                },
                ".item-wrapper": {
                  "position": "relative",
                  "height": "100%",
                  ".item-content": {
                    ".item-title": {
                      "margin-bottom": "16px"
                    },
                    ".item-text": {
                      "margin-bottom": "16px"
                    },
                    ".icon-wrapper": {
                      "margin-top": "32px",
                      "@media (max-width: 992px)": {
                        "margin-top": "20px"
                      },
                      ".icon-wrap": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "56px",
                        "height": "56px",
                        "min-width": "56px",
                        "border-radius": "16px",
                        "background-color": "@iconBg",
                        ".mbr-iconfont": {
                          "color": "transparent",
                          "-webkit-background-clip": "text",
                          "-webkit-text-fill-color": "transparent",
                          "background-image": "linear-gradient(90deg, @icon_1, @icon_2)",
                          "font-size": "32px"
                        }
                      }
                    },
                    ".item-btn": {
                      "margin-top": "40px",
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "margin-top": "20px",
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-tag": {
              "color": "#454545"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#141414"
            },
            ".mbr-section-title, .main-btn": {
              "color": "#141414"
            },
            ".item-title, .item-btn, .icon-wrapper": {
              "color": "#141414"
            }
          },
          "_name": "features04",
          "_sourceTheme": "neuralm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 neuralm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Tag\" name=\"showTag\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Icon</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Gradient 1\" value=\"#386bb7\" name=\"icon_1\" condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon Gradient 2\" value=\"#e24c4a\" name=\"icon_2\" condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon BG\" value=\"#121212\" name=\"iconBg\" condition=\"showIcon\">\n        <header>Buttons</header>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showCardButtons\">\n        <input type=\"color\" title=\"Button Gradient 1\" value=\"#386bb7\" name=\"gradient_1\" condition=\"showCardButtons\" selected>\n        <input type=\"color\" title=\"Button Gradient 2\" value=\"#e24c4a\" name=\"gradient_2\" condition=\"showCardButtons\" selected>\n        <input type=\"color\" title=\"Button Active Color\" value=\"#ffffff\" name=\"activeBtn\" condition=\"showCardButtons\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/neuralm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/neuralm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showTag\">\n                    <h3 class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\" mbr-theme-style=\"display-4\" mbr-if=\"showTag\">OUR VISION</h3>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Strategic Goals &amp; Objectives</h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            \n            \n            <div class=\"item features-without-image col-12 col-lg-3 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn, .icon-wrapper\">Agro-Processing Industries<br><br>Establish ethical commercial farming for:</h4>\n                         <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Cotton, wheat, coffee</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Oil seeds and cereals</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Fruits and vegetables</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Animal feed (alfalfa, soybean)</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Green mung, hybrid seeds</span></li>\n                            </ul>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Regions: Afar, Somali, and Southern regions based on detailed feasibility studies<br></p>\n                        <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                View more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn, .icon-wrapper\">Livestock Farming Development<br><br>Expand into livestock operations including:</h4>\n                         <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Dairy farm - Milk production</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Fattening - Beef cattle operations</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Poultry - Egg and meat production</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Fishery - Aquaculture development</span></li>\n                            </ul>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Approach: Based on detailed feasibility studies for each livestock category<br></p>\n                        <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-bulleted-list mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                View more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn, .icon-wrapper\">Infrastructure Development<br><br>Invest in forward-linkage processing:</h4>\n                         <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Animal feed processing - Value-added feed products</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Coffee roasting - Packed coffee products</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Other consumables - Market-ready products</span></li>\n                            </ul>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Purpose: Vertical integration and value addition to farming output<br></p>\n                        <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-setting-3 mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                View more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn, .icon-wrapper\">Diversified Crop Production<br><br>Develop agricultural infrastructure:</h4>\n                         <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Silo facilities - Storage in different regions</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Propagation centers - Seedling production</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Distribution networks - Farm-to-market infrastructure</span></li>\n                            </ul>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".item-text\">Impact: Supporting overall agricultural value chain<br></p>\n                        <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-setting mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                View more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0xXxSyum4",
          "_anchor": "features04-aw",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features4",
          "_sourceTheme": "buildm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"buildm5 features4\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n    <header>Show / Hide</header>\n    <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"1\" max=\"3\" step=\"1\" value=\"2\">\n\n    <input type=\"checkbox\" title=\"Title\" name=\"showSubtitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/buildm5/components/_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/buildm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"col-12\">\n        <h2 class=\"mbr-section-subtitle mbr-fonts-style mbr-white mb-5 pb-5\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">Project Objectives</h2>\n      </div>\n\n\n\n      <div class=\"row content-wrap\">\n\n        <div class=\"col-lg-2\"></div>\n\n        <div class=\"col-lg-6\">\n          <h2 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title, .line\">Textile Industry Integration</h2>\n        </div>\n\n        <div class=\"col-lg-4\">\n          <p class=\"mbr-fonts-style mbr-text mbr-white mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n            Our primary objective is to supply high-quality cotton to Riders-ELSE Textile Industry—a functioning and viable factory located in Adama, owned by Riders Trading and Manufacturing S.C.—and for the international export market.</p>\n              <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Direct farm-to-factory supply chain</li><li class=\"item-wrap\">Quality-controlled cotton production</li><li class=\"item-wrap\">Reduced raw material costs for textile operations</li><li class=\"item-wrap\">Export surplus to international markets</li><li class=\"item-wrap\">Vertical integration competitive advantage</li>\n                            </ul>\n        </div>\n\n        <div class=\"col-12\">\n          <div class=\"line\"></div>\n        </div>\n      </div>\n      <div class=\"row mt-5 content-wrap\" mbr-if=\"items > 1\">\n\n        <div class=\"col-lg-2\"></div>\n\n        <div class=\"col-lg-6\">\n          <h2 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title, .line\">Export-Quality Agricultural Products</h2>\n        </div>\n\n        <div class=\"col-lg-4\">\n          <p class=\"mbr-fonts-style mbr-text mbr-white mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n            To produce various types of agricultural products such as fruits, oilseeds, coffee, cereals, and other exportable crops for domestic consumption and international markets. </p>\n              <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">High-value export crops (coffee, oilseeds, fruits)</li><li class=\"item-wrap\">Food security crops (wheat, cereals)</li><li class=\"item-wrap\">Specialty products (hybrid seeds, vegetables)</li><li class=\"item-wrap\">Foreign currency earnings</li><li class=\"item-wrap\">Market diversification and risk management</li>\n                            </ul>\n        </div>\n\n        <div class=\"col-12\">\n          <div class=\"line\"></div>\n        </div>\n      </div>\n\n\n      <div class=\"row mt-5 content-wrap\" mbr-if=\"items > 2\">\n\n        <div class=\"col-lg-2\"></div>\n\n        <div class=\"col-lg-6\">\n          <h2 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .line\">Design phase&nbsp;</h2>\n        </div>\n\n        <div class=\"col-lg-4\">\n          <p class=\"mbr-fonts-style mbr-text mbr-white mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Once the design phase is complete, the construction phase\n            begins. This involves mobilizing resources, procuring materials, and initiating construction activities\n            on-site. Skilled laborers work diligently, following the plans and specifications to ensure that the project\n            is built according to the desired standards.&nbsp;<br></p>\n             <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Cotton, wheat, coffee</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Oil seeds and cereals</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Fruits and vegetables</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Animal feed (alfalfa, soybean)</span></li><li class=\"item-wrap\"><span style=\"background-color: transparent; font-size: 1.125rem; letter-spacing: -0.0125rem;\">Green mung, hybrid seeds</span></li>\n                            </ul>\n        </div>\n\n        <div class=\"col-12\">\n          <div class=\"line\"></div>\n        </div>\n      </div>\n\n\n\n    </div>\n  </div>\n</section>",
          "_styles": {
            "display": "flex",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".display-1": {
              "@media (max-width: 767px)": {
                "font-size": "2rem"
              }
            },
            ".mbr-section-subtitle": {
              "padding-left": "2rem",
              "text-align": "center",
              "color": "#141414",
              "margin-bottom": "1.5rem !important",
              "padding-bottom": "0 !important"
            },
            ".content-wrap": {
              "position": "relative",
              "overflow": "hidden",
              "&:after": {
                "content": "''",
                "width": "20px",
                "height": "20px",
                "position": "absolute",
                "transition": "all 0.5s",
                "background": "@primaryColor",
                "left": "33px",
                "top": "13px",
                "border-radius": "50%"
              }
            },
            ".line": {
              "width": "100%",
              "height": "1px",
              "background": "currentColor",
              "margin-top": "2rem",
              "margin-bottom": "1rem"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-subtitle, .line": {
              "color": "#291f1e"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left",
              "color": "#291f1e"
            },
            ".mbr-section-title, .line": {
              "color": "#141414",
              "text-align": "left"
            }
          },
          "_cid": "v0y8OsPAIO",
          "_anchor": "features4-az",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "44px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".label-wrapper": {
                "margin-bottom": "32px",
                ".label-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "padding": "4px 12px",
                  "background-color": "@labelBg",
                  "border-top": "2px solid @labelBorder",
                  "box-shadow": "0 8px 20px -8px @labelShadow",
                  ".iconfont-wrapper": {
                    ".mbr-iconfont": {
                      "font-size": "16px",
                      "display": "inline-block",
                      "margin-right": "8px"
                    }
                  },
                  ".mbr-label": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".title-wrapper": {
                ".mbr-section-title": {
                  "display": "inline-block",
                  "width": "60%",
                  "margin-bottom": "16px",
                  "position": "relative",
                  "background-image": "linear-gradient(-180deg, @titleShadow, @titleColor 40%)",
                  "background-clip": "text",
                  "-webkit-background-clip": "text",
                  "-webkit-text-fill-color": "transparent",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -12px",
              "justify-content": "center",
              ".item": {
                "padding": "0 12px",
                "margin-bottom": "24px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "18px"
                },
                ".item-wrapper": {
                  "height": "100%",
                  "background-color": "@cardBg",
                  "border-top": "3px solid @cardBorder",
                  "box-shadow": "0 8px 15px -8px @cardShadow",
                  "padding": "30px",
                  "overflow": "hidden",
                  "@media (max-width: 992px)": {
                    "padding": "24px"
                  },
                  ".item-content": {
                    ".icon-wrapper": {
                      "display": "flex",
                      "justify-content": "center",
                      "margin-bottom": "44px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "24px"
                      },
                      ".icon-wrap": {
                        "width": "180px",
                        "height": "180px",
                        "display": "inline-flex",
                        "padding": "10px",
                        "border-top": "3px solid @cardBorder",
                        "box-shadow": "0 10px 12px -8px @cardShadow",
                        "background-color": "@cardBg",
                        ".mbr-iconfont": {
                          "width": "100%",
                          "height": "100%",
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "font-size": "84px",
                          "border-top": "3px solid @cardBorder",
                          "box-shadow": "0 8px 12px -8px @cardShadow",
                          "background-color": "@cardBg"
                        }
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "10px"
                    },
                    ".item-text": {
                      "margin-bottom": "0"
                    },
                    ".mbr-section-btn": {
                      "margin-top": "10px",
                      ".btn": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#bfd42a",
              "text-align": "center"
            },
            ".mbr-section-title, .title-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#515151",
              "text-align": "left"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#515151"
            }
          },
          "_name": "features03",
          "_sourceTheme": "supportm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 supportm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label BG\" value=\"#f5f5f5\" name=\"labelBg\" condition=\"showLabel\">\n        <input type=\"color\" title=\"Label Border\" value=\"#ffffff\" name=\"labelBorder\" condition=\"showLabel\">\n        <input type=\"color\" title=\"Label Shadow\" value=\"#9c9c9c\" name=\"labelShadow\" condition=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Title Color\" value=\"#000000\" name=\"titleColor\" condition=\"showTitle\">\n        <input type=\"color\" title=\"Title Shadow\" value=\"#f5f5f5\" name=\"titleShadow\" condition=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Border\" value=\"#ffffff\" name=\"cardBorder\">\n        <input type=\"color\" title=\"BG\" value=\"#f5f5f5\" name=\"cardBg\">\n        <input type=\"color\" title=\"Shadow\" value=\"#9c9c9c\" name=\"cardShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://e.mobirise.com/supportm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://e.mobirise.com/supportm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                    <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                        <div class=\"label-wrap\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-bulleted-list mobi-mbri\" style=\"color: rgb(156, 156, 156); fill: rgb(156, 156, 156);\"></span>\n                            </div>\n                            <h3 class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label, .label-wrapper\">ETHIOPIA'S AGRICULTURAL ADVANTAGE</h3>\n                        </div>\n                    </div>\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Investment Incentives</h2>\n                    </div>\n                                                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Riders Farming &amp; Agriculture represents our strategic investment in Ethiopia's agricultural transformation. Operating across three major regions—Afar, Somali, and Southern Nations—we are developing large-scale commercial farming operations with total land capacity exceeding 10,000 hectares.<br><br>Our integrated approach combines cotton production (supplying our textile operations), food security crops (wheat, cereals, oilseeds), and high-value export crops (coffee, fruits, vegetables). With modern irrigation infrastructure and sustainable farming practices, we're contributing to Ethiopia's agricultural modernization while creating employment and economic opportunities in rural communities.</p>\n                    <div class=\"text-wrapper\">\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <div class=\"icon-wrap card-wrap\">\n                                <span mbr-icon class=\"card-wrap mbr-iconfont mobi-mbri-opened-folder mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Tax &amp; Financial Incentives</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Tax holidays: 9-15 years (varies by type/location)</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Income tax exemptions: Priority sector benefits</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Duty-free imports: Capital goods and machinery</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Duty exemption: Raw materials for export production</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Investment credit support: Available financing</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Profit repatriation guarantees: Full profit and dividend transfer</span></li>\n                            </ul>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                            <a href class=\"btn item-btn btn-black\" data-app-placeholder=\"Type Text\">\n                                Learn More\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <div class=\"icon-wrap card-wrap\">\n                                <span mbr-icon class=\"card-wrap mbr-iconfont mobi-mbri-setting mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Ethiopia's Agricultural Advantages</h4>\n                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">120 million population - Second largest African market</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">74.3 million hectares - Suitable agricultural land</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">18 agro-ecological zones - Diverse crop potential</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Proximity to markets - Middle East, Europe, Africa</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Water resources - Major rivers and irrigation potential</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Labor force - Large, available workforce</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Government support - Priority sector status</span></li>\n                            </ul>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                            <a href class=\"btn item-btn btn-black\" data-app-placeholder=\"Type Text\">\n                                Learn More\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-content\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <div class=\"icon-wrap card-wrap\">\n                                <span mbr-icon class=\"card-wrap mbr-iconfont mobi-mbri-user mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Land &amp; Operational Support</h4>\n                                      <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Land lease: Up to 50 years at concessionary rates</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Competitive pricing: As low as $6 per hectare</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">One-stop-shop services: Streamlined licensing process</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Infrastructure investment: Government commitment</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Institutional reforms: Market access and innovation</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Extension services: Technical support available</span></li>\n                            </ul>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                            <a href class=\"btn item-btn btn-black\" data-app-placeholder=\"Type Text\">\n                                Learn More\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0ydXR16ab",
          "_anchor": "features03-b0",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 24px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "48px"
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "4rem",
              "padding": "48px",
              "background-color": "@container",
              "border-radius": ".75rem",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "48px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  ".card-box": {
                    ".card-number": {
                      "margin-bottom": "16px",
                      "opacity": ".4"
                    },
                    ".card-title": {
                      "margin-bottom": "24px"
                    },
                    ".card-text": {
                      "margin-bottom": "22px"
                    },
                    ".mbr-section-btn": {
                      "opacity": "0",
                      "transition": "all 0.5s ease-in-out",
                      "@media (max-width: 992px)": {
                        "opacity": "1"
                      },
                      "&:hover, &:focus": {
                        "opacity": "1"
                      },
                      ".btn": {
                        "&::before": {
                          "background-image": "linear-gradient(90deg, @active_2 0%, transparent 100%)"
                        },
                        "&:hover, &:focus": {
                          "box-shadow": "inset 250px 10px 5px @active_1 !important",
                          "border-color": "@active_1 !important"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#141414"
            },
            ".card-number": {
              "color": "#141414"
            },
            ".card-title": {
              "color": "#141414"
            },
            ".card-text": {
              "color": "#141414"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#141414"
            }
          },
          "_name": "features02",
          "_sourceTheme": "operationm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 operationm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Active Color 1\" value=\"#01004c\" name=\"active_1\" condition=\"showButtons\" selected>\n        <input type=\"color\" title=\"Active Color 2\" value=\"#FB8FC9\" name=\"active_2\" condition=\"showButtons\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e3e3e3\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Flexible Partnership Opportunities</h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-without-image item-mb active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                    01\n                                </p>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Joint Ventures (JV)</h4>\n                                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Equity partnership arrangements</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Shared investment and ownership</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Combined expertise and resources</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Risk and reward sharing</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Long-term strategic collaboration</span></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                    02\n                                </p>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Contract Farming</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">Guaranteed off-take agreements</li><li class=\"item-wrap\">Technical support and inputs</li><li class=\"item-wrap\">Price security and market access</li><li class=\"item-wrap\">Proven model (Amibara success)</li><li class=\"item-wrap\">Win-win for farmers and Riders</li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                    03\n                                </p>\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Custom Arrangements</h4>\n                                                                   <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Tailored partnership structures</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Land leasing with management</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Technology transfer agreements</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Export market partnerships</span></li><li class=\"item-wrap\"><span style=\"font-size: 1.125rem; letter-spacing: -0.0125rem;\">Any other forms partners propose</span></li>\n                            </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n                                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Download Farming Portfolio\n                        </a></div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0yy9Ry9aH",
          "_anchor": "features02-b1",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "&::before": {
              "content": "''",
              "position": "absolute",
              "bottom": "0",
              "width": "200vh",
              "height": "85%",
              "background-image": "linear-gradient(transparent, @shadow 50%)",
              "z-index": "1"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".logo-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start",
              "gap": "0",
              "margin-bottom": "0",
              "padding-top": "0",
              "max-width": "100%",
              "a": {
                "display": "block",
                "line-height": "0",
                "margin": "0",
                "padding": "0"
              },
              "a:first-child": {
                "margin-bottom": "0"
              },
              ".footer-logo-img": {
                "width": "250px !important",
                "height": "auto !important",
                "max-height": "120px !important",
                "object-fit": "contain",
                "border-radius": "8px !important",
                "display": "block"
              },
              ".tagline-footer-img": {
                "width": "auto !important",
                "height": "30px !important",
                "border-radius": "0 !important",
                "object-fit": "contain",
                "image-rendering": "crisp-edges",
                "display": "block",
                "margin-top": "8px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                ".footer-logo-img": {
                  "width": "220px !important",
                  "max-height": "100px !important"
                },
                ".tagline-footer-img": {
                  "height": "25px !important",
                  "margin-top": "6px"
                }
              },
              "@media (max-width: 576px)": {
                ".footer-logo-img": {
                  "width": "200px !important",
                  "max-height": "90px !important"
                },
                ".tagline-footer-img": {
                  "height": "22px !important"
                }
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".row-main": {
              "position": "relative",
              "align-items": "flex-start",
              "justify-content": "center",
              "& when (@showBorder)": {
                "padding": "20px 0",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "width": "200vh",
                  "height": "1px",
                  "background-color": "@border"
                }
              },
              ".card": {
                "justify-content": "center",
                "padding-top": "0 !important"
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "10px",
                "letter-spacing": "1px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".nav-wrapper": {
              "text-align": "center",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px",
                "text-align": "left"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px",
                "text-align": "center",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".list": {
                "padding": "0",
                "margin": "0",
                "list-style-type": "none",
                "display": "inline-block",
                "text-align": "left",
                ".item-wrap": {
                  "margin-bottom": "5px",
                  "cursor": "pointer",
                  "position": "relative",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:hover": {
                    "color": "@active",
                    "&::before": {
                      "width": "100%"
                    }
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "height": "1px",
                    "width": "0",
                    "background-color": "@active",
                    "transition": "all 0.3s ease-in-out"
                  }
                }
              }
            },
            ".contacts-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".contacts-wrap": {
                ".item-contact": {
                  "margin-bottom": "15px",
                  ".item-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    ".mbr-iconfont": {
                      "font-size": "30px",
                      "color": "@icon",
                      "display": "inline-flex",
                      "margin-right": "20px"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-contact": {
                          "color": "@active",
                          "&::before": {
                            "width": "100%"
                          }
                        }
                      },
                      ".mbr-contact": {
                        "margin-bottom": "0",
                        "position": "relative",
                        "transition": "all 0.3s ease-in-out",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "height": "1px",
                          "width": "0",
                          "background-color": "@active",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "10px"
              },
              ".mbr-desc": {
                "margin-bottom": "5px"
              },
              ".social-wrapper": {
                "margin-top": "10px",
                ".social-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "@media (max-width: 992px)": {
                      "margin-left": "16px",
                      "&:first-child": {
                        "margin-left": "0"
                      }
                    },
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "36px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "padding": "25px 0",
              "color": "#141414",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#1e4381"
            },
            ".mbr-text": {
              "color": "#141414"
            },
            ".mbr-section-subtitle": {
              "color": "#141414"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".mbr-contact": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".list, .item-wrap": {
              "color": "#141414",
              "text-align": "left"
            },
            ".mbr-contact, .item-contact": {
              "color": "#141414"
            },
            ".mbr-desc, .mbr-section-btn": {
              "color": "#141414"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 essencem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"cont\" min=\"0\" max=\"3\" step=\"1\" value=\"3\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showContacts\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showContacts\" selected>\n        <input type=\"checkbox\" title=\"Desc\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#141414\" name=\"active\" condition=\"showNav || showContacts || showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#b0b0b0\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#f2fdff\" name=\"shadow\" selected>\n        <input type=\"checkbox\" title=\"Copy\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://r.mobirisesite.com/2098721/assets/images/background12.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://r.mobirisesite.com/2098721/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <!-- Logo and Tagline Section - UPDATED -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showTitle || showText\">\n                <div class=\"logo-wrapper\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/469598294-595183719735444-159510259647027175-n-790x288.png\" alt=\"RIDERS Trading & Manufacturing S.C\" class=\"footer-logo-img\">\n                    </a>\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2025-10-25-at-23.01.20-1.png\" alt=\"Beyond Investment\" class=\"tagline-footer-img\">\n                    </a>\n                </div>\n            </div>\n            \n            <!-- Menu Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Menu</b><b><br></b>\n                    </h3>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">Home</li>\n                        <li class=\"item-wrap\"><font color=\"#141414\"><a href=\"about.html\" class=\"text-black text-primary\">About</a></font></li>\n                        <li class=\"item-wrap\"><a href=\"textile-industry.html\" class=\"text-black\">Sectors</a></li>\n                        <li class=\"item-wrap\"><a href=\"documents.html\" class=\"text-black\">Documents</a></li>\n                    </ul>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"news.html\" class=\"text-black\">News</a><br></li>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"jobs.html\" class=\"text-black\">Jobs</a></li>\n                        <li class=\"item-wrap\">&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"gallery.html\" class=\"text-black\">Gallery</a></li>\n                        <li class=\"item-wrap\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"contact.html\" class=\"text-black text-primary\">Contact</a></li>\n                    </ul>\n                </div>\n            </div>\n            \n            <!-- Contacts Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showContacts\">\n                <div class=\"contacts-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        <b>Contacts</b>\n                    </h3>\n                    <div class=\"contacts-wrap\">\n                        <div class=\"item-contact\">\n                            <div class=\"item-wrap\">\n                                <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(20, 20, 20); fill: rgb(20, 20, 20);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-black\" target=\"_blank\">Sarbet JFK Apartments,</a>\n                                    <a href=\"https://maps.app.goo.gl/CZtVTJ54pnNapts68\" class=\"text-black\" target=\"_blank\">Addis Ababa</a>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 1\">\n                            <div class=\"item-wrap\">\n                                <a href=\"tel:+251-911-072513\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"tel:+251-911-072513\" class=\"text-black\">+251-911-072513</a>\n                                    <a href=\"tel:+251-911-072513\" class=\"text-black\">+251-944-334484</a><a href=\"tel:+251-911-072513\" class=\"text-black\">+251-960-551010</a>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"item-contact\" mbr-if=\"cont > 2\">\n                            <div class=\"item-wrap\">\n                                <a href=\"mailto:info@ridersgroupsc.com\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" mbr-if=\"showIcon\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </a>\n                                <a href=\"#\">\n                                </a>\n                                <p class=\"mbr-contact mbr-fonts-style\" data-app-selector=\".mbr-contact, .item-contact\" mbr-theme-style=\"display-7\">\n                                    <a href=\"#\"></a>\n                                    <a href=\"mailto:info@ridersgroupsc.com\" class=\"text-black\">info@ridersgroupsc.com</a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Social Section -->\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showSubtitle || showDesc || showButtons || showSocial\">\n                <div class=\"desc-wrapper\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://web.facebook.com/profile.php?id=100077837321146\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"color: rgb(24, 119, 242); fill: rgb(24, 119, 242);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://www.youtube.com/@ridersbusinessgroupsc3225\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"color: rgb(238, 41, 71); fill: rgb(238, 41, 71);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-telegram socicon\" style=\"color: rgb(10, 102, 194); fill: rgb(10, 102, 194);\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://www.instagram.com/riderssc_2024?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(250, 18, 96); fill: rgb(250, 18, 96);\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Copyright -->\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\">\n                    © Copyright 2025 RIDERS Trading &amp; Manufacturing S.C - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "v0fLVaJO0f",
          "_anchor": "footer01-al",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "real-estate.html": {
      "settings": {
        "title": "Real Estate & Construction | Property Development | Riders Trading & Manufacturing S.C.",
        "order": "7",
        "meta_descr": "Riders real estate division: Strategic property investments and construction projects. Building infrastructure, commercial spaces, and residential developments that contribute to Ethiopia's urban growth.",
        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->",
        "header_custom": "<!-- Structured Data - Real Estate -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"RealEstateAgent\",\n  \"name\": \"Riders Real Estate Division\",\n  \"description\": \"Strategic property investments and construction projects in Ethiopia\",\n  \"parentOrganization\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Riders Trading and Manufacturing S.C.\"\n  }\n}\n</script>\n\n<!-- Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-XXXXXXXXXX');\n</script>",
        "footer_custom": "<!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "85px",
                "padding-right": "85px",
                "@media (max-width: 1640px)": {
                  "padding-left": "65px",
                  "padding-right": "65px"
                },
                "@media (max-width: 1440px)": {
                  "padding-left": "45px",
                  "padding-right": "45px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "20px",
                  "padding-right": "20px"
                }
              }
            },
            ".content-wrap": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "position": "relative",
              "min-height": "110px"
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "0",
              "box-shadow": "none"
            },
            ".dropdown-item": {
              "border": "none !important",
              "background": "@menuBgColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@activeColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1.2em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "opacity": ".5"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "8px 3.2rem 8px 22px",
                "line-height": "1.5",
                "border-radius": "0",
                "margin-left": "4px",
                "margin-bottom": "4px"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1",
                "flex-grow": "1",
                "gap": "4px"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "14px !important",
                  "text-align": "center",
                  "margin-left": "0"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0.5rem",
                  "max-width": "80%"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3.2rem",
                "border-radius": "30px",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid transparent",
                "& when (@collapsed)": {
                  "border-radius": "20px !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              "width": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 991px)": {
                  "text-align": "left",
                  "width": "auto"
                }
              },
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "min-height": "auto",
                "width": "auto",
                "font-size": "0.9rem",
                "padding": "10px 20px",
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              },
              "margin-right": "4px !important",
              "margin-left": "0 !important",
              "border-radius": "50px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              },
              "margin-right": "4px !important"
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "0 !important",
                "margin": "6px 6px !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "300",
                "border-radius": "3rem",
                "text-decoration": "underline",
                "text-decoration-color": "transparent",
                "font-size": "0.95rem",
                "&::after": {
                  "color": "inherit !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover, &:focus": {
                  "background-color": "transparent",
                  "color": "@activeColor !important",
                  "text-decoration-color": "@activeColor",
                  "&::after": {
                    "color": "inherit !important"
                  }
                },
                "&.active": {
                  "color": "@activeColor !important",
                  "text-decoration-color": "@activeColor !important",
                  "font-weight": "500 !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                }
              }
            },
