        "html_before": "<!-- Google Tag Manager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>\n<!-- End Google Tag Manager -->",
        "meta_descr": "Explore RIDERS's advanced textile manufacturing capabilities in Ethiopia. Our state-of-the-art facilities feature complete vertical integration from spinning and weaving to processing and garment production with sustainable practices.",
        "footer_custom": "<!-- Structured Data for Manufacturing Capabilities -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Article\",\n  \"headline\": \"Advanced Manufacturing Capabilities\",\n  \"description\": \"RIDERS's textile manufacturing capabilities including spinning, weaving, processing, and garment production with quality control and sustainability practices.\",\n  \"image\": \"https://ridersgroupsc.com/assets/images/capabilities-main.jpg\",\n  \"author\": {\n    \"@type\": \"Organization\",\n    \"name\": \"RIDERS\",\n    \"url\": \"https://ridersgroupsc.com/\"\n  },\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"RIDERS\",\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"url\":\n\"https://ridersgroupsc.com/assets/images/logo.png\"\n    }\n  },\n  \"mainEntityOfPage\": {\n    \"@type\": \"WebPage\",\n    \"@id\": \"https://ridersgroupsc.com/capabilities.html\"\n  }\n}\n</script>",
        "header_custom": "<meta name=\"description\" content=\"Explore RIDERS's advanced textile manufacturing capabilities in Ethiopia. Our state-of-the-art facilities feature complete vertical integration from spinning and weaving to processing and garment production with sustainable practices.\">\n<meta name=\"keywords\" content=\"textile manufacturing capabilities, Ethiopian textile production, sustainable textile manufacturing, spinning capabilities, weaving technology, fabric processing, garment production, quality control textiles\">\n\n<!-- Open Graph / Facebook -->\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://ridersgroupsc.com/capabilities.html\">\n<meta property=\"og:title\" content=\"Manufacturing Capabilities | Advanced Textile Production | RIDERS\">\n<meta property=\"og:description\" content=\"Explore RIDERS's advanced textile manufacturing capabilities in Ethiopia with complete vertical integration from spinning to finished garments.\">\n<meta property=\"og:image\" content=\"https://ridersgroupsc.com/assets/images/capabilities-social.jpg\">\n\n<!-- Twitter -->\n<meta property=\"twitter:card\" content=\"summary_large_image\">\n<meta property=\"twitter:url\" content=\"https://ridersgroupsc.com/capabilities.html\">\n<meta property=\"twitter:title\" content=\"Manufacturing Capabilities | Advanced Textile Production | RIDERS\">\n<meta property=\"twitter:description\" content=\"Explore RIDERS's advanced textile manufacturing capabilities in Ethiopia with complete vertical integration from spinning to finished garments.\">\n<meta property=\"twitter:image\" content=\"https://ridersgroupsc.com/assets/images/capabilities-social.jpg\">\n\n<!-- Canonical URL -->\n<link rel=\"canonical\" href=\"https://ridersgroupsc.com/capabilities.html\">"
